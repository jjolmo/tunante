#!/bin/sh
# Keep every icon in step with assets/logo.png.
#
# Only when the logo itself is staged. Regenerating on every commit would run a
# thirty-file image pipeline to tell you nothing changed, and the one time it
# did change would be lost in the noise.
set -eu

root=$(git rev-parse --show-toplevel)

# --cached, not the working tree: what is being committed is what the icons have
# to match. A logo edited but not staged is not part of this commit.
git diff --cached --name-only --diff-filter=ACMR | grep -qx 'assets/logo.png' || exit 0

echo "assets/logo.png changed — regenerating icons"
python3 "$root/scripts/gen-icons.py" || {
    echo "icon generation failed; commit aborted" >&2
    exit 1
}

# Staged automatically. The alternative is a commit whose logo and icons
# disagree, which is the exact state this hook exists to prevent — and which
# nobody notices until a launcher shows the old face.
#
# The list comes from the generator, never from here. A hand-written copy went
# stale the first time an output was added: the favicon was regenerated and then
# left out of the commit, because this hook had never been told about it.
python3 "$root/scripts/gen-icons.py" --list \
    | (cd "$root" && xargs -d '\n' -r git add --)
