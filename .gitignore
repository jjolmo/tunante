node_modules/
build/
.svelte-kit/
dist/
# …except this one, which is source and not output: the Alpine package, the
# launcher entry, the icon and the install script for the phone app. The rule
# above is meant for SvelteKit's build output, and it had been quietly
# swallowing all four ever since they were written.
!apps/tunante/dist/
target/
*.swp
*.swo
.DS_Store
.env
.env.*
!.env.example
.dev-libs/
.cargo/
run-dev.sh
.claude/

# The signing key lives outside the tree; this only says where.
apps/android/KEY.local.md
*.local.md

# Python bytecode from scripts/
__pycache__/
