// Tunante's palette, carried over from the desktop app's src/app.css so the two
// look like the same program. Thirteen tokens, dark and light.
//
// Keep this the single source of colour: no literal `#rrggbb` anywhere else in
// the UI. Re-theming then means editing one file.

export global Theme {
    in-out property <bool> dark: true;
    // Set true for the desktop (grande) shell: the old Tauri desktop used
    // smaller type than a phone wants. The narrow shells keep the larger sizes.
    in-out property <bool> compact: false;

    // The switch between dark and light is a fade, not a cut: a white screen
    // that appears in one frame over a dark one is a flash in the eyes. Every
    // colour is a mix of its two values weighted by `t`, and `t` is the one
    // thing that animates — so all tokens move together, in step.
    // A global cannot animate, so the window owns the animation (`theme-t` in
    // app.slint) and writes the value here as it moves. 1 = dark, 0 = light.
    in-out property <float> t: 1.0;

    out property <color> bg-primary:     #ffffff.mix(#1e1e1e, 1 - t);
    out property <color> bg-secondary:   #f3f3f3.mix(#252526, 1 - t);
    out property <color> bg-tertiary:    #e8e8e8.mix(#2d2d30, 1 - t);
    out property <color> bg-hover:       #d4d4d4.mix(#3e3e42, 1 - t);
    out property <color> bg-selected:    #cce5ff.mix(#094771, 1 - t);
    out property <color> text-primary:   #1e1e1e.mix(#cccccc, 1 - t);
    out property <color> text-secondary: #616161.mix(#969696, 1 - t);
    out property <color> text-muted:     #a0a0a0.mix(#5a5a5a, 1 - t);
    out property <color> accent:         #007acc;
    out property <color> accent-hover:   #005999.mix(#1c97ea, 1 - t);
    out property <color> border:         #d4d4d4.mix(#3e3e42, 1 - t);
    // For the one banner there is. Amber rather than red: the music is waiting,
    // not lost.
    out property <color> warning-bg:     #fff4ce.mix(#4a3a10, 1 - t);
    out property <color> warning-fg:     #6b5200.mix(#f0c674, 1 - t);

    // A finger is not a mouse pointer. Nothing interactive goes below this.
    out property <length> touch-target: 48px;
    out property <length> gap: 12px;
    out property <length> radius: 8px;

    out property <length> font-title: self.compact ? 14px : 17px;
    out property <length> font-body: self.compact ? 13px : 15px;
    out property <length> font-small: self.compact ? 11px : 13px;
}

// Small formatting helpers, so the same clock is written the same way wherever
// it appears.
export global Fmt {
    // m:ss, from milliseconds. Hours are folded into the minutes rather than
    // shown separately: an hour-long track is a rarity here, and a "1:02:03"
    // that only sometimes appears makes the row jump width as tracks change.
    pure public function mmss(ms: int) -> string {
        ms <= 0
            ? "0:00"
            : floor(ms / 60000) + ":" + (mod(floor(ms / 1000), 60) < 10 ? "0" : "")
              + mod(floor(ms / 1000), 60);
    }
}
