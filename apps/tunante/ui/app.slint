                        toggle-play => { root.toggle-play(); }
                        next-track => { root.next-track(); }
                        prev-track => { root.prev-track(); }
                        cycle-repeat => { root.cycle-repeat(); }
                        toggle-shuffle => { root.toggle-shuffle(); }
                        seek(ms) => { root.seek-to(ms); }
                        // Derived from the window, which the compositor imposes, so
                        // these never feed back into the layout that sizes the tab.
                        // Portrait reserves the height everything under the cover
                        // needs — three lines of text, the whole transport (a 68px
                        // play button and its seek bar and times) and the tab bar.
                        // 300px was ~40px short on a short-but-wide window, so the
                        // width-bound cover ran too tall and slid the play button
                        // behind the tab bar; 380px lets the cover shrink instead.
                        art-portrait: min(root.width - Theme.gap * 4, root.height - 380px);
                        // Never more than ~30% of the window wide (so the queue
                        // list keeps the rest), and never so tall that the info,
                        // seek bar and transport stacked under it in the left
                        // column fall off the bottom — those need ~285px (with
                        // the bottom margin), so on a short window the cover
                        // shrinks to leave them room.
                        art-landscape: min(root.width * 0.3, root.height - 285px);
                    }

                    if root.tab == 1: QueueTab {
                        // «Lista»: the playlist in playback order, with the
                        // prioritised rows inside it — not the queue alone.
                        rows: root.context-rows;
                        now-index: root.context-index;
                        queued-count: root.queue-rows.length;
                        activated(i) => { root.context-activated(i); }
                        toggled(i) => { root.context-toggled(i); }
