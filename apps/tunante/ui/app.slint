                    album-game-label: root.album-game-label;
                    toggle-album-game => { root.toggle-album-game(); }
                    show-cover: root.show-cover;
                    toggle-show-cover => { root.toggle-show-cover(); }
                    show-faved: root.show-faved;
                    toggle-show-faved => { root.toggle-show-faved(); }
                    show-folders: root.show-folders;
                    toggle-show-folders => { root.toggle-show-folders(); }
                    show-playlists: root.show-playlists;
                    toggle-show-playlists => { root.toggle-show-playlists(); }
                    about-label: root.about-label;
                    open-repo => { root.open-repo(); }
                    shortcut-rows: root.shortcut-rows;
                    shortcut-capture(id) => { root.shortcut-capture(id); }
                    folder-watch-toggled(id, on) => { root.folder-watch-toggled(id, on); }
                    folder-removed(id) => { root.folder-removed(id); }
                        loop-count: root.loop-count;
                        fade-seconds: root.fade-seconds;
                        set-volume(v) => { root.set-volume(v); }
                        cycle-sleep => { root.cycle-sleep(); }
                        rescan => { root.rescan(); }
                        descargar-caratulas => { root.descargar-caratulas(); }
                        add-folder => { root.add-folder(); }
                        cycle-loops => { root.cycle-loops(); }
                        cycle-fade => { root.cycle-fade(); }
                        short-filter-secs: root.short-filter-secs;
                        cycle-short-filter => { root.cycle-short-filter(); }
                        crossfade-secs: root.crossfade-secs;
                        cycle-crossfade => { root.cycle-crossfade(); }
                        output-label: root.output-label;
                        cycle-output => { root.cycle-output(); }
                    update-status: root.update-status;
                    check-update => { root.check-update(); }
                    theme-label: root.theme-label;
                    cycle-theme => { root.cycle-theme(); }
                    show-log => { root.show-log(); }
                    reset-app => { root.reset-app(); }
                    close-to-tray <=> root.close-to-tray;
                    toggle-close-to-tray => { root.toggle-close-to-tray(); }
                    mouse-buttons-label: root.mouse-buttons-label;
                    mouse-buttons-on: root.mouse-buttons-on;
                    toggle-mouse-buttons => { root.toggle-mouse-buttons(); }
                    global-shortcuts-label: root.global-shortcuts-label;
                    global-shortcuts-on: root.global-shortcuts-on;
                    toggle-global-shortcuts => { root.toggle-global-shortcuts(); }
                    tray-style-label: root.tray-style-label;
                    cycle-tray-style => { root.cycle-tray-style(); }
                    tray-click-label: root.tray-click-label;
                    cycle-tray-click => { root.cycle-tray-click(); }
                    update-skippable: root.update-skippable;
                    skip-update => { root.skip-update(); }
                    desktop-entry-label: root.desktop-entry-label;
                    make-desktop-entry => { root.make-desktop-entry(); }
                    add-files-label: root.add-files-label;
                    add-files => { root.add-files(); }
                    cover-fit-label: root.cover-fit-label;
                    cycle-cover-fit => { root.cycle-cover-fit(); }
                    clear-cache-label: root.clear-cache-label;
                    clear-cover-cache => { root.clear-cover-cache(); }
                    undo-covers-label: root.undo-covers-label;
                    undo-covers => { root.undo-covers(); }
                    continue-queue: root.continue-queue;
                    toggle-continue-queue => { root.toggle-continue-queue(); }
                    resume-on-open: root.resume-on-open;
                    toggle-resume-on-open => { root.toggle-resume-on-open(); }
                    resume-max-hours: root.resume-max-hours;
                    cycle-resume-hours => { root.cycle-resume-hours(); }
                    loop-max-mins: root.loop-max-mins;
                    cycle-loop-max => { root.cycle-loop-max(); }
                    slow-scan <=> root.slow-scan;
                    toggle-slow-scan => { root.toggle-slow-scan(); }
                    dsp-mono-compensate: root.dsp-mono-compensate;
                    dsp-mono-phase: root.dsp-mono-phase;
                    toggle-mono-compensate => { root.toggle-mono-compensate(); }
                    toggle-mono-phase => { root.toggle-mono-phase(); }
                        eq-enabled: root.eq-enabled;
                        eq-low: root.eq-low;
                        eq-mid: root.eq-mid;
                        eq-high: root.eq-high;
                        preamp-db: root.preamp-db;
                        dsp-mono: root.dsp-mono;
                        dsp-limiter: root.dsp-limiter;
                        toggle-eq => { root.toggle-eq(); }
                        set-eq-band(b, v) => { root.set-eq-band(b, v); }
                        set-preamp(v) => { root.set-preamp(v); }
                        toggle-mono => { root.toggle-mono(); }
                        toggle-limiter => { root.toggle-limiter(); }
                        dsp-balance: root.dsp-balance;
                        dsp-width: root.dsp-width;
                        set-balance(v) => { root.set-balance(v); }
                        set-width(v) => { root.set-width(v); }
                        rating-priority-label: root.rating-priority-label;
                        cycle-rating-priority => { root.cycle-rating-priority(); }
                    }

                    if root.tab == 2: LibraryTab {
                        rows: root.library-rows;
                        total: root.library-total;
                        cramped: root.cramped;
                        now-path: root.now-path;
                        mode <=> root.library-mode;
                        mode-changed(i) => { root.library-mode-changed(i); }
                        grid-lines: root.library-grid-lines;
                        grid: root.library-grid;
                        columns: root.library-columns;
                        crumb: root.library-crumb;
                        grid-tapped(p) => { root.library-grid-tapped(p); }
                        go-back => { root.library-back(); }
                        autofocus-search: root.autofocus-search;
                        search <=> root.search;
                        activated(i) => { root.library-activated(i); }
                        enqueued(i) => { root.library-enqueued(i); }
                        enqueue-path(p, hondo) => { root.library-enqueue-path(p, hondo); }
                    play-path(p) => { root.library-play-path(p); }
                    open-path(p) => { root.library-open-path(p); }
                    reclassify-path(p) => { root.library-reclassify-path(p); }
                    pin-path(p) => { root.library-pin-path(p); }
                    reveal-path(p) => { root.library-reveal-path(p); }
                        search-changed(s) => { root.search-changed(s); }
                        playlists: root.playlists;
                        all-playlists: root.all-playlists;
                        showing-playlists: root.showing-playlists;
                        playlist-open: root.playlist-open;
                        playlist-count: root.playlist-count;
                        playlist-open-requested(id) => { root.playlist-open-requested(id); }
                        playlist-enqueue-all => { root.playlist-enqueue-all(); }
                        playlist-create(nombre) => { root.playlist-create(nombre); }
                        add-path-to-playlist(p, hondo, id) => {
                            root.add-path-to-playlist(p, hondo, id);
                        }
                        add-path-to-new-playlist(p, hondo, nombre) => {
                            root.add-path-to-new-playlist(p, hondo, nombre);
                        }
                        playlist-track-removed(p) => { root.playlist-track-removed(p); }
                        playlist-reordered(de, a) => { root.playlist-reordered(de, a); }
                        playlist-rename(id, nombre) => { root.playlist-rename(id, nombre); }
                        playlist-delete(id) => { root.playlist-delete(id); }
                        playlist-enqueue-id(id) => { root.playlist-enqueue-id(id); }
                    }
                }
            }
        }

        // In the mini-player's place, not above it, and that is not a cosmetic
        // choice. Added as a row of its own it took 34px the Playing tab did not
        // have to give: the transport is laid out to the height it gets and the
        // play button was clipped in half. Standing in for the mini-player it
        // costs nothing, and there is nothing lost — the mini-player says what
        // is playing, and at this moment nothing is.
        //
        // Outside a tab because the output can die while you are looking at the
        // library, and this has to reach you wherever you are.
        if root.output-warning != "" && !root.cramped: Rectangle {
            height: 68px;
            background: Theme.warning-bg;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;
                Text {
                    text: "⚠";
                    color: Theme.warning-fg;
                    vertical-alignment: center;
                }
                Text {
                    text: root.output-warning;
                    color: Theme.warning-fg;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Not on the Sonando tab: there the full player is already on screen, so
        // the mini bar only duplicates it — and its 64px is not in the cover's
        // height reservation (see art-portrait), so showing it here is exactly
        // what pushed the transport off the bottom at shorter window heights.
        if !root.cramped && root.output-warning == "" && root.tab != 0: MiniPlayer {
            art: root.now-art;
            title: root.now-title;
            artist: root.now-artist;
            playing: root.playing;
            position-ms: root.position-ms;
            duration-ms: root.duration-ms;
            toggle-play => { root.toggle-play(); }
            next-track => { root.next-track(); }
            prev-track => { root.prev-track(); }
        }

        if root.portrait: TabSwitcher {
            height: 64px;
            vertical: false;
            tab <=> root.tab;
        }
    }

    // Over whichever shell is up: the bulk download is asked for from
    // Ajustes, which both shells show.
    if root.bulk-covering: CoversPlanSheet {
        status: root.bulk-status;
        plans: root.bulk-plans;
        busy: root.bulk-busy;
        apply => { root.bulk-apply(); }
        cancelled => { root.bulk-cancelled(); }
    }

    if root.output-picking: OutputPickSheet {
        options: root.output-options;
        current: root.output-current;
        picked(i) => { root.pick-output(i); }
        cancelled => { root.output-picking = false; }
    }

    if root.error-toast != "": Rectangle {
        x: root.width - self.width - 16px;
        y: root.height - self.height - 110px;
        width: min(520px, root.width - 32px);
        height: et.preferred-height + 20px;
        background: Theme.warning-bg;
        border-radius: Theme.radius * 2;
        et := HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            Text { text: "⚠"; color: Theme.warning-fg; vertical-alignment: center; }
            Text {
                text: root.error-toast;
                color: Theme.warning-fg;
                font-size: Theme.font-small;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        TouchArea { clicked => { root.error-toast = ""; } }
    }

    if root.showing-log: LogSheet {
        lines: root.log-lines;
        level-label: root.log-level-label;
        cycle-level => { root.cycle-log-level(); }
        filter-changed(t) => { root.log-filter-changed(t); }
        copy-log => { root.copy-log(); }
        clear-log => { root.clear-log(); }
        cancelled => { root.showing-log = false; }
    }

    // While the library is scanned nothing else is reachable: the overlay is
    // the last child, so it sits over both shells and every sheet.
    if root.scan-status != "" && !root.setup-mode: ScanOverlay {
        done: root.scan-done;
        total: root.scan-total;
        found: root.scan-found;
    }
}
