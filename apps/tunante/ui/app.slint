// The tunante shell: three tabs, a mini-player, and a switcher that moves
// to a side rail when the phone is turned.
//
// Deliberately built out of primitives (Rectangle, Text, TextInput, TouchArea)
// rather than std-widgets, so the look is Tunante's own and not whichever style
// Slint picks up from the host. The one exception is ListView, which is imported
// for its virtualization — it only instantiates the rows that are visible, which
// is what lets the library tab hold a hundred thousand entries without the
// memory blowing up.


import { Theme, Fmt } from "theme.slint";
import { TabSwitcher, MiniPlayer, ScanOverlay } from "widgets.slint";
import { NowPlayingTab, QueueTab, SettingsTab, LibraryTab } from "tabs.slint";
import { FolderPicker } from "picker.slint";
import { OnboardingSheet } from "onboarding.slint";
import { CoversPlanSheet, LogSheet, OutputPickSheet } from "widgets.slint";
import { DesktopShell } from "desktop.slint";

// Imported for AppWindow's own properties, and re-exported so
// `slint::include_modules!()` keeps generating the same Rust types it always
// has, wherever the structs live now.
import { ColumnChoice, ConsoleOption, CoverCandidate, GridCell, GridLine, LibraryRow, PlanRow, QueueRow, PlaylistRow, FolderEntry, TableColumn, TableRow, PinnedRow, FolderRow, ShortcutRow } from "types.slint";
export { ColumnChoice, ConsoleOption, CoverCandidate, GridCell, GridLine, LibraryRow, PlanRow, QueueRow, PlaylistRow, FolderEntry, TableColumn, TableRow }
// So Rust can flip the palette: ui.global::<Theme>().set_dark(false).
export { Theme }

export component AppWindow inherits Window {
    // «Título - Artista — Tunante» while something plays: the taskbar and
    // alt-tab tell you what is on without a glance inside.
    title: root.window-title == "" ? "Tunante" : root.window-title;
    in property <string> window-title;
    // The window/taskbar icon — the logo, not the toolkit's placeholder "W".
    icon: @image-url("../dist/icons/256x256/tunante.png");
    background: Theme.bg-primary;
    // Wide enough to open in the desktop shell on a desktop. On a phone the
    // compositor makes the window fullscreen and this is ignored; if it does
    // not, the screen clamps the width and the narrow shell takes over — which
    // is the whole point of there being one binary and no mode to pick.
    preferred-width: 1200px;
    preferred-height: 850px;

    in property <[LibraryRow]> library-rows;
    in property <[QueueRow]> queue-rows;
    // The whole playing context and the current index, for the landscape
    // now-playing queue list (distinct from queue-rows, the hand-queued items).
    in property <[QueueRow]> context-rows;
    in property <int> context-index;
    callback context-activated(int);
    callback context-toggled(int);
    callback context-reordered(int, int);
    callback context-cleared();
    in property <int> queue-placement;
    callback cycle-queue-placement();
    in property <bool> queue-always-visible;
    callback toggle-queue-always-visible();
    callback queue-opened-in-table();
    in property <string> now-title: @tr("Nada sonando");
    in property <string> now-artist;
    in property <string> now-album;
    // The Playing carousel's neighbours, from the same queue walk as ◀◀/▶▶.
    in property <string> prev-title;
    in property <string> prev-artist;
    in property <string> prev-album;
    in property <image> prev-art;
    in property <string> next-title;
    in property <string> next-artist;
    in property <string> next-album;
    in property <image> next-art;
    in property <int> library-total;
    in-out property <int> tab: 0;
    in-out property <bool> playing: false;
    in-out property <string> search;
    in property <bool> autofocus-search;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <image> now-art;
    in property <int> cover-fit;
    // The path of the track playing, so a row can recognise itself. Cheaper and
    // steadier than marking rows in Rust: `to_ui_rows` is called from five
    // places and none of them would know when the track changed underneath.
    in property <string> now-path;
    in-out property <bool> shuffle;
    // 0 off · 1 all · 2 one
    in-out property <int> repeat;

    in-out property <float> volume: 1.0;
    in property <bool> sleep-running;
    in property <int> sleep-minutes;
    in property <string> library-summary;
    in property <[FolderRow]> library-folders;
    in property <string> vgm-loops-label;
    callback cycle-vgm-loops();
    in property <bool> auto-covers;
    callback toggle-auto-covers();
    in property <bool> covers-in-folder;
    callback toggle-covers-in-folder();
    in property <bool> titlebar-track;
    callback toggle-titlebar-track();
    in property <string> album-game-label;
    callback toggle-album-game();
    in property <bool> show-cover;
    callback toggle-show-cover();
    in property <bool> show-faved;
    callback toggle-show-faved();
    in property <bool> show-folders;
    callback toggle-show-folders();
    in property <bool> show-playlists;
    callback toggle-show-playlists();
    in property <bool> show-consoles;
    callback toggle-show-consoles();
    in property <bool> show-files;
    callback toggle-show-files();
    in property <bool> show-discos;
    callback toggle-show-discos();
    in property <bool> show-consoles-view;
    callback toggle-show-consoles-view();
    in property <bool> show-juegos;
    callback toggle-show-juegos();
    in property <bool> show-listas-view;
    callback toggle-show-listas-view();
    in property <bool> caps-all;
    callback toggle-caps-all();
    callback reset-dsp();
    in property <int> theme-mode;
    callback set-theme(int);
    in property <string> dsp-status;
    in property <bool> auto-update;
    callback toggle-auto-update();
    in property <bool> ask-update;
    callback toggle-ask-update();
    in property <string> mouse-back-label;
    in property <string> mouse-forward-label;
    in property <string> mouse-side-label;
    in property <string> mouse-extra-label;
    callback cycle-mouse-action(string);
    callback reset-shortcuts();
    in property <string> about-label;
    callback open-repo();
    in property <[ShortcutRow]> shortcut-rows;
    callback shortcut-capture(string);
    /// A key hit at shell level; Rust answers whether it was consumed.
    pure callback shortcut-key(string, bool, bool, bool) -> bool;
    /// Bumped by Rust to drop focus into the table filter (focus can only
    /// be granted from inside slint).
    in property <int> focus-filter-tick;
    in property <int> open-settings-tick;
    in property <int> show-table-tick;
    in property <bool> cover-busy;
    callback folder-watch-toggled(string, bool);
    callback folder-removed(string);
    // Empty unless the sound has nowhere to go. See output.rs.
    in property <string> output-warning;
    in property <int> loop-count: 2;
    in property <int> fade-seconds: 8;

    // First run: no folders chosen yet, so the picker replaces the whole shell.
    // The dark/light switch as a fade. Theme's colours are mixes weighted by
    // Theme.t; this is the one animated value, pushed into the global on every
    // frame of the transition so all thirteen tokens move together.
    property <float> theme-t: Theme.dark ? 1.0 : 0.0;
    animate theme-t { duration: 450ms; easing: ease-in-out; }
    changed theme-t => { Theme.t = self.theme-t; }

    in-out property <bool> setup-mode;
    in property <[FolderEntry]> picker-entries;
    in property <string> picker-path;
    in property <int> picker-chosen;
    in property <string> scan-status;
    in property <int> scan-done;
    in property <int> scan-total;
    in property <int> scan-found;

    callback picker-enter(int);
    callback picker-toggle(int);
    callback picker-up();
    callback picker-done();

    // The desktop's first run: a welcome card over the system's own folder
    // dialog (onboarding.slint), instead of the phone's folder browser.
    in property <[string]> onboard-folders;
    in-out property <bool> onboard-watch: true;
    in property <[string]> language-names;
    in property <int> language-index;
    in-out property <bool> check-updates: true;
    callback onboard-add-folder();
    callback onboard-remove-folder(int);
    callback set-language(int);
    callback toggle-check-updates();
    callback onboard-start();
    callback onboard-skip();

    callback library-activated(int);
    callback library-enqueued(int);
    callback library-enqueue-path(string, bool);
    callback library-play-path(string);
    callback library-open-path(string);
    callback library-reclassify-path(string);
    callback library-pin-path(string);
    callback library-reveal-path(string);
    in-out property <int> library-mode: 0;
    callback library-mode-changed(int);
    in property <[GridLine]> library-grid-lines;
    in property <bool> library-grid;
    in property <string> library-crumb;
    callback library-grid-tapped(string);
    callback library-back();
    /// Tres tarjetas de ancho en vertical, ocho en apaisado. Rust reparte las
    /// celdas en líneas, así que tiene que enterarse cuando el número cambia.
    in-out property <int> library-columns: 3;
    callback library-columns-changed(int);
    in property <[PlaylistRow]> playlists;
    in property <[PlaylistRow]> all-playlists;
    in property <bool> showing-playlists;
    in property <bool> playlist-open;
    in property <int> playlist-count;
    callback playlist-open-requested(string);
    callback playlist-enqueue-all();
    callback playlist-create(string);
    callback add-path-to-playlist(string, bool, string);
    callback add-path-to-new-playlist(string, bool, string);
    callback playlist-track-removed(string);
    callback playlist-reordered(int, int);
    callback playlist-rename(string, string);
    callback playlist-delete(string);
    callback playlist-enqueue-id(string);
    callback queue-activated(int);
    callback queue-removed(int);
    callback queue-reordered(int, int);
    callback queue-cleared();
    callback search-changed(string);
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback seek-to(int);
    callback set-volume(float);
    callback cycle-sleep();
    callback rescan();
    callback descargar-caratulas();
    callback add-folder();
    callback cycle-loops();
    callback cycle-fade();
    in property <int> short-filter-secs;
    callback cycle-short-filter();
    in property <int> crossfade-secs;
    callback cycle-crossfade();
    in property <string> output-label: @tr("sistema");
    in property <string> language-label;
    callback cycle-language();
    in property <string> update-status;
    callback check-update();
    in property <string> theme-label;
    callback cycle-theme();
    callback show-log();
    callback reset-app();
    in property <[string]> tray-click-options;
    in property <[string]> tray-style-options;
    in property <[string]> cover-fit-options;
    in property <[string]> rating-priority-options;
    in property <[string]> mouse-action-options;
    in property <[string]> vgm-loops-options;
    in property <[string]> language-options;
    callback set-choice(string, string);
    in-out property <bool> close-to-tray;
    callback toggle-close-to-tray();
    in property <bool> show-in-tray;
    callback toggle-show-in-tray();
    in property <string> mouse-buttons-label;
    in property <bool> mouse-buttons-on;
    callback toggle-mouse-buttons();
    in property <string> global-shortcuts-label;
    in property <bool> global-shortcuts-on;
    callback toggle-global-shortcuts();
    in property <string> tray-style-label;
    callback cycle-tray-style();
    in property <string> tray-click-label;
    callback cycle-tray-click();
    in property <bool> update-skippable;
    callback skip-update();
    in property <string> desktop-entry-label;
    callback make-desktop-entry();
    in property <string> add-files-label;
    callback add-files();
    in property <string> cover-fit-label;
    callback cycle-cover-fit();
    in property <string> clear-cache-label;
    callback clear-cover-cache();
    in property <string> undo-covers-label;
    callback undo-covers();
    in property <bool> continue-queue;
    callback toggle-continue-queue();
    in property <bool> resume-on-open;
    callback toggle-resume-on-open();
    in property <int> resume-max-hours: 6;
    callback cycle-resume-hours();
    in property <int> loop-max-mins;
    callback cycle-loop-max();
    in-out property <bool> slow-scan;
    callback toggle-slow-scan();
    in property <bool> dsp-mono-compensate;
    in property <bool> dsp-mono-phase;
    callback toggle-mono-compensate();
    callback toggle-mono-phase();
    in-out property <bool> showing-log;
    /// A playback error the user must actually see; "" is silence. Click
    /// dismisses; the 500 ms timer ages it out after ~8 s, like the old
    /// desktop's ErrorToast.
    in-out property <string> error-toast;
    in-out property <int> error-toast-age;
    in property <[string]> log-lines;
    in property <string> log-level-label: @tr("todo");
    callback cycle-log-level();
    callback log-filter-changed(string);
    callback copy-log();
    callback clear-log();
    in-out property <bool> bulk-covering;
    in property <string> bulk-status;
    in property <[PlanRow]> bulk-plans;
    in property <bool> bulk-busy;
    callback bulk-apply();
    callback bulk-cancelled();
    callback cycle-output();
    // The audio-output picker: cycle-output now opens it (Rust fills these and
    // flips output-picking); pick-output applies the chosen index.
    in property <[string]> output-options;
    in property <int> output-current;
    in-out property <bool> output-picking;
    callback pick-output(int);
    in property <bool> eq-enabled;
    in property <float> eq-low;
    in property <float> eq-mid;
    in property <float> eq-high;
    in property <float> preamp-db;
    in property <bool> dsp-mono;
    in property <bool> dsp-limiter;
    callback toggle-eq();
    callback set-eq-band(int, float);
    callback set-preamp(float);
    callback toggle-mono();
    callback toggle-limiter();
    in property <float> dsp-balance;
    in property <float> dsp-width;
    callback set-balance(float);
    callback set-width(float);
    in property <string> rating-priority-label;
    callback cycle-rating-priority();

    // The desktop shell's track table. Sort and filter live in Rust.
    in property <[TableRow]> table-rows;
    in property <[TableColumn]> table-columns;
    in property <[ColumnChoice]> table-column-choices;
    callback table-column-toggled(string);
    in property <int> star-display-mode;
    callback set-star-display-mode(int);
    in property <length> table-restore-y;
    in property <int> table-restore-tick;
    in property <int> table-center-tick;
    in property <int> table-center-row;
    callback table-scrolled(length);
    in property <int> table-sort-col: 1;
    in property <bool> table-sort-asc: true;
    in-out property <string> table-filter;
    callback table-activated(int);
    callback table-sorted(int);
    callback table-filter-changed(string);
    callback table-rated(int, int);
    callback table-enqueued(int);
    callback table-play-next(int);
    callback table-add-to-playlist(int);
    in-out property <bool> picking-playlist;
    in property <string> pick-heading;
    callback playlist-picked(string);
    callback playlist-created-for-add(string);
    callback table-open-folder(int);
    callback table-pin-folder(int);
    callback table-column-moved(int, int);
    callback table-row-middle-clicked(int);
    callback table-column-resize-started(int);
    callback table-column-resized(int, float, float);
    callback table-column-resize-done();
    in property <[PinnedRow]> pinned-folders;
    in property <[PlaylistRow]> sidebar-consoles;
    callback console-opened(string);
    callback console-played(string);
    in property <string> total-count;
    in property <string> faved-count;
    in property <string> now-stars;
    in-out property <int> now-rating;
    in-out property <bool> names-fix-lengths: true;
    in-out property <string> reclass-console-filter;
    callback reclass-console-filter-changed(string);
    in-out property <int> sidebar-width;
    callback sidebar-resized(int);
    callback sidebar-play-all();
    callback playlist-played(string);
    callback folder-played(string);
    callback now-clicked();
    callback toggle-mute();
    callback toggle-crossfade();
    callback stop-playback();
    callback rate-now(int);
    in property <string> table-folder-id;
    /// "" library/faved · "folder" · "console" · "playlist" — what the table
    /// is scoped to, so the sidebar lights the right row.
    in property <string> table-scope-kind;
    callback console-opened-in-table(string);
    callback playlist-opened-in-table(string);
    callback table-remove-from-playlist(int);
    in property <string> table-scope-label;
    callback table-scope-cleared();
    callback folder-opened(string);
    callback folder-unpinned(string);
    callback folder-revealed(string);
    callback table-edit-requested(int);
    callback table-row-clicked(int, bool, bool);
    callback table-cursor-moved(int, bool);
    callback table-select-all();
    callback table-activate-cursor();
    in property <int> table-cursor: -1;
    in property <bool> meta-batch;
    in-out property <bool> editing-metadata;
    in property <string> meta-heading;
    in property <string> meta-detail;
    in property <string> meta-tech;
    in-out property <string> meta-title;
    in-out property <string> meta-artist;
    in-out property <string> meta-album;
    in-out property <string> meta-track;
    callback metadata-accepted();
    callback metadata-cancelled();
    callback table-reclassify-requested(int);
    in-out property <bool> reclassifying;
    in property <string> reclass-heading;
    in property <[ConsoleOption]> consoles;
    in-out property <string> reclass-console;
    in-out property <string> reclass-game;
    in-out property <bool> reclass-scope-folder;
    in property <[string]> reclass-suggestions;
    callback reclass-game-edited(string);
    callback reclass-accepted();
    callback reclass-cancelled();
    callback table-cover-requested(int);
    callback cover-auto();
    in-out property <bool> covering;
    in property <string> cover-heading;
    in property <string> cover-status;
    in-out property <string> cover-query;
    in property <[CoverCandidate]> cover-candidates;
    callback cover-search(string);
    callback cover-chosen(int);
    callback table-names-requested(int);
    in-out property <bool> naming;
    in property <string> names-heading;
    in property <string> names-status;
    in property <[string]> names-rows;
    in property <bool> names-can-apply;
    callback names-apply();
    in property <bool> table-faved;
    callback table-faved-changed(bool);
    callback table-needed();

    // Turning the phone is the only layout breakpoint that matters: portrait puts
    // the switcher along the bottom edge, within reach of a thumb; landscape moves
    // it to a rail so the artwork gets the width it just gained.
    //
    // Snapshotted on resize rather than written as `root.height >= root.width`.
    // As a derived binding it joins the layout's own size calculation — the tab
    // bar exists only in portrait, so the layout's height depends on it, and the
    // window's height depends on the layout — and Slint rejects that cycle as a
    // runtime panic risk. Assigning from a `changed` handler is a side effect,
    // not a binding, so no edge is added to the dependency graph.
    property <bool> portrait: true;

    // The on-screen keyboard does not overlay the window, it shrinks it. In
    // landscape that leaves about 205 logical pixels, and out of those the
    // mini-player was taking 68 — the library showed a single row while
    // searching it, which is the one moment the list matters most.
    //
    // So below a threshold the mini-player goes. Nothing is lost: the Playing
    // tab still has the full transport, and the lock screen has MPRIS.
    //
    // Snapshotted from `changed`, like `portrait` and for the same reason: the
    // mini-player's existence decides the layout's height, so writing this as a
    // binding on root.height would close a cycle Slint rejects outright.
    property <bool> cramped: false;

    // The third presentation: a wide window becomes the desktop shell —
    // sidebar, library, queue, one transport bar. Same anti-cycle rule as
    // `portrait`: snapshotted from `changed`, never derived, because whether
    // the shell exists decides the layout that sizes the window.
    //
    // Readable from Rust so a grid tap can route a console to the table on the
    // desktop and to a list on the phone.
    out property <bool> desktop: false;
    init => {
        root.reshape();
        Theme.t = root.theme-t;
    }

    function reshape() {
        root.portrait = root.height >= root.width;
        root.desktop = root.width >= 900px;
        // Desktop uses the old, tighter type scale.
        Theme.compact = root.desktop;
    }

    changed width => {
        root.reshape();
        root.retile();
    }

    // Tres de ancho con el móvil de pie, ocho tumbado, cinco en la shell de
    // escritorio (el panel central pierde ~510px entre sidebar y cola). Se
    // avisa a Rust sólo cuando cambia de verdad: cada píxel de redimensionado
    // dispara `changed`.
    function retile() {
        if (root.library-columns != (root.desktop ? 5 : (root.portrait ? 3 : 6))) {
            root.library-columns = root.desktop ? 5 : (root.portrait ? 3 : 6);
            root.library-columns-changed(root.library-columns);
        }
    }
    changed height => {
        root.reshape();
        root.cramped = root.height < 300px;
        root.retile();
    }
    // Changing tab slides the new one in from the edge it came from, so the
    // gesture and the tab bar agree about which way the app just moved.
    //
    // Only the incoming tab exists. Laying all four side by side in a strip and
    // translating it would be the obvious way to write this, but it keeps four
    // tabs instantiated forever — including the library's ListView, with its
    // viewport and its visible window of rows — for an effect that lasts 180 ms.
    // That trades permanent memory and per-frame work for an animation.
    //
    // Sliding a tab that has just been created needs the offset to jump to the
    // edge and then travel back, and in Slint any write to an animated property
    // animates. The jump is made instant by driving the duration itself: 0 ms
    // for the jump, then a one-shot timer restores the real duration and asks
    // for 0. `interval: 1ms` is not a delay, it is "next event loop turn".
    property <float> slide: 0;
    property <duration> slide-duration: 0ms;
    property <int> shown-tab: 0;
    animate slide { duration: root.slide-duration; easing: ease-out-quad; }

    changed tab => {
        root.slide-duration = 0ms;
        root.slide = root.tab > root.shown-tab ? 1.0 : -1.0;
        root.shown-tab = root.tab;
        slide-settle.running = true;
    }

    slide-settle := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.slide-duration = 180ms;
            root.slide = 0;
        }
    }

    // First run replaces the shell entirely: there is no library to show tabs
    // for, and offering them would only be three empty screens. Wide window,
    // welcome card and the system's folder dialog; narrow, the phone browser.
    if root.setup-mode && root.desktop: OnboardingSheet {
        folders: root.onboard-folders;
        watch: root.onboard-watch;
        theme-mode: root.theme-mode;
        language-names: root.language-names;
        language-index: root.language-index;
        auto-covers: root.auto-covers;
        check-updates: root.check-updates;
        add-folder => { root.onboard-add-folder(); }
        remove-folder(i) => { root.onboard-remove-folder(i); }
        toggle-watch => { root.onboard-watch = !root.onboard-watch; }
        set-theme(m) => { root.set-theme(m); }
        set-language(i) => { root.set-language(i); }
        toggle-covers => { root.toggle-auto-covers(); }
        toggle-updates => { root.toggle-check-updates(); }
        begin => { root.onboard-start(); }
        skip => { root.onboard-skip(); }
    }
    if root.setup-mode && !root.desktop: FolderPicker {
        entries: root.picker-entries;
        current-path: root.picker-path;
        chosen-count: root.picker-chosen;
        enter(i) => { root.picker-enter(i); }
        toggle(i) => { root.picker-toggle(i); }
        go-up => { root.picker-up(); }
        done => { root.picker-done(); }
    }

    // The desktop shell replaces the whole tabbed layout, not a tab of it: the
    // four screens exist inside it as panes.
    // Bare in-app shortcuts land here: this scope wraps the whole desktop
    // shell, holds focus by default (forward-focus below), and receives
    // whatever the table's own FocusScope rejects — while a TextInput with
    // focus keeps its keys, exactly like the old app ignored inputs.
    if !root.setup-mode && root.desktop: fs := FocusScope {
        // A FocusScope is not a layout: it will not stretch its child, so the
        // shell must be pinned to the window explicitly or the transport bar
        // and artwork drop off the bottom edge (the shell would size to its
        // content instead of the window).
        width: root.width;
        height: root.height;
        init => { self.focus(); }
        // On Wayland the init focus above does not always stick — the window is
        // not mapped yet — leaving nothing focused, so every bare shortcut
        // (Ctrl+P first of all) fell on the floor until something was clicked.
        // Re-grab focus once, a beat after startup, when the surface exists.
        Timer {
            interval: 150ms;
            running: true;
            triggered => { fs.focus(); self.running = false; }
        }
        // Ctrl+P is a GLOBAL shortcut: it must open Ajustes no matter which
        // inner scope holds focus. The capture phase runs from the root down
        // toward the focused item, so this fires before the track list or the
        // Árbol tree can swallow the key — which is exactly what "ignored
        // depending on where you press it" was. Only claim Ctrl+P here; let
        // every other key fall through to normal focus dispatch.
        capture-key-pressed(ev) => {
            if (ev.modifiers.control && (ev.text == "p" || ev.text == "\u{10}")) {
                ds.showing-settings = true;
                return accept;
            }
            reject
        }
        key-pressed(ev) => {
            // Ctrl+P also handled here for completeness, but the capture handler
            // above is what makes it global. With Ctrl held, winit/X11 delivers
            // the control byte (Ctrl+P = U+0010), not "p", so match both.
            if (ev.modifiers.control && (ev.text == "p" || ev.text == "\u{10}")) {
                ds.showing-settings = true;
                return accept;
            }
            if (root.shortcut-key(ev.text, ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift)) {
