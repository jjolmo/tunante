// The desktop shell's track table: every track in the library as sortable,
// filterable columns — what the Tauri desktop calls "All Tracks".
//
// The spike (apps/mini/examples/table_spike.rs) proved the shape first: a
// ListView over fixed-height rows holds 30 000 × 17 at the panel's refresh
// rate on both renderers, and a full sort-and-rebuild costs 11–21 ms. The
// columns are a model now, the GridLine trick sideways: Rust owns the catalog
// and the visible subset, pre-paints one cell string per column, and the UI
// never computes anything — which is also what makes show/hide free.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ColumnChoice, TableColumn, TableRow } from "types.slint";

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> asc;
    /// This cell is being dragged somewhere else.
    in property <bool> dragging;
    /// The dragged cell would land here.
    in property <bool> drop-target;
    /// The insertion line: the dragged column would slot in on this cell's
    /// leading (before) or trailing (after) edge.
    in property <bool> drop-before;
    in property <bool> drop-after;
    /// Press/drag/release with the offset from the press point — the parent
    /// decides whether the gesture was a sort click (under the threshold) or
    /// a reorder. Same protocol as the old desktop's raw mouse handlers.
    callback pressed();
    callback dragged(length);
    callback released(length);
    /// The 5px handle on the right edge: cumulative dx while resizing.
    callback resize-started();
    callback resized(length);
    callback resize-done();
    /// Right-click menu: the full column list to tick on/off, and — on the
    /// star column — the two rating-display modes.
    in property <[ColumnChoice]> column-choices;
    callback column-toggled(string);
    in property <bool> is-stars;
    in property <int> star-mode;
    callback set-star-mode(int);

    background: t.has-hover ? Theme.bg-hover : transparent;
    opacity: root.dragging ? 0.5 : 1.0;
    clip: false;

    // A single vertical accent bar marks exactly where the column lands,
    // instead of boxing the whole target cell.
    if root.drop-before: Rectangle {
        x: -1px;
        width: 2px;
        height: 100%;
        background: Theme.accent;
    }
    if root.drop-after: Rectangle {
        x: parent.width - 1px;
        width: 2px;
        height: 100%;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: 8px;
        spacing: 4px;
        // Pack the sort arrow right up against its label instead of letting
        // the label stretch and float the arrow out to the column's middle.
        alignment: start;
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.text-secondary;
            font-size: Theme.font-small;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.active: Text {
            text: root.asc ? "▲" : "▼";
            color: Theme.accent;
            font-size: 9px;
            vertical-alignment: center;
        }
    }
    t := TouchArea {
        moved => { root.dragged(self.mouse-x - self.pressed-x); }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left) {
                if (ev.kind == PointerEventKind.down) {
                    root.pressed();
                }
                if (ev.kind == PointerEventKind.up) {
                    root.released(self.mouse-x - self.pressed-x);
                }
            }
        }
    }
    // The resize handle, drawn last so it wins the 5px it needs.
    rh := TouchArea {
        x: root.width - 5px;
        width: 5px;
        height: 100%;
        mouse-cursor: col-resize;
        moved => { root.resized(self.mouse-x - self.pressed-x); }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left) {
                if (ev.kind == PointerEventKind.down) { root.resize-started(); }
                if (ev.kind == PointerEventKind.up) { root.resize-done(); }
            }
        }
    }
    if rh.has-hover || rh.pressed: Rectangle {
        x: root.width - 2px;
        width: 2px;
        height: 100%;
        background: Theme.accent;
    }
    // Right-click anywhere on the header: the column list to tick on/off, as
    // the old desktop did. The star column adds its two display modes below.
    ContextMenuArea {
        Menu {
            for c in root.column-choices: MenuItem {
                title: (c.shown ? "✓ " : "     ") + c.label;
                activated => { root.column-toggled(c.key); }
            }
            if root.is-stars: MenuSeparator {}
            if root.is-stars: Menu {
                title: "Columna de estrellas";
                MenuItem {
                    title: (root.star-mode == 0 ? "✓ " : "     ") + "Mostrar las cinco estrellas";
                    activated => { root.set-star-mode(0); }
                }
                MenuItem {
                    title: (root.star-mode == 1 ? "✓ " : "     ") + "Una estrella si tiene puntuación";
                    activated => { root.set-star-mode(1); }
                }
            }
        }
    }
}

export component TrackTable inherits Rectangle {
    in property <[TableRow]> rows;
    in property <[TableColumn]> columns;
    in property <[ColumnChoice]> column-choices;
    in property <string> now-path;
    in property <int> sort-col;
    in property <bool> sort-asc;
    in-out property <string> filter;
    callback activated(int);
    callback sorted(int);
    callback filter-changed(string);
    /// Row index and which star (1..5) was under the pointer; Rust decides
    /// whether that means set or clear.
    callback rated(int, int);
    /// "Y después esta": append to the queue context, mini's own enqueue.
    callback enqueued(int);
    /// "Y *justo* después": the priority queue next() consumes first.
    callback play-next(int);
    /// Open the playlist picker on this row (or the selection it sits in).
    callback add-to-playlist(int);
    /// Reveal the row's file in the system file manager.
    callback open-folder(int);
    /// Pin the row's folder to the sidebar.
    callback pin-folder(int);
    /// Open the metadata editor on this row.
    callback edit-requested(int);
    /// Open the reclassify sheet on this row.
    callback reclassify-requested(int);
    /// Open the cover picker on this row.
    callback cover-requested(int);
    /// Fetch the archive's track names for this row's file.
    callback names-requested(int);
    /// One click, with its modifiers: plain replaces the selection, Ctrl
    /// toggles, Shift extends from the anchor, Ctrl+Shift adds the range
    /// to what was already selected. Rust owns the set.
    callback row-clicked(int, bool, bool);
    /// Middle click: toggle the row in and out of the user queue — the
    /// old desktop's quickest enqueue.
    callback row-middle-clicked(int);
    /// Arrow keys: delta and whether Shift extends the range.
    callback cursor-moved(int, bool);
    callback select-all();
    /// Enter on the keyboard cursor.
    callback activate-cursor();
    /// A column ticked on or off in the chooser.
    callback column-toggled(string);
    /// Header dragged from one visible slot to another.
    callback column-moved(int, int);
    /// Resize, live: visible index, cumulative dx in px, table width in px.
    callback column-resize-started(int);
    callback column-resized(int, float, float);
    callback column-resize-done();
    /// Star column display mode: 0 = five stars, 1 = single filled star.
    in property <int> star-mode;
    callback set-star-mode(int);
    /// Scroll position, persisted across runs. `scrolled` reports the current
    /// offset (positive px from the top); bumping `restore-tick` applies
    /// `restore-y` to the ListView once its rows exist.
    callback scrolled(length);
    in property <length> restore-y;
    in property <int> restore-tick;
    changed restore-tick => { lv.viewport-y = -root.restore-y; }
    // Bumped to centre the view on the cursor row (e.g. "go to what's playing").
    in property <int> center-tick;
    changed center-tick => {
        if (root.cursor >= 0) {
            lv.viewport-y = -(root.cursor * root.row-h - (lv.visible-height - root.row-h) / 2);
        }
    }

    // Header-drag state. The threshold is the old desktop's: 5px from the
    // press point separates a sort click from a reorder gesture.
    property <int> drag-src: -1;
    property <bool> drag-active: false;
    property <length> drag-x;
    property <int> drop-col: -1;
    /// Where the keyboard cursor sits, for the scroll-into-view below.
    in property <int> cursor: -1;

    property <bool> choosing-columns: false;
    /// True when the table is showing a playlist — enables "remove from list".
    in property <bool> playlist-scope;
    callback remove-from-playlist(int);
    /// "Lista · X" / "Consola · Y" / "Carpeta · Z"; "" means All/Faved.
    in property <string> scope-label;
    callback scope-cleared();
    /// Rust bumps this to land focus in the filter box — the focus_search
    /// action; granting focus is slint-only business.
    in property <int> focus-filter-tick;
    changed focus-filter-tick => { filter-input.focus(); }
    /// The row under the pointer, for the tooltip below; -1 is nobody.
    property <int> tip-row: -1;

    // Keep the keyboard cursor on screen. 28px is the row height below; the
    // maths runs only when the cursor moves, not per frame.
    changed cursor => {
        if (root.cursor >= 0) {
            if (root.cursor * root.row-h < -lv.viewport-y) {
                lv.viewport-y = -root.cursor * root.row-h;
            }
            if ((root.cursor + 1) * root.row-h > -lv.viewport-y + lv.visible-height) {
                lv.viewport-y = -((root.cursor + 1) * root.row-h - lv.visible-height);
            }
        }
    }
    // One row's height, the real one: the tooltip and the cursor-scroll both
    // anchor to row * this, and it must match the rows the ListView paints —
    // a 28-vs-26 drift multiplied by an absolute row index slammed the tooltip
    // to the bottom of the table the moment you scrolled.
    property <length> row-h: Theme.compact ? 26px : 28px;

    VerticalLayout {
        // --- Scope chip: which collection the table is showing, and a way
        // out. Empty (Library/Faved) leaves no bar, so All Tracks looks the
        // same as it always did. On the phone it is its own row; the desktop
        // tucks it into the left of the filter box instead (see below).
        if root.scope-label != "" && !Theme.compact: Rectangle {
            height: 30px;
            background: Theme.bg-secondary;
            border-radius: 8px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 8px;
                Text {
                    text: root.scope-label;
                    color: Theme.accent;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 24px;
                    border-radius: Theme.radius;
                    background: scx.has-hover ? Theme.bg-hover : transparent;
                    Text {
                        text: "✕";
                        color: scx.has-hover ? Theme.text-primary : Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }
                    scx := TouchArea { clicked => { root.scope-cleared(); } }
                }
            }
        }

        // --- Filter box ---
        Rectangle {
            height: 40px;
            background: Theme.bg-secondary;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                // The desktop's scope chip, inline: label + a way out, left of
                // the search, so the folder title and the filter share one row.
                if root.scope-label != "" && Theme.compact: Text {
                    text: root.scope-label;
                    color: Theme.accent;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if root.scope-label != "" && Theme.compact: Rectangle {
                    width: 18px;
                    border-radius: Theme.radius;
                    background: scx2.has-hover ? Theme.bg-hover : transparent;
                    Text {
                        text: "✕";
                        color: scx2.has-hover ? Theme.text-primary : Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }
                    scx2 := TouchArea { clicked => { root.scope-cleared(); } }
                }
                if root.scope-label != "" && Theme.compact: Rectangle {
                    width: 1px;
                    background: Theme.bg-tertiary;
                }

                Text {
                    text: "🔍";
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
                filter-input := TextInput {
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    single-line: true;
                    text <=> root.filter;
                    edited => { root.filter-changed(self.text); }
                }
            }
            if root.filter == "" && !filter-input.has-focus: HorizontalLayout {
                padding-left: 36px;
                Text {
                    text: "Filtrar pistas…";
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
            }
        }

        // --- Header ---
        header := Rectangle {
            height: 30px;
            background: Theme.bg-primary;

            // Right-click lists every column, ticked when visible — the old
            // desktop's header menu. (Its trick of staying open between
            // ticks is not a thing a native menu does; the ⚙ chooser keeps
            // that job.)
            ContextMenuArea {
                Menu {
                    for c in root.column-choices: MenuItem {
                        title: (c.shown ? "✓ " : "\u{2003} ") + c.label;
                        activated => { root.column-toggled(c.key); }
                    }
                }
            }

            HorizontalLayout {
                for col[ci] in root.columns: HeaderCell {
                    width: cells-width.width * col.fraction;
                    label: col.label;
                    active: root.sort-col == ci;
                    asc: root.sort-asc;
                    column-choices: root.column-choices;
                    column-toggled(k) => { root.column-toggled(k); }
                    is-stars: col.key == "stars";
                    star-mode: root.star-mode;
                    set-star-mode(m) => { root.set-star-mode(m); }
                    dragging: root.drag-active && root.drag-src == ci;
                    drop-target: root.drag-active && root.drag-src != ci
                        && root.drag-x >= self.x && root.drag-x < self.x + self.width;
                    // The line sits on the edge the dragged column approaches
                    // from: coming from the right, it slots in before; from the
                    // left, after.
                    drop-before: self.drop-target && root.drag-src > ci;
                    drop-after: self.drop-target && root.drag-src < ci;
                    changed drop-target => {
                        if (self.drop-target) { root.drop-col = ci; }
                    }
                    pressed => {
                        root.drag-src = ci;
                        root.drag-active = false;
                        root.drop-col = -1;
                    }
                    dragged(dx) => {
                        if (root.drag-src == ci) {
                            root.drag-x = self.x + self.width / 2 + dx;
                            if (dx > 5px || dx < -5px) {
                                root.drag-active = true;
                            }
                        }
                    }
                    released(dx) => {
                        if (root.drag-active && root.drop-col >= 0
                            && root.drop-col != ci) {
                            root.column-moved(ci, root.drop-col);
                        } else if (!root.drag-active) {
                            root.sorted(ci);
                        }
                        root.drag-src = -1;
                        root.drag-active = false;
                        root.drop-col = -1;
                    }
                    resize-started => { root.column-resize-started(ci); }
                    resized(dx) => {
                        root.column-resized(ci, dx / 1px, cells-width.width / 1px);
                    }
                    resize-done => { root.column-resize-done(); }
                }
                // The column chooser lives where the columns end.
                Rectangle {
                    width: 30px;
                    background: gear.has-hover ? Theme.bg-hover : transparent;
                    Text {
                        text: "⚙";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                    }
                    gear := TouchArea {
                        clicked => { root.choosing-columns = true; }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.bg-tertiary; }

        // --- Rows ---
        //
        // The FocusScope is what makes the keyboard work: clicking a row
        // focuses it (the filter's TextInput keeps its own focus when it is
        // the thing clicked), and from then on arrows, Enter and Ctrl+A land
        // here.
        keys := FocusScope {
            vertical-stretch: 1;

            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.cursor-moved(-1, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.cursor-moved(1, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.activate-cursor();
                    return accept;
                }
                if (event.text == "a" && event.modifiers.control) {
                    root.select-all();
                    return accept;
                }
                if (event.text == Key.Delete && root.playlist-scope && root.cursor >= 0) {
                    root.remove-from-playlist(root.cursor);
                    return accept;
                }
                reject
            }

        if root.rows.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: root.filter != "" ? "Nada casa con la búsqueda."
                        : "No hay pistas en la biblioteca.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.filter != "" ? "Prueba con menos letras."
                        : "Añade carpetas desde Ajustes.";
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                }
            }
        }

        lv := ListView {
            changed viewport-y => { root.tip-row = -1; root.scrolled(-self.viewport-y); }

            for row[i] in root.rows: Rectangle {
                property <bool> playing: row.path == root.now-path;
                // Desktop matches the old Tauri TrackList: 26px rows, 12px cells.
                height: root.row-h;
                background: row.selected ? Theme.bg-selected
                    : (rt.has-hover ? Theme.bg-hover
                    : (mod(i, 2) == 0 ? Theme.bg-primary : Theme.bg-secondary));

                // The keyboard cursor, distinct from the selection it drives.
                border-width: i == root.cursor ? 1px : 0px;
                border-color: Theme.accent;

                rt := TouchArea {
                    changed has-hover => {
                        if (self.has-hover) {
                            root.tip-row = i;
                        } else if (root.tip-row == i) {
                            root.tip-row = -1;
                        }
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            // Any click dismisses a lingering tooltip; the
                            // hover below re-arms it for wherever the pointer
                            // actually is now.
                            root.tip-row = -1;
                            if (ev.button == PointerEventButton.left) {
                                root.row-clicked(i,
                                    ev.modifiers.control, ev.modifiers.shift);
                            }
                            // Right-click on something outside the selection
                            // retargets it, like every desktop list.
                            if (ev.button == PointerEventButton.right && !row.selected) {
                                root.row-clicked(i, false, false);
                            }
                            if (ev.button == PointerEventButton.middle) {
                                root.row-middle-clicked(i);
                            }
                        }
                    }
                    double-clicked => { root.activated(i); }
                }

                // Right-click, the desktop's other verb. Slint's native menu:
                // it draws with the platform, not with our rectangles.
                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "Reproducir";
                            activated => { root.activated(i); }
                        }
                        MenuItem {
                            title: "Reproducir a continuación";
                            activated => { root.play-next(i); }
                        }
                        MenuItem {
                            title: "Encolar";
                            activated => { root.enqueued(i); }
                        }
                        MenuItem {
                            title: "Quitar de la cola";
                            activated => { root.row-middle-clicked(i); }
                        }
                        if root.playlist-scope: MenuItem {
                            title: "Quitar de la lista";
                            activated => { root.remove-from-playlist(i); }
                        }
                        MenuItem {
                            title: "Añadir a lista…";
                            activated => { root.add-to-playlist(i); }
                        }
                        MenuItem {
                            title: "Editar metadatos…";
                            activated => { root.edit-requested(i); }
                        }
                        MenuItem {
                            title: "Reclasificar…";
                            activated => { root.reclassify-requested(i); }
                        }
                        MenuItem {
                            title: "Nombres de pistas…";
                            activated => { root.names-requested(i); }
                        }
                        MenuItem {
                            title: "Buscar carátula…";
                            activated => { root.cover-requested(i); }
                        }
                        MenuItem {
                            title: "Abrir carpeta";
                            activated => { root.open-folder(i); }
                        }
                        MenuItem {
                            title: "Fijar carpeta";
                            activated => { root.pin-folder(i); }
                        }
                    }
                }

                HorizontalLayout {
                    for col[ci] in root.columns: Rectangle {
                        width: cells-width.width * col.fraction;

                        // A dedicated "playing" column: the play glyph on the
                        // row that sounds, nothing on the rest.
                        if col.key == "playing": Text {
                            width: parent.width;
                            height: 100%;
                            text: playing ? "▶" : "";
                            color: row.selected ? #ffffff : Theme.accent;
                            font-size: Theme.compact ? 12px : Theme.font-body;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        if col.key != "stars" && col.key != "playing": Text {
                            x: 6px;
                            width: parent.width - 12px;
                            height: 100%;
                            text: ci == 0 && playing
                                ? "▶ " + row.cells[ci]
                                : (ci == 0 && row.queue-pos != ""
                                    ? row.queue-pos + " " + row.cells[ci]
                                    : row.cells[ci]);
                            // Selected or playing rows sit on a blue ground;
                            // white keeps their text legible where accent-on-
                            // accent would vanish.
                            color: row.selected || playing
                                ? #ffffff
                                : (ci == 0 && row.queue-pos != ""
                                    ? Theme.accent
                                // The old desktop painted every cell text-primary;
                                // the phone keeps secondary columns dimmer.
                                    : (ci == 0 || Theme.compact ? Theme.text-primary : Theme.text-secondary));
                            font-size: Theme.compact ? 12px : Theme.font-body;
                            vertical-alignment: center;
                            horizontal-alignment: col.right ? right : left;
                            overflow: elide;
                        }
                        // The stars are the one cell that is a control, not a
                        // label: which star was hit is plain arithmetic over
                        // five equal slots.
                        if col.key == "stars": Rectangle {
                            Text {
                                x: 0;
                                width: parent.width;
                                height: 100%;
                                text: row.cells[ci];
                                color: row.selected || playing ? #ffffff : Theme.accent;
                                // Bigger than a text cell: at font-small the
                                // glyphs read as specks. Letter-spacing gives
                                // the five room to breathe.
                                font-size: Theme.compact ? 19px : 21px;
                                letter-spacing: 1.5px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    root.rated(i, clamp(
                                        floor(self.mouse-x / (parent.width / 5)) + 1,
                                        1, 5));
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }

    // Header and rows share this so the ⚙ gutter never misaligns them.
    cells-width := Rectangle {
        width: parent.width - 30px;
        height: 0;
    }

    // --- The tooltip ---------------------------------------------------------
    //
    // Every elided cell's full story, on hover with an OS-style delay: the
    // state's `in` transition holds the fade until the pointer has settled,
    // and moving between rows keeps it up without re-waiting.
    tip := Rectangle {
        visible: root.tip-row >= 0 && root.tip-row < root.rows.length
            && self.opacity > 0.01;
        x: 46px;
        // Anchored just below the hovered row: list-top (filter + header, plus
        // the scope chip when it is showing) + the row's own offset + how far
        // the list is scrolled. Clamped so it never spills past the table.
        y: min((root.scope-label != "" && !Theme.compact ? 30px : 0px) + 71px
                   + (root.tip-row + 1) * root.row-h + lv.viewport-y,
               root.height - self.height - 8px);
        width: min(tip-l.preferred-width + 20px, root.width - 92px);
        height: tip-l.preferred-height + 14px;
        background: Theme.bg-tertiary;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.bg-hover;
        opacity: 0;
        states [
            shown when root.tip-row >= 0 : {
                opacity: 0.97;
                in { animate opacity { duration: 100ms; delay: 700ms; } }
            }
        ]
        tip-l := Text {
            x: 10px;
            y: 7px;
            width: parent.width - 20px;
            text: root.tip-row >= 0 && root.tip-row < root.rows.length
                ? root.rows[root.tip-row].tip : "";
            color: Theme.text-primary;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }

    // --- The column chooser ------------------------------------------------
    if root.choosing-columns: Rectangle {
        background: #000000bb;
        TouchArea { clicked => { root.choosing-columns = false; } }

        Rectangle {
            width: 280px;
            height: chooser.preferred-height;
            background: Theme.bg-secondary;
            border-radius: Theme.radius * 2;
            TouchArea { }

            chooser := VerticalLayout {
                padding: Theme.gap * 2;
                spacing: 2px;

                Text {
                    text: "Columnas";
                    color: Theme.text-primary;
                    font-size: Theme.font-title;
                    height: 34px;
                }
                for c in root.column-choices: Rectangle {
                    height: 32px;
                    border-radius: Theme.radius;
                    background: cht.has-hover ? Theme.bg-hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: c.label;
                            color: c.shown ? Theme.text-primary : Theme.text-muted;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: c.shown ? "✓" : "";
                            color: Theme.accent;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                        }
                    }
                    cht := TouchArea {
                        clicked => { root.column-toggled(c.key); }
                    }
                }
            }
        }
    }
}
