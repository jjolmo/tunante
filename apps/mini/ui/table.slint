// The desktop shell's track table: every track in the library as sortable,
// filterable columns — what the Tauri desktop calls "All Tracks".
//
// The spike (apps/mini/examples/table_spike.rs) proved the shape first: a
// ListView over fixed-height rows holds 30 000 × 17 at the panel's refresh
// rate on both renderers, and a full sort-and-rebuild costs 11–21 ms. This is
// that table grown real: fewer columns for now (fase 3b widens it), and the
// sorting/filtering on the Rust side of the callbacks, where the data is.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TableRow } from "types.slint";


component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> asc;
    callback clicked();

    background: t.has-hover ? Theme.bg-hover : transparent;

    HorizontalLayout {
        padding-left: 8px;
        spacing: 4px;
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.text-secondary;
            font-size: Theme.font-small;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.active: Text {
            text: root.asc ? "▲" : "▼";
            color: Theme.accent;
            font-size: 9px;
            vertical-alignment: center;
        }
    }
    t := TouchArea { clicked => { root.clicked(); } }
}

export component TrackTable inherits Rectangle {
    in property <[TableRow]> rows;
    in property <string> now-path;
    in property <int> sort-col;
    in property <bool> sort-asc;
    in-out property <string> filter;
    callback activated(int);
    callback sorted(int);
    callback filter-changed(string);
    /// Row index and which star (1..5) was under the pointer; Rust decides
    /// whether that means set or clear.
    callback rated(int, int);
    /// "Y después esta": append to the queue context, mini's own enqueue.
    callback enqueued(int);
    /// Reveal the row's file in the system file manager.
    callback open-folder(int);
    /// Open the metadata editor on this row.
    callback edit-requested(int);
    /// Open the reclassify sheet on this row.
    callback reclassify-requested(int);
    /// Open the cover picker on this row.
    callback cover-requested(int);
    /// One click, with its modifiers: plain replaces the selection, Ctrl
    /// toggles, Shift extends from the anchor. Rust owns the set.
    callback row-clicked(int, bool, bool);
    /// Arrow keys: delta and whether Shift extends the range.
    callback cursor-moved(int, bool);
    callback select-all();
    /// Enter on the keyboard cursor.
    callback activate-cursor();
    /// Where the keyboard cursor sits, for the scroll-into-view below.
    in property <int> cursor: -1;

    // Column layout, as fractions of the width. One place, used by header and
    // rows alike, so they cannot drift.
    property <[float]> widths: [0.04, 0.28, 0.17, 0.20, 0.10, 0.12, 0.09];

    // Keep the keyboard cursor on screen. 28px is the row height below; the
    // maths runs only when the cursor moves, not per frame.
    changed cursor => {
        if (root.cursor >= 0) {
            if (root.cursor * 28px < -lv.viewport-y) {
                lv.viewport-y = -root.cursor * 28px;
            }
            if ((root.cursor + 1) * 28px > -lv.viewport-y + lv.visible-height) {
                lv.viewport-y = -((root.cursor + 1) * 28px - lv.visible-height);
            }
        }
    }

    VerticalLayout {
        // --- Filter box ---
        Rectangle {
            height: 40px;
            background: Theme.bg-secondary;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                Text {
                    text: "🔍";
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
                filter-input := TextInput {
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    single-line: true;
                    text <=> root.filter;
                    edited => { root.filter-changed(self.text); }
                }
            }
            if root.filter == "" && !filter-input.has-focus: HorizontalLayout {
                padding-left: 36px;
                Text {
                    text: "Filtrar pistas…";
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
            }
        }

        // --- Header ---
        header := Rectangle {
            height: 30px;
            background: Theme.bg-primary;

            HorizontalLayout {
                for label[i] in ["#", "Título", "Artista", "Juego", "Consola", "★", "Duración"]: HeaderCell {
                    width: header.width * root.widths[i];
                    label: label;
                    active: root.sort-col == i;
                    asc: root.sort-asc;
                    clicked => { root.sorted(i); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.bg-tertiary; }

        // --- Rows ---
        //
        // The FocusScope is what makes the keyboard work: clicking a row
        // focuses it (the filter's TextInput keeps its own focus when it is
        // the thing clicked), and from then on arrows, Enter and Ctrl+A land
        // here.
        keys := FocusScope {
            vertical-stretch: 1;

            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.cursor-moved(-1, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.cursor-moved(1, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.activate-cursor();
                    return accept;
                }
                if (event.text == "a" && event.modifiers.control) {
                    root.select-all();
                    return accept;
                }
                reject
            }

        lv := ListView {

            for row[i] in root.rows: Rectangle {
                property <bool> playing: row.path == root.now-path;
                height: 28px;
                background: row.selected ? Theme.bg-selected
                    : (rt.has-hover ? Theme.bg-hover
                    : (mod(i, 2) == 0 ? Theme.bg-primary : Theme.bg-secondary));

                // The keyboard cursor, distinct from the selection it drives.
                border-width: i == root.cursor ? 1px : 0px;
                border-color: Theme.accent;

                rt := TouchArea {
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            if (ev.button == PointerEventButton.left) {
                                root.row-clicked(i,
                                    ev.modifiers.control, ev.modifiers.shift);
                            }
                            // Right-click on something outside the selection
                            // retargets it, like every desktop list.
                            if (ev.button == PointerEventButton.right && !row.selected) {
                                root.row-clicked(i, false, false);
                            }
                        }
                    }
                    double-clicked => { root.activated(i); }
                }

                // Right-click, the desktop's other verb. Slint's native menu:
                // it draws with the platform, not with our rectangles.
                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "Reproducir";
                            activated => { root.activated(i); }
                        }
                        MenuItem {
                            title: "Encolar";
                            activated => { root.enqueued(i); }
                        }
                        MenuItem {
                            title: "Editar metadatos…";
                            activated => { root.edit-requested(i); }
                        }
                        MenuItem {
                            title: "Reclasificar…";
                            activated => { root.reclassify-requested(i); }
                        }
                        MenuItem {
                            title: "Buscar carátula…";
                            activated => { root.cover-requested(i); }
                        }
                        MenuItem {
                            title: "Abrir carpeta";
                            activated => { root.open-folder(i); }
                        }
                    }
                }

                HorizontalLayout {
                    property <length> w: parent.width;
                    Text {
                        width: w * root.widths[0];
                        text: playing ? "▶" : row.n;
                        color: playing ? Theme.accent : Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        width: w * root.widths[1];
                        text: row.title;
                        color: playing ? Theme.accent : Theme.text-primary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        width: w * root.widths[2];
                        text: row.artist;
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        width: w * root.widths[3];
                        text: row.game;
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        width: w * root.widths[4];
                        text: row.console;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    stars-cell := Rectangle {
                        width: w * root.widths[5];
                        Text {
                            x: 0;
                            width: parent.width;
                            height: 100%;
                            text: row.stars;
                            color: Theme.accent;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        // On top of the row's own TouchArea, so a click on the
                        // stars rates instead of selecting. Which star: plain
                        // arithmetic over five equal slots.
                        TouchArea {
                            clicked => {
                                root.rated(i, clamp(
                                    floor(self.mouse-x / (stars-cell.width / 5)) + 1,
                                    1, 5));
                            }
                        }
                    }
                    Text {
                        width: w * root.widths[6];
                        text: row.duration;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }
        }
    }
}
