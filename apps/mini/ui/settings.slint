// The grande shell's settings, as a standalone modal dialog — the shape the
// old Tauri desktop used: a dimmed backdrop over the whole app and a centred
// panel with a left nav and the seven categories. Desktop-flavoured controls
// (real checkboxes for the toggles) instead of the phone list's sí/no. The
// mini shell keeps its single scrolling SettingsTab; this is only for grande.

import { ScrollView } from "std-widgets.slint";
import { Theme, Fmt } from "theme.slint";
import { FolderRow, ShortcutRow } from "types.slint";
import { SettingRow, DbSliderRow } from "widgets.slint";

// Left navigation entry.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 38px;
    border-radius: Theme.radius;
    background: root.active ? Theme.bg-selected
        : (t.has-hover ? Theme.bg-hover : transparent);
    HorizontalLayout {
        padding-left: 14px;
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
    t := TouchArea { clicked => { root.clicked(); } }
}

// A section title inside a tab.
component Section inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-small;
    height: 32px;
    vertical-alignment: bottom;
}

// A desktop-style checkbox row: label left, a real checkbox on the right.
component CheckRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    callback toggled();
    height: 38px;
    border-radius: Theme.radius;
    background: t.has-hover ? Theme.bg-hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.text-muted;
            background: root.checked ? Theme.accent : transparent;
            Text {
                text: root.checked ? "✓" : "";
                color: #ffffff;
                font-size: 13px;
            }
        }
    }
    t := TouchArea { clicked => { root.toggled(); } }
}

export component DesktopSettings inherits Rectangle {
    // 0 General · 1 Biblioteca · 2 Carátulas · 3 DSP · 4 Apariencia ·
    // 5 Atajos · 6 Acerca de
    property <int> tab: 0;

    in property <float> volume;
    in property <bool> sleep-running;
    in property <int> sleep-minutes;
    in property <string> library-summary;
    in property <[FolderRow]> library-folders;
    in property <string> vgm-loops-label;
    callback cycle-vgm-loops();
    in property <bool> auto-covers;
    callback toggle-auto-covers();
    in property <bool> covers-in-folder;
    callback toggle-covers-in-folder();
    in property <bool> titlebar-track;
    callback toggle-titlebar-track();
    in property <string> album-game-label;
    callback toggle-album-game();
    in property <bool> show-cover;
    callback toggle-show-cover();
    in property <bool> show-faved;
    callback toggle-show-faved();
    in property <bool> show-folders;
    callback toggle-show-folders();
    in property <bool> show-playlists;
    callback toggle-show-playlists();
    in property <string> about-label;
    callback open-repo();
    in property <[ShortcutRow]> shortcut-rows;
    callback shortcut-capture(string);
    callback folder-watch-toggled(string, bool);
    callback folder-removed(string);
    in property <int> loop-count;
    in property <int> fade-seconds;
    callback set-volume(float);
    callback cycle-sleep();
    callback rescan();
    callback descargar-caratulas();
    callback add-folder();
    callback cycle-loops();
    callback cycle-fade();
    in property <int> short-filter-secs;
    callback cycle-short-filter();
    in property <int> crossfade-secs;
    callback cycle-crossfade();
    in property <string> output-label: @tr("sistema");
    in property <string> ui-mode-label: "auto";
    /// The UI language: "" means follow the system, otherwise a native name.
    in property <string> language-label;
    callback cycle-language();
    in property <string> update-status;
    callback check-update();
    in property <string> theme-label;
    callback cycle-theme();
    callback show-log();
    in-out property <bool> close-to-tray;
    callback toggle-close-to-tray();
    in property <bool> show-in-tray;
    callback toggle-show-in-tray();
    in property <string> mouse-buttons-label;
    in property <bool> mouse-buttons-on;
    callback toggle-mouse-buttons();
    in property <string> global-shortcuts-label;
    in property <bool> global-shortcuts-on;
    callback toggle-global-shortcuts();
    in property <string> tray-style-label;
    callback cycle-tray-style();
    in property <string> tray-click-label;
    callback cycle-tray-click();
    in property <bool> update-skippable;
    callback skip-update();
    in property <string> desktop-entry-label;
    callback make-desktop-entry();
    in property <string> add-files-label;
    callback add-files();
    in property <string> cover-fit-label;
    callback cycle-cover-fit();
    in property <string> clear-cache-label;
    callback clear-cover-cache();
    in property <string> undo-covers-label;
    callback undo-covers();
    in property <bool> continue-queue;
    callback toggle-continue-queue();
    in property <bool> resume-on-open;
    callback toggle-resume-on-open();
    in property <int> loop-max-mins;
    callback cycle-loop-max();
    in-out property <bool> slow-scan;
    callback toggle-slow-scan();
    in property <bool> dsp-mono-compensate;
    in property <bool> dsp-mono-phase;
    callback toggle-mono-compensate();
    callback toggle-mono-phase();
    callback cycle-output();
    callback cycle-ui-mode();
    in property <bool> eq-enabled;
    in property <float> eq-low;
    in property <float> eq-mid;
    in property <float> eq-high;
    in property <float> preamp-db;
    in property <bool> dsp-mono;
    in property <bool> dsp-limiter;
    callback toggle-eq();
    callback set-eq-band(int, float);
    callback set-preamp(float);
    callback toggle-mono();
    callback toggle-limiter();
    in property <float> dsp-balance;
    in property <float> dsp-width;
    callback set-balance(float);
    callback set-width(float);
    in property <string> rating-priority-label;
    callback cycle-rating-priority();
    in property <bool> show-consoles;
    callback toggle-show-consoles();
    in property <bool> show-files;
    callback toggle-show-files();
    in property <bool> show-discos;
    callback toggle-show-discos();
    in property <bool> show-consoles-view;
    callback toggle-show-consoles-view();
    in property <bool> show-juegos;
    callback toggle-show-juegos();
    in property <bool> show-listas-view;
    callback toggle-show-listas-view();
    in property <bool> caps-all;
    callback toggle-caps-all();
    callback reset-dsp();
    in property <int> theme-mode;
    callback set-theme(int);
    in property <string> dsp-status;
    in property <bool> auto-update;
    callback toggle-auto-update();
    in property <bool> ask-update;
    callback toggle-ask-update();
    in property <string> mouse-back-label;
    in property <string> mouse-forward-label;
    in property <string> mouse-side-label;
    in property <string> mouse-extra-label;
    callback cycle-mouse-action(string);
    callback reset-shortcuts();
    in property <image> now-art;
    in property <int> cover-fit;
    in property <int> queue-placement;
    callback cycle-queue-placement();
    in property <bool> queue-always-visible;
    callback toggle-queue-always-visible();
    in property <int> star-display-mode;
    callback set-star-display-mode(int);
    in property <int> ui-mode;
    in-out property <int> ui-mode-pending;
    in property <string> ui-mode-pending-label;
    callback apply-ui-mode();
    // Closed from the ✕, the backdrop, or Escape.
    callback close();

    // The dimmed backdrop over the whole app; clicking it closes.
    background: #000000cc;
    TouchArea { clicked => { root.close(); } }

    // Escape closes, like the old dialog. Grabs focus on open.
    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(ev) => {
            if (ev.text == Key.Escape) { root.close(); return accept; }
            reject
        }
    }

    // The centred dialog.
    Rectangle {
        width: min(940px, root.width - 48px);
        height: min(700px, root.height - 48px);
        background: Theme.bg-primary;
        border-radius: Theme.radius * 2;
        border-width: 1px;
        border-color: Theme.bg-tertiary;
        clip: true;
        // Swallow clicks so they do not reach the backdrop.
        TouchArea {}

        VerticalLayout {
            // --- Header ---
            Rectangle {
                height: 52px;
                background: Theme.bg-secondary;
                HorizontalLayout {
                    padding-left: Theme.gap * 2;
                    padding-right: Theme.gap;
                    Text {
                        text: @tr("Ajustes");
                        color: Theme.text-primary;
                        font-size: Theme.font-title;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 40px;
                        border-radius: Theme.radius;
                        background: cx.has-hover ? Theme.bg-hover : transparent;
                        Text {
                            text: "✕";
                            color: cx.has-hover ? Theme.text-primary : Theme.text-muted;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                        }
                        cx := TouchArea { clicked => { root.close(); } }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.bg-tertiary; }

            HorizontalLayout {
                // --- Left nav rail ---
                Rectangle {
                    width: 180px;
                    background: Theme.bg-secondary;
                    VerticalLayout {
                        padding: Theme.gap;
                        spacing: 2px;
                        NavItem { label: @tr("General"); active: root.tab == 0; clicked => { root.tab = 0; } }
                        NavItem { label: @tr("Biblioteca"); active: root.tab == 1; clicked => { root.tab = 1; } }
                        NavItem { label: @tr("Carátulas"); active: root.tab == 2; clicked => { root.tab = 2; } }
                        NavItem { label: @tr("DSP"); active: root.tab == 3; clicked => { root.tab = 3; } }
                        NavItem { label: @tr("Apariencia"); active: root.tab == 4; clicked => { root.tab = 4; } }
                        NavItem { label: @tr("Atajos"); active: root.tab == 5; clicked => { root.tab = 5; } }
                        NavItem { label: @tr("Acerca de"); active: root.tab == 6; clicked => { root.tab = 6; } }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle { width: 1px; background: Theme.bg-tertiary; }

                // --- Content ---
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg-primary;
                    ScrollView {
                        VerticalLayout {
                            padding: Theme.gap * 2;
                            spacing: 2px;

                            // ===== General =====
                            if root.tab == 0: VerticalLayout {
                                spacing: 2px;
                                Section { text: @tr("Reproducción"); }
                                SettingRow {
                                    label: @tr("Repeticiones del bucle");
                                    value: root.loop-count == 0 ? "∞" : (root.loop-count == 1 ? "1" : (root.loop-count == 2 ? "2" : "3"));
                                    clicked => { root.cycle-loops(); }
                                }
                                SettingRow {
                                    label: @tr("Fundido final");
                                    value: root.fade-seconds == 0 ? @tr("desactivado") : (root.fade-seconds + " s");
                                    clicked => { root.cycle-fade(); }
                                }
                                SettingRow {
                                    label: @tr("Crossfade entre pistas");
                                    value: root.crossfade-secs == 0 ? @tr("desactivado") : (root.crossfade-secs + " s");
                                    clicked => { root.cycle-crossfade(); }
                                }
                                CheckRow {
                                    label: @tr("Continuar desde lo encolado");
                                    checked: root.continue-queue;
                                    toggled => { root.toggle-continue-queue(); }
                                }
                                CheckRow {
                                    label: @tr("Reanudar reproducción al abrir");
                                    checked: root.resume-on-open;
                                    toggled => { root.toggle-resume-on-open(); }
                                }
                                SettingRow {
                                    label: @tr("Saltar pistas cortas");
                                    value: root.short-filter-secs == 0 ? @tr("desactivado") : (root.short-filter-secs + " s");
                                    clicked => { root.cycle-short-filter(); }
                                }
                                SettingRow {
                                    label: @tr("Salida de audio");
                                    value: root.output-label;
                                    clicked => { root.cycle-output(); }
                                }
                                SettingRow {
                                    label: @tr("Apagar la música en");
                                    value: root.sleep-running ? (root.sleep-minutes + " min") : @tr("desactivado");
                                    clicked => { root.cycle-sleep(); }
                                }
                                Section { text: @tr("Bandeja y ventana"); }
                                CheckRow {
                                    label: @tr("Título de la canción en la ventana");
                                    checked: root.titlebar-track;
                                    toggled => { root.toggle-titlebar-track(); }
                                }
                                SettingRow {
                                    label: @tr("Click en el icono de bandeja");
                                    value: root.tray-click-label;
                                    clicked => { root.cycle-tray-click(); }
                                }
                                SettingRow {
                                    label: @tr("Icono de bandeja");
                                    value: root.tray-style-label;
                                    clicked => { root.cycle-tray-style(); }
                                }
                                CheckRow {
                                    label: @tr("Mostrar icono en la bandeja (requiere reiniciar)");
                                    checked: root.show-in-tray;
                                    toggled => { root.toggle-show-in-tray(); }
                                }
                                CheckRow {
                                    label: @tr("Cerrar a la bandeja");
                                    checked: root.close-to-tray;
                                    toggled => { root.toggle-close-to-tray(); }
                                }
                            }

                            // ===== Biblioteca =====
                            if root.tab == 1: VerticalLayout {
                                spacing: 2px;
                                Section { text: @tr("Carpetas analizadas"); }
                                SettingRow {
                                    label: @tr("Añadir una carpeta");
                                    value: "＋";
                                    clicked => { root.add-folder(); }
                                }
                                for lf in root.library-folders: Rectangle {
                                    height: 40px;
                                    HorizontalLayout {
                                        padding-left: Theme.gap;
                                        padding-right: Theme.gap;
                                        spacing: Theme.gap;
                                        Text {
                                            text: lf.path;
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-small;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 84px;
                                            border-radius: Theme.radius;
                                            background: wt.has-hover ? Theme.bg-hover : transparent;
                                            Text {
                                                text: lf.watching ? @tr("vigilada") : @tr("sin vigilar");
                                                color: lf.watching ? Theme.accent : Theme.text-muted;
                                                font-size: Theme.font-small;
                                                vertical-alignment: center;
                                            }
                                            wt := TouchArea {
                                                clicked => { root.folder-watch-toggled(lf.id, !lf.watching); }
                                            }
                                        }
                                        Rectangle {
                                            width: 32px;
                                            border-radius: Theme.radius;
                                            background: xt.has-hover ? Theme.bg-hover : transparent;
                                            Text {
                                                text: "✕";
                                                color: xt.has-hover ? Theme.text-primary : Theme.text-muted;
                                                font-size: Theme.font-body;
                                                vertical-alignment: center;
                                            }
                                            xt := TouchArea {
                                                clicked => { root.folder-removed(lf.id); }
                                            }
                                        }
                                    }
                                }
                                SettingRow {
                                    label: @tr("Volver a analizar");
                                    value: "↻";
                                    clicked => { root.rescan(); }
                                }
                                SettingRow {
                                    label: @tr("Añadir ficheros sueltos");
                                    value: root.add-files-label;
                                    clicked => { root.add-files(); }
                                }
                                Section { text: @tr("Escaneo"); }
                                CheckRow {
                                    label: @tr("Escaneo minucioso");
                                    checked: root.slow-scan;
                                    toggled => { root.toggle-slow-scan(); }
                                }
                                SettingRow {
                                    label: @tr("Bucles de formatos streamed");
                                    value: root.vgm-loops-label;
                                    clicked => { root.cycle-vgm-loops(); }
                                }
                                SettingRow {
                                    label: @tr("Tope de pistas infinitas");
                                    value: root.loop-max-mins == 0 ? @tr("predeterminado") : (root.loop-max-mins + " min");
                                    clicked => { root.cycle-loop-max(); }
                                }
                                CheckRow {
                                    label: @tr("Aplicar el tope a todas las pistas");
                                    checked: root.caps-all;
                                    toggled => { root.toggle-caps-all(); }
                                }
                                Section { text: @tr("Metadatos"); }
                                SettingRow {
                                    label: @tr("La columna Álbum/Juego enseña");
                                    value: root.album-game-label;
                                    clicked => { root.toggle-album-game(); }
                                }
                                SettingRow {
                                    label: @tr("Prioridad de puntuaciones");
                                    value: root.rating-priority-label;
                                    clicked => { root.cycle-rating-priority(); }
                                }
                            }

                            // ===== Carátulas =====
                            if root.tab == 2: VerticalLayout {
                                spacing: 2px;
                                SettingRow {
                                    label: @tr("Descargar carátulas que falten");
                                    value: "⬇";
                                    clicked => { root.descargar-caratulas(); }
                                }
                                CheckRow {
                                    label: @tr("Descarga automática de carátulas");
                                    checked: root.auto-covers;
                                    toggled => { root.toggle-auto-covers(); }
                                }
                                CheckRow {
                                    label: @tr("Guardar carátula en la carpeta");
                                    checked: root.covers-in-folder;
                                    toggled => { root.toggle-covers-in-folder(); }
                                }
                                SettingRow {
                                    label: @tr("Deshacer última descarga");
                                    value: root.undo-covers-label;
                                    clicked => { root.undo-covers(); }
                                }
                                SettingRow {
                                    label: @tr("Encaje de carátula");
                                    value: root.cover-fit-label;
                                    clicked => { root.cycle-cover-fit(); }
                                }
                                SettingRow {
                                    label: @tr("Limpiar caché de carátulas");
                                    value: root.clear-cache-label;
                                    clicked => { root.clear-cover-cache(); }
                                }
                            }

                            // ===== DSP =====
                            if root.tab == 3: VerticalLayout {
                                spacing: 2px;
                                Rectangle {
                                    height: 34px;
                                    border-radius: Theme.radius;
                                    background: Theme.bg-secondary;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        Text {
                                            text: root.dsp-status;
                                            color: Theme.text-muted;
                                            font-size: Theme.font-small;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                                Section { text: @tr("Ecualizador"); }
                                CheckRow {
                                    label: @tr("Ecualizador");
                                    checked: root.eq-enabled;
                                    toggled => { root.toggle-eq(); }
                                }
                                DbSliderRow {
                                    label: @tr("Graves");
                                    db: root.eq-low;
                                    active: root.eq-enabled;
                                    changed(v) => { root.set-eq-band(0, v); }
                                }
                                DbSliderRow {
                                    label: @tr("Medios");
                                    db: root.eq-mid;
                                    active: root.eq-enabled;
                                    changed(v) => { root.set-eq-band(1, v); }
                                }
                                DbSliderRow {
                                    label: @tr("Agudos");
                                    db: root.eq-high;
                                    active: root.eq-enabled;
                                    changed(v) => { root.set-eq-band(2, v); }
                                }
                                Section { text: @tr("Ganancia y dinámica"); }
                                DbSliderRow {
                                    label: @tr("Preamplificador");
                                    db: root.preamp-db;
                                    changed(v) => { root.set-preamp(v); }
                                }
                                CheckRow {
                                    label: @tr("Limitador");
                                    checked: root.dsp-limiter;
                                    toggled => { root.toggle-limiter(); }
                                }
                                Section { text: @tr("Espacialidad"); }
                                CheckRow {
                                    label: @tr("Mono");
                                    checked: root.dsp-mono;
                                    toggled => { root.toggle-mono(); }
                                }
                                CheckRow {
                                    label: @tr("Mono · compensación de nivel");
                                    checked: root.dsp-mono-compensate;
                                    toggled => { root.toggle-mono-compensate(); }
                                }
                                CheckRow {
                                    label: @tr("Mono · seguro de fase");
                                    checked: root.dsp-mono-phase;
                                    toggled => { root.toggle-mono-phase(); }
                                }
                                if root.dsp-mono && (root.dsp-balance > 0.001 || root.dsp-balance < -0.001): SettingRow {
                                    label: @tr("Con mono, el balance descentrado silencia un lado");
                                    value: @tr("Centrar");
                                    highlighted: true;
                                    clicked => { root.set-balance(0); }
                                }
                                DbSliderRow {
                                    label: @tr("Balance");
                                    db: root.dsp-balance;
                                    range-min: -1;
                                    range-max: 1;
                                    unit: "";
                                    changed(v) => { root.set-balance(v); }
                                }
                                DbSliderRow {
                                    label: @tr("Anchura estéreo");
                                    db: root.dsp-width;
                                    range-min: 0;
                                    range-max: 2;
                                    unit: "";
                                    changed(v) => { root.set-width(v); }
                                }
                                SettingRow {
                                    label: @tr("Restablecer todos los efectos");
                                    value: "↺";
                                    clicked => { root.reset-dsp(); }
                                }
                            }

                            // ===== Apariencia =====
                            if root.tab == 4: VerticalLayout {
                                spacing: 2px;
                                Section { text: @tr("Presentación"); }
                                SettingRow {
                                    label: @tr("Idioma");
                                    // Native language names stay in their own
                                    // language; only "System" gets translated.
                                    value: root.language-label == "" ? @tr("Sistema") : root.language-label;
                                    clicked => { root.cycle-language(); }
                                }
                                SettingRow {
                                    label: @tr("Modo de interfaz");
                                    value: root.ui-mode-pending-label;
                                    clicked => { root.cycle-ui-mode(); }
                                }
                                if root.ui-mode-pending != root.ui-mode: SettingRow {
                                    label: @tr("  ↳ Aplicar (cambia la presentación)");
                                    value: @tr("Aplicar");
                                    highlighted: true;
                                    clicked => { root.apply-ui-mode(); }
                                }
                                SettingRow {
                                    label: @tr("Cola");
                                    value: root.queue-placement == 2 ? @tr("panel derecho") : @tr("entrada en el sidebar");
                                    clicked => { root.cycle-queue-placement(); }
                                }
                                SettingRow {
                                    label: @tr("  ↳ Visibilidad de la cola");
                                    value: root.queue-always-visible ? @tr("siempre visible") : @tr("solo cuando hay cola");
                                    clicked => { root.toggle-queue-always-visible(); }
                                }
                                SettingRow {
                                    label: @tr("Estrellas de puntuación");
                                    value: root.star-display-mode == 1 ? @tr("una si tiene puntuación") : @tr("las cinco");
                                    clicked => { root.set-star-display-mode(root.star-display-mode == 1 ? 0 : 1); }
                                }
                                Section { text: @tr("Tema"); }
                                HorizontalLayout {
                                    spacing: Theme.gap;
                                    height: 84px;
                                    for card[ci] in [
                                        { name: @tr("Oscuro"), mode: 0 },
                                        { name: @tr("Claro"), mode: 1 },
                                        { name: @tr("Sistema"), mode: 2 },
                                    ]: Rectangle {
                                        border-radius: Theme.radius;
                                        border-width: root.theme-mode == card.mode ? 2px : 1px;
                                        border-color: root.theme-mode == card.mode ? Theme.accent : Theme.bg-tertiary;
                                        background: tcard.has-hover ? Theme.bg-hover : Theme.bg-secondary;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            padding: Theme.gap;
                                            // A little swatch that hints the theme.
                                            Rectangle {
                                                height: 30px;
                                                border-radius: 4px;
                                                background: card.mode == 1 ? #f4f4f4
                                                    : (card.mode == 0 ? #1e1e1e : #808080);
                                                border-width: 1px;
                                                border-color: Theme.bg-tertiary;
                                            }
                                            Text {
                                                text: card.name;
                                                color: root.theme-mode == card.mode ? Theme.accent : Theme.text-primary;
                                                font-size: Theme.font-small;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        tcard := TouchArea { clicked => { root.set-theme(card.mode); } }
                                    }
                                }
                                Section { text: @tr("Vistas de la biblioteca"); }
                                CheckRow {
                                    label: @tr("Árbol");
                                    checked: root.show-files;
                                    toggled => { root.toggle-show-files(); }
                                }
                                CheckRow {
                                    label: @tr("Discos");
                                    checked: root.show-discos;
                                    toggled => { root.toggle-show-discos(); }
                                }
                                CheckRow {
                                    label: @tr("Consolas");
                                    checked: root.show-consoles-view;
                                    toggled => { root.toggle-show-consoles-view(); }
                                }
                                CheckRow {
                                    label: @tr("Juegos");
                                    checked: root.show-juegos;
                                    toggled => { root.toggle-show-juegos(); }
                                }
                                CheckRow {
                                    label: @tr("Listas");
                                    checked: root.show-listas-view;
                                    toggled => { root.toggle-show-listas-view(); }
                                }
                                Section { text: @tr("Secciones del sidebar"); }
                                CheckRow {
                                    label: @tr("Carátula del reproductor");
                                    checked: root.show-cover;
                                    toggled => { root.toggle-show-cover(); }
                                }
                                CheckRow {
                                    label: @tr("Favoritos");
                                    checked: root.show-faved;
                                    toggled => { root.toggle-show-faved(); }
                                }
                                CheckRow {
                                    label: @tr("Carpetas");
                                    checked: root.show-folders;
                                    toggled => { root.toggle-show-folders(); }
                                }
                                CheckRow {
                                    label: @tr("Consolas (acceso rápido)");
                                    checked: root.show-consoles;
                                    toggled => { root.toggle-show-consoles(); }
                                }
                                CheckRow {
                                    label: @tr("Listas (acceso rápido)");
                                    checked: root.show-playlists;
                                    toggled => { root.toggle-show-playlists(); }
                                }
                            }

                            // ===== Atajos =====
                            if root.tab == 5: VerticalLayout {
                                spacing: 2px;
                                Section { text: @tr("Globales"); }
                                CheckRow {
                                    label: @tr("Atajos globales");
                                    checked: root.global-shortcuts-on;
                                    toggled => { root.toggle-global-shortcuts(); }
                                }
                                CheckRow {
                                    label: @tr("Botones de ratón");
                                    checked: root.mouse-buttons-on;
                                    toggled => { root.toggle-mouse-buttons(); }
                                }
                                SettingRow {
                                    label: @tr("Ratón · Atrás");
                                    value: root.mouse-back-label;
                                    clicked => { root.cycle-mouse-action("back"); }
                                }
                                SettingRow {
                                    label: @tr("Ratón · Adelante");
                                    value: root.mouse-forward-label;
                                    clicked => { root.cycle-mouse-action("forward"); }
                                }
                                SettingRow {
                                    label: @tr("Ratón · Lateral");
                                    value: root.mouse-side-label;
                                    clicked => { root.cycle-mouse-action("side"); }
                                }
                                SettingRow {
                                    label: @tr("Ratón · Extra");
                                    value: root.mouse-extra-label;
                                    clicked => { root.cycle-mouse-action("extra"); }
                                }
                                Section { text: @tr("Teclas de la aplicación"); }
                                for sr in root.shortcut-rows: SettingRow {
                                    label: sr.label;
                                    value: sr.key == "" ? "—" : sr.key;
                                    highlighted: sr.key != "" && sr.key != "pulsa una tecla…";
                                    clicked => { root.shortcut-capture(sr.id); }
                                }
                                SettingRow {
                                    label: @tr("Restablecer todos los atajos");
                                    value: "↺";
                                    clicked => { root.reset-shortcuts(); }
                                }
                            }

                            // ===== Acerca de =====
                            if root.tab == 6: VerticalLayout {
                                spacing: 10px;
                                // Logo + name + version, the old header.
                                HorizontalLayout {
                                    spacing: Theme.gap * 1.5;
                                    padding-top: Theme.gap;
                                    Image {
                                        width: 64px;
                                        height: 64px;
                                        source: @image-url("../dist/icons/128x128/tunante-mini.png");
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Tunante";
                                            color: Theme.text-primary;
                                            font-size: Theme.font-title * 1.2;
                                            font-weight: 700;
                                        }
                                        Text {
                                            text: root.about-label;
                                            color: Theme.text-muted;
                                            font-size: Theme.font-small;
                                        }
                                    }
                                }
                                Text {
                                    text: @tr("Un reproductor multiplataforma centrado en la música de videojuegos, inspirado en foobar2000.");
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }

                                Section { text: @tr("Actualizaciones"); }
                                SettingRow {
                                    label: @tr("Buscar actualizaciones");
                                    value: root.update-status;
                                    clicked => { root.check-update(); }
                                }
                                if root.update-skippable: SettingRow {
                                    label: @tr("Omitir esta versión");
                                    value: "×";
                                    clicked => { root.skip-update(); }
                                }
                                CheckRow {
                                    label: @tr("Auto-actualizar al arrancar");
                                    checked: root.auto-update;
                                    toggled => { root.toggle-auto-update(); }
                                }
                                CheckRow {
                                    label: @tr("Avisar de actualizaciones al arrancar");
                                    checked: root.ask-update;
                                    toggled => { root.toggle-ask-update(); }
                                }

                                Section { text: @tr("Sistema"); }
                                SettingRow {
                                    label: @tr("Integrar en el escritorio");
                                    value: root.desktop-entry-label;
                                    clicked => { root.make-desktop-entry(); }
                                }
                                SettingRow {
                                    label: @tr("Registro");
                                    value: "≡";
                                    clicked => { root.show-log(); }
                                }

                                Section { text: @tr("Código fuente"); }
                                Rectangle {
                                    height: 38px;
                                    border-radius: Theme.radius;
                                    background: gh.has-hover ? Theme.bg-hover : transparent;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        Text {
                                            text: "github.com/jjolmo/tunante";
                                            color: Theme.accent;
                                            font-size: Theme.font-body;
                                            vertical-alignment: center;
                                        }
                                    }
                                    gh := TouchArea { clicked => { root.open-repo(); } }
                                }

                                Section { text: @tr("Construido con"); }
                                HorizontalLayout {
                                    spacing: 6px;
                                    padding-bottom: Theme.gap;
                                    for tech in ["Slint", "Rust", "SQLite", "rodio", "lofty", "vgmstream"]: Rectangle {
                                        height: 26px;
                                        width: badge.preferred-width + 18px;
                                        border-radius: 13px;
                                        background: Theme.bg-tertiary;
                                        badge := Text {
                                            text: tech;
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-small;
                                        }
                                    }
                                }

                                Text {
                                    text: @tr("Vibecoded por jjolmo.");
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
