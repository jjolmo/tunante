// Tunante's palette, carried over from the desktop app's src/app.css so the two
// look like the same program. Thirteen tokens, dark and light.
//
// Keep this the single source of colour: no literal `#rrggbb` anywhere else in
// the UI. Re-theming then means editing one file.

export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg-primary:     self.dark ? #1e1e1e : #ffffff;
    out property <color> bg-secondary:   self.dark ? #252526 : #f3f3f3;
    out property <color> bg-tertiary:    self.dark ? #2d2d30 : #e8e8e8;
    out property <color> bg-hover:       self.dark ? #3e3e42 : #d4d4d4;
    out property <color> bg-selected:    self.dark ? #094771 : #cce5ff;
    out property <color> text-primary:   self.dark ? #cccccc : #1e1e1e;
    out property <color> text-secondary: self.dark ? #969696 : #616161;
    out property <color> text-muted:     self.dark ? #5a5a5a : #a0a0a0;
    out property <color> accent:         #007acc;
    out property <color> accent-hover:   self.dark ? #1c97ea : #005999;
    out property <color> border:         self.dark ? #3e3e42 : #d4d4d4;
    // For the one banner there is. Amber rather than red: the music is waiting,
    // not lost.
    out property <color> warning-bg:     self.dark ? #4a3a10 : #fff4ce;
    out property <color> warning-fg:     self.dark ? #f0c674 : #6b5200;

    // A finger is not a mouse pointer. Nothing interactive goes below this.
    out property <length> touch-target: 48px;
    out property <length> gap: 12px;
    out property <length> radius: 8px;

    out property <length> font-title: 17px;
    out property <length> font-body: 15px;
    out property <length> font-small: 13px;
}

// Small formatting helpers, so the same clock is written the same way wherever
// it appears.
export global Fmt {
    // m:ss, from milliseconds. Hours are folded into the minutes rather than
    // shown separately: an hour-long track is a rarity here, and a "1:02:03"
    // that only sometimes appears makes the row jump width as tracks change.
    pure public function mmss(ms: int) -> string {
        ms <= 0
            ? "0:00"
            : floor(ms / 60000) + ":" + (mod(floor(ms / 1000), 60) < 10 ? "0" : "")
              + mod(floor(ms / 1000), 60);
    }
}
