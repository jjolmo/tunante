// The desktop shell: sidebar | library | queue, over one transport bar.
//
// Fase 2 of docs/plan-desktop-slint.md. Deliberately built from the same
// screens the phone uses — LibraryTab, QueueTab and SettingsTab are
// instantiated whole, fed by the same models and firing the same callbacks,
// so there is exactly one implementation of every behaviour and the shell is
// only a different arrangement of it. The wide track table of fase 3b will
// replace the centre pane; until then the phone's list *is* the library view.

import { ListView } from "std-widgets.slint";
import { Theme, Fmt } from "theme.slint";
import { ColumnChoice, ConsoleOption, CoverCandidate, GridLine, LibraryRow, QueueRow, PlaylistRow, TableColumn, TableRow, PinnedRow, FolderRow, ShortcutRow } from "types.slint";
import { Artwork, TrackInfo, RoundButton, SeekBar, MetadataSheet, ReclassifySheet, CoverSheet, PlaylistPickSheet, TrackNamesSheet, ConsoleArt } from "widgets.slint";
import { LibraryTab, QueueTab, SettingsTab } from "tabs.slint";
import { TrackTable } from "table.slint";
import { DesktopSettings } from "settings.slint";

// A transport button drawn with the app's own SVG icons — the glyphs the
// old desktop shipped, tinted by state. Text glyphs came from whatever font
// the system had and landed on whatever baseline it felt like; these do not.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <length> icon-size: 16px;
    /// Tiny superscript, e.g. repeat-one's "1".
    in property <string> badge;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: ta.has-hover ? Theme.bg-hover : transparent;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: root.active ? Theme.accent
            : (ta.has-hover ? Theme.text-primary : Theme.text-secondary);
    }
    if root.badge != "": Text {
        x: parent.width - 11px;
        y: 1px;
        text: root.badge;
        color: Theme.accent;
        font-size: 9px;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component SidebarEntry inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    /// Double click: play this collection, the old desktop's shortcut.
    callback played();
    /// The old desktop put a number beside every entry; the answer to
    /// "how big is my library" should not need a click.
    in property <string> count;
    callback clicked();

    height: 34px;
    background: root.active ? Theme.bg-selected : (t.has-hover ? Theme.bg-hover : transparent);
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.text-primary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.count != "": Text {
            text: root.count;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
    t := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.played(); }
    }
}

// A horizontal 0..1 slider in the house style, for the volume.
component VolumeBar inherits Rectangle {
    in property <float> value;
    callback changed(float);

    height: 24px;

    track := Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.bg-tertiary;

        Rectangle {
            x: 0;
            width: parent.width * clamp(root.value, 0.0, 1.0);
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.accent;
        }
    }
    Rectangle {
        x: track.width * clamp(root.value, 0.0, 1.0) - self.width / 2;
        width: touch.pressed ? 14px : 10px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.accent;
        animate width { duration: 90ms; }
    }
    touch := TouchArea {
        moved => { root.changed(clamp(self.mouse-x / track.width, 0.0, 1.0)); }
        clicked => { root.changed(clamp(self.mouse-x / track.width, 0.0, 1.0)); }
    }
}

export component DesktopShell inherits Rectangle {
    background: Theme.bg-primary;

    // --- Mirrors of AppWindow's state, wired straight through ---
    in property <[LibraryRow]> library-rows;
    in property <int> library-total;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <string> now-path;
    in property <image> now-art;
    in-out property <bool> playing;
    in-out property <bool> shuffle;
    in-out property <int> repeat;
    in property <int> position-ms;
    in property <int> duration-ms;
    in-out property <float> volume;
    in-out property <string> search;
    in property <bool> autofocus-search;
    in-out property <int> library-mode;
    in property <[GridLine]> library-grid-lines;
    in property <bool> library-grid;
    in property <string> library-crumb;
    in property <int> library-columns;
    in property <[QueueRow]> queue-rows;
    in property <[PlaylistRow]> playlists;
    in property <[PlaylistRow]> all-playlists;
    in property <bool> showing-playlists;
    in property <bool> playlist-open;
    in property <int> playlist-count;
    in property <string> output-warning;
    in property <bool> sleep-running;
    in property <int> sleep-minutes;
    in property <string> library-summary;
    in property <[FolderRow]> library-folders;
    in property <string> vgm-loops-label;
    callback cycle-vgm-loops();
    in property <bool> auto-covers;
    callback toggle-auto-covers();
    in property <bool> covers-in-folder;
    callback toggle-covers-in-folder();
    in property <bool> titlebar-track;
    callback toggle-titlebar-track();
    in property <string> album-game-label;
    callback toggle-album-game();
    in property <bool> show-cover;
    callback toggle-show-cover();
    in property <bool> show-faved;
    callback toggle-show-faved();
    in property <bool> show-folders;
    callback toggle-show-folders();
    in property <bool> show-playlists;
    callback toggle-show-playlists();
    in property <bool> show-consoles;
    callback toggle-show-consoles();
    in property <bool> show-files;
    callback toggle-show-files();
    in property <bool> caps-all;
    callback toggle-caps-all();
    callback reset-dsp();
    in property <int> theme-mode;
    callback set-theme(int);
    in property <string> dsp-status;
    in property <bool> auto-update;
    callback toggle-auto-update();
    in property <bool> ask-update;
    callback toggle-ask-update();
    in property <string> mouse-back-label;
    in property <string> mouse-forward-label;
    in property <string> mouse-side-label;
    in property <string> mouse-extra-label;
    callback cycle-mouse-action(string);
    in property <string> about-label;
    callback open-repo();
    in property <[ShortcutRow]> shortcut-rows;
    callback shortcut-capture(string);
    in property <int> focus-filter-tick;
    /// Rust bumps this for Ctrl+P: land in Ajustes.
    in property <int> open-settings-tick;
    in-out property <bool> showing-settings;
    changed open-settings-tick => { root.showing-settings = true; }
    callback folder-watch-toggled(string, bool);
    callback folder-removed(string);
    in property <int> loop-count;
    in property <int> fade-seconds;

    // The track table's world. Rust owns sort and filter; the table only
    // reports which header or row was touched.
    in property <[TableRow]> table-rows;
    in property <[TableColumn]> table-columns;
    in property <[ColumnChoice]> table-column-choices;
    callback table-column-toggled(string);
    in property <int> table-sort-col;
    in property <bool> table-sort-asc;
    in-out property <string> table-filter;
    callback table-activated(int);
    callback table-sorted(int);
    callback table-filter-changed(string);
    callback table-rated(int, int);
    callback table-enqueued(int);
    callback table-play-next(int);
    callback table-add-to-playlist(int);
    in-out property <bool> picking-playlist;
    in property <string> pick-heading;
    callback playlist-picked(string);
    callback playlist-created-for-add(string);
    callback table-open-folder(int);
    callback table-pin-folder(int);
    callback table-column-moved(int, int);
    callback table-row-middle-clicked(int);
    callback table-column-resize-started(int);
    callback table-column-resized(int, float, float);
    callback table-column-resize-done();
    in property <[PinnedRow]> pinned-folders;
    /// The consoles with music, as sidebar rows: id in `id`, count in
    /// `subtitle` — PlaylistRow moonlights, the shape is identical.
    in property <[PlaylistRow]> sidebar-consoles;
    callback console-opened(string);
    callback console-played(string);
    in property <string> total-count;
    in property <string> faved-count;
    in property <string> now-stars;
    in-out property <bool> names-fix-lengths;
    in-out property <string> reclass-console-filter;
    callback reclass-console-filter-changed(string);
    /// Playlist drag-reorder state: source row, live pixel delta.
    in property <bool> cover-busy;
    property <int> pl-src: -1;
    property <length> pl-delta;
    property <bool> pl-drag-active: false;
    property <int> pl-drop: -1;
    /// Sidebar width, user-draggable like the old desktop (150–500px).
    in-out property <int> sidebar-width: 210;
    callback sidebar-resized(int);
    in property <string> scan-status;
    callback sidebar-play-all();
    callback playlist-played(string);
    callback folder-played(string);
    /// Click on the now-playing block: take me to that track.
    callback now-clicked();
    callback toggle-mute();
    callback toggle-crossfade();
    in property <int> cover-fit;
    callback stop-playback();
    callback rate-now(int);
    /// Which pinned folder narrows the table right now; "" means none.
    in property <string> table-folder-id;
    in property <string> table-scope-kind;
    callback console-opened-in-table(string);
    callback playlist-opened-in-table(string);
    callback table-remove-from-playlist(int);
    in property <string> table-scope-label;
    callback table-scope-cleared();
    callback folder-opened(string);
    callback folder-unpinned(string);
    callback folder-revealed(string);
    callback table-edit-requested(int);
    callback table-row-clicked(int, bool, bool);
    callback table-cursor-moved(int, bool);
    callback table-select-all();
    callback table-activate-cursor();
    in property <int> table-cursor: -1;
    in property <bool> meta-batch;
    // The metadata editor's state, owned by Rust like everything else.
    in-out property <bool> editing-metadata;
    in property <string> meta-heading;
    in property <string> meta-detail;
    in property <string> meta-tech;
    in-out property <string> meta-title;
    in-out property <string> meta-artist;
    in-out property <string> meta-album;
    in-out property <string> meta-track;
    callback metadata-accepted();
    callback metadata-cancelled();
    callback table-reclassify-requested(int);
    in-out property <bool> reclassifying;
    in property <string> reclass-heading;
    in property <[ConsoleOption]> consoles;
    in-out property <string> reclass-console;
    in-out property <string> reclass-game;
    in-out property <bool> reclass-scope-folder;
    in property <[string]> reclass-suggestions;
    callback reclass-game-edited(string);
    callback reclass-accepted();
    callback reclass-cancelled();
    callback table-cover-requested(int);
    callback cover-auto();
    in-out property <bool> covering;
    in property <string> cover-heading;
    in property <string> cover-status;
    in-out property <string> cover-query;
    in property <[CoverCandidate]> cover-candidates;
    callback cover-search(string);
    callback cover-chosen(int);
    callback table-names-requested(int);
    in-out property <bool> naming;
    in property <string> names-heading;
    in property <string> names-status;
    in property <[string]> names-rows;
    in property <bool> names-can-apply;
    callback names-apply();
    /// Whether the table is narrowed to rating > 0 — Rust's state, so the
    /// sidebar marks the entry that is actually in force.
    in property <bool> table-faved;
    callback table-faved-changed(bool);
    /// Fired when the table pane comes into existence, so Rust can build the
    /// model lazily — the phone never pays for a model it never shows.
    callback table-needed();

    callback library-activated(int);
    callback library-enqueued(int);
    callback library-enqueue-path(string, bool);
    callback library-play-path(string);
    callback library-reclassify-path(string);
    callback library-pin-path(string);
    callback library-reveal-path(string);
    callback library-mode-changed(int);
    callback library-grid-tapped(string);
    callback library-back();
    callback playlist-open-requested(string);
    callback playlist-enqueue-all();
    callback playlist-create(string);
    callback add-path-to-playlist(string, bool, string);
    callback add-path-to-new-playlist(string, bool, string);
    callback playlist-track-removed(string);
    callback playlist-reordered(int, int);
    callback playlist-rename(string, string);
    callback playlist-delete(string);
    callback playlist-enqueue-id(string);
    callback queue-activated(int);
    callback queue-removed(int);
    callback queue-reordered(int, int);
    callback queue-cleared();
    callback search-changed(string);
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback seek-to(int);
    callback set-volume(float);
    callback cycle-sleep();
    callback rescan();
    callback descargar-caratulas();
    callback add-folder();
    callback cycle-loops();
    callback cycle-fade();
    in property <int> short-filter-secs;
    callback cycle-short-filter();
    in property <int> crossfade-secs;
    callback cycle-crossfade();
    in property <string> output-label;
    in property <string> ui-mode-label;
    in property <string> update-status;
    callback check-update();
    in property <string> theme-label;
    callback cycle-theme();
    callback show-log();
    in-out property <bool> close-to-tray;
    callback toggle-close-to-tray();
    in property <string> mouse-buttons-label;
    in property <bool> mouse-buttons-on;
    callback toggle-mouse-buttons();
    in property <string> global-shortcuts-label;
    in property <bool> global-shortcuts-on;
    callback toggle-global-shortcuts();
    in property <string> tray-style-label;
    callback cycle-tray-style();
    in property <string> tray-click-label;
    callback cycle-tray-click();
    in property <bool> update-skippable;
    callback skip-update();
    in property <string> desktop-entry-label;
    callback make-desktop-entry();
    in property <string> add-files-label;
    callback add-files();
    in property <string> cover-fit-label;
    callback cycle-cover-fit();
    in property <string> clear-cache-label;
    callback clear-cover-cache();
    in property <string> undo-covers-label;
    callback undo-covers();
    in-out property <bool> continue-queue;
    callback toggle-continue-queue();
    in-out property <bool> resume-on-open;
    callback toggle-resume-on-open();
    in property <int> loop-max-mins;
    callback cycle-loop-max();
    in-out property <bool> slow-scan;
    callback toggle-slow-scan();
    in property <bool> dsp-mono-compensate;
    in property <bool> dsp-mono-phase;
    callback toggle-mono-compensate();
    callback toggle-mono-phase();
    callback cycle-output();
    callback cycle-ui-mode();
    in property <bool> eq-enabled;
    in property <float> eq-low;
    in property <float> eq-mid;
    in property <float> eq-high;
    in property <float> preamp-db;
    in property <bool> dsp-mono;
    in property <bool> dsp-limiter;
    callback toggle-eq();
    callback set-eq-band(int, float);
    callback set-preamp(float);
    callback toggle-mono();
    callback toggle-limiter();
    in property <float> dsp-balance;
    in property <float> dsp-width;
    callback set-balance(float);
    callback set-width(float);
    in property <string> rating-priority-label;
    callback cycle-rating-priority();

    // The one piece of state the shell owns: which pane the centre shows.
    // 0 = the track table · 1 = the phone's library views · 2 = settings.
    // Everything else lives in Rust, same as always.
    property <int> centre: 0;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // --- Sidebar ---
            Rectangle {
                width: root.sidebar-width * 1px;
                background: Theme.bg-secondary;

                VerticalLayout {
                    padding: Theme.gap;
                    spacing: 2px;

                    // The browse sections scroll as one — with the Consolas list and
                    // the cover, the fixed content outgrew the window and shoved the
                    // transport bar off the bottom. Ajustes and the cover stay pinned
                    // below, outside this Flickable.
                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: scroll-inner.preferred-height;
                        scroll-inner := VerticalLayout {
                            spacing: 2px;
                    Text {
                        text: "Biblioteca";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        height: 26px;
                        vertical-alignment: center;
                    }
                    SidebarEntry {
                        label: "Pistas";
                        count: root.total-count;
                        active: root.centre == 0 && !root.table-faved
                            && root.table-scope-kind == "";
                        clicked => {
                            root.centre = 0;
                            root.table-faved-changed(false);
                        }
                        played => { root.sidebar-play-all(); }
                    }
                    if root.show-faved: SidebarEntry {
                        label: "Favoritos";
                        count: root.faved-count;
                        active: root.centre == 0 && root.table-faved;
                        clicked => {
                            root.centre = 0;
                            root.table-faved-changed(true);
                        }
                    }
                    if root.show-files: SidebarEntry {
                        label: "Árbol";
                        active: root.centre == 1 && root.library-mode == 0;
                        clicked => { root.centre = 1; root.library-mode-changed(0); }
                    }
                    SidebarEntry {
                        label: "Discos";
                        active: root.centre == 1 && root.library-mode == 1;
                        clicked => { root.centre = 1; root.library-mode-changed(1); }
                    }
                    SidebarEntry {
                        label: "Consolas";
                        active: root.centre == 1 && root.library-mode == 2;
                        clicked => { root.centre = 1; root.library-mode-changed(2); }
                    }
                    SidebarEntry {
                        label: "Juegos";
                        active: root.centre == 1 && root.library-mode == 3;
                        clicked => { root.centre = 1; root.library-mode-changed(3); }
                    }
                    SidebarEntry {
                        label: "Listas";
                        active: root.centre == 1 && root.library-mode == 4;
                        clicked => { root.centre = 1; root.library-mode-changed(4); }
                    }

                    if root.show-folders && root.pinned-folders.length > 0: Rectangle { height: Theme.gap; }
                    if root.show-folders && root.pinned-folders.length > 0: Text {
                        text: "Carpetas";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        height: 26px;
                        vertical-alignment: center;
                    }
                    for pf in root.show-folders ? root.pinned-folders : []: Rectangle {
                        height: 34px;
                        background: root.centre == 0 && root.table-scope-kind == "folder"
                            && root.table-folder-id == pf.id
                            ? Theme.bg-selected
                            : (pft.has-hover ? Theme.bg-hover : transparent);
                        border-radius: 6px;
                        // Whole-row first so the unpin, declared after,
                        // stays clickable on top of it.
                        pft := TouchArea {
                            clicked => {
                                root.centre = 0;
                                root.folder-opened(pf.id);
                            }
                            double-clicked => { root.folder-played(pf.id); }
                        }
                        ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: "Reproducir";
                                    activated => { root.folder-played(pf.id); }
                                }
                                MenuItem {
                                    title: "Abrir en el gestor de archivos";
                                    activated => { root.folder-revealed(pf.id); }
                                }
                                MenuItem {
                                    title: "Quitar de aquí";
                                    activated => { root.folder-unpinned(pf.id); }
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            Text {
                                text: pf.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if (!pft.has-hover || !pf.removable) && pf.count != "": Text {
                                text: pf.count;
                                color: Theme.text-muted;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                            }
                            // The unpin, only under the pointer: a row of
                            // permanent ✕ reads as a warning, not a control.
                            if pft.has-hover && pf.removable: Rectangle {
                                width: 18px;
                                Text {
                                    text: "✕";
                                    color: pfx.has-hover ? Theme.text-primary : Theme.text-muted;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                                pfx := TouchArea {
                                    clicked => { root.folder-unpinned(pf.id); }
                                }
                            }
                        }
                    }

                    if root.show-consoles && root.sidebar-consoles.length > 0: Rectangle { height: Theme.gap; }
                    if root.show-consoles && root.sidebar-consoles.length > 0: Text {
                        text: "Consolas";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        height: 26px;
                        vertical-alignment: center;
                    }
                    for sc in root.show-consoles ? root.sidebar-consoles : []: Rectangle {
                        height: 34px;
                        border-radius: 6px;
                        background: root.centre == 0 && root.table-scope-kind == "console"
                            && root.table-folder-id == sc.id
                            ? Theme.bg-selected
                            : (sct.has-hover ? Theme.bg-hover : transparent);
                        sct := TouchArea {
                            clicked => {
                                root.centre = 0;
                                root.console-opened-in-table(sc.id);
                            }
                            double-clicked => { root.console-played(sc.id); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                ConsoleArt {
                                    width: 22px;
                                    height: 16px;
                                    console: sc.id;
                                }
                            }
                            Text {
                                text: sc.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: sc.subtitle;
                                color: Theme.text-muted;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                            }
                        }
                        ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: "Reproducir";
                                    activated => { root.console-played(sc.id); }
                                }
                                MenuItem {
                                    title: "Carátulas…";
                                    activated => { root.showing-settings = true; }
                                }
                            }
                        }
                    }

                    if root.show-playlists: Rectangle { height: Theme.gap; }
                    if root.show-playlists: HorizontalLayout {
                        height: 26px;
                        Text {
                            text: "Listas";
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        // "+" lands you where lists are born and managed.
                        Rectangle {
                            width: 22px;
                            border-radius: Theme.radius;
                            background: plnew.has-hover ? Theme.bg-hover : transparent;
                            Text {
                                text: "＋";
                                color: plnew.has-hover ? Theme.text-primary : Theme.text-muted;
                                font-size: Theme.font-small;
                            }
                            plnew := TouchArea {
                                clicked => {
                                    root.centre = 1;
                                    root.library-mode-changed(4);
                                }
                            }
                        }
                    }
                    // The playlists themselves, one tap from anywhere.
                    VerticalLayout {
                        for pl[pli] in root.show-playlists ? root.all-playlists : []: Rectangle {
                            height: 34px;
                            background: root.centre == 0 && root.table-scope-kind == "playlist"
                                && root.table-folder-id == pl.id
                                ? Theme.bg-selected
                                : (pt.has-hover ? Theme.bg-hover : transparent);
                            border-radius: 6px;
                            opacity: root.pl-drag-active && root.pl-src == pli ? 0.5 : 1.0;
                            border-width: root.pl-drag-active && root.pl-drop == pli
                                && root.pl-src != pli ? 2px : 0px;
                            border-color: Theme.accent;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text {
                                    text: pl.name;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: pl.subtitle;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                            }
                            pt := TouchArea {
                                moved => {
                                    if (root.pl-src == pli) {
                                        root.pl-delta = self.mouse-y - self.pressed-y;
                                        if (root.pl-delta > 17px || root.pl-delta < -17px) {
                                            root.pl-drag-active = true;
                                        }
                                        root.pl-drop = clamp(
                                            pli + round(root.pl-delta / 34px),
                                            0, root.all-playlists.length - 1);
                                    }
                                }
                                pointer-event(ev) => {
                                    if (ev.button == PointerEventButton.left) {
                                        if (ev.kind == PointerEventKind.down) {
                                            root.pl-src = pli;
                                            root.pl-drag-active = false;
                                            root.pl-drop = -1;
                                        }
                                        if (ev.kind == PointerEventKind.up
                                            && root.pl-drag-active
                                            && root.pl-drop >= 0
                                            && root.pl-drop != pli) {
                                            root.playlist-reordered(pli, root.pl-drop);
                                        }
                                    }
                                }
                                clicked => {
                                    if (root.pl-drag-active) {
                                        root.pl-drag-active = false;
                                        root.pl-src = -1;
                                        root.pl-drop = -1;
                                    } else {
                                        root.centre = 0;
                                        root.playlist-opened-in-table(pl.id);
                                    }
                                }
                                double-clicked => {
                                    if (!root.pl-drag-active) {
                                        root.playlist-played(pl.id);
                                    }
                                }
                            }
                            ContextMenuArea {
                                Menu {
                                    MenuItem {
                                        title: "Reproducir";
                                        activated => { root.playlist-played(pl.id); }
                                    }
                                    MenuItem {
                                        title: "Encolar todo";
                                        activated => { root.playlist-enqueue-id(pl.id); }
                                    }
                                    MenuItem {
                                        title: "Renombrar…";
                                        activated => {
                                            root.centre = 1;
                                            root.playlist-open-requested(pl.id);
                                        }
                                    }
                                    MenuItem {
                                        title: "Borrar";
                                        activated => { root.playlist-delete(pl.id); }
                                    }
                                }
                            }
                        }
                    }
                    }
                    }

                    // A rescan reports here, quietly, while the rest of the
                    // app stays usable — the old desktop's rule. (The phone
                    // still swaps screens; it has no corner to spare.)
                    if root.scan-status != "": Text {
                        text: root.scan-status;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    if root.show-cover && root.now-art.width == 0 && root.cover-busy: Text {
                        text: "buscando carátula…";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        horizontal-alignment: center;
                    }

                    // The old desktop gave its bottom-left corner to the
                    // playing cover; the 68px thumb in the transport was the
                    // one thing people missed most on the side-by-side.
                    if root.show-cover && root.now-art.width > 0: HorizontalLayout {
                        alignment: center;
                        padding-top: Theme.gap;
                        padding-bottom: Theme.gap;
                        Artwork {
                            side: 178px;
                            art: root.now-art;
                            fit: root.cover-fit;
                        }
                    }

                    SidebarEntry {
                        label: "Ajustes";
                        active: root.showing-settings;
                        clicked => { root.showing-settings = true; }
                    }
                }
            }

            // The seam doubles as the resize handle, like the old app's.
            Rectangle {
                width: 4px;
                background: sbh.has-hover || sbh.pressed ? Theme.accent : Theme.bg-tertiary;
                sbh := TouchArea {
                    mouse-cursor: ew-resize;
                    property <int> base;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            self.base = root.sidebar-width;
                        }
                        if (ev.kind == PointerEventKind.up) {
                            root.sidebar-resized(root.sidebar-width);
                        }
                    }
                    moved => {
                        root.sidebar-width = clamp(
                            self.base + (self.mouse-x - self.pressed-x) / 1px,
                            150, 500);
                    }
                }
            }

            // --- Centre: the table, the library views, or the settings ---
            Rectangle {
                horizontal-stretch: 1;

                if root.centre == 0: TrackTable {
                    init => { root.table-needed(); }
                    playlist-scope: root.table-scope-kind == "playlist";
                    remove-from-playlist(i) => { root.table-remove-from-playlist(i); }
                    scope-label: root.table-scope-label;
                    scope-cleared => { root.table-scope-cleared(); }
                    focus-filter-tick: root.focus-filter-tick;
                    rows: root.table-rows;
                    columns: root.table-columns;
                    column-choices: root.table-column-choices;
                    column-toggled(k) => { root.table-column-toggled(k); }
                    now-path: root.now-path;
                    sort-col: root.table-sort-col;
                    sort-asc: root.table-sort-asc;
                    filter <=> root.table-filter;
                    activated(i) => { root.table-activated(i); }
                    sorted(col) => { root.table-sorted(col); }
                    filter-changed(s) => { root.table-filter-changed(s); }
                    rated(i, stars) => { root.table-rated(i, stars); }
                    enqueued(i) => { root.table-enqueued(i); }
                    play-next(i) => { root.table-play-next(i); }
                    add-to-playlist(i) => { root.table-add-to-playlist(i); }
                    open-folder(i) => { root.table-open-folder(i); }
                    pin-folder(i) => { root.table-pin-folder(i); }
                    column-moved(de, a) => { root.table-column-moved(de, a); }
                    row-middle-clicked(i) => { root.table-row-middle-clicked(i); }
                    column-resize-started(i) => { root.table-column-resize-started(i); }
                    column-resized(i, dx, total) => { root.table-column-resized(i, dx, total); }
                    column-resize-done => { root.table-column-resize-done(); }
                    edit-requested(i) => { root.table-edit-requested(i); }
                    cursor: root.table-cursor;
                    row-clicked(i, c, sh) => { root.table-row-clicked(i, c, sh); }
                    cursor-moved(d, sh) => { root.table-cursor-moved(d, sh); }
                    select-all => { root.table-select-all(); }
                    activate-cursor => { root.table-activate-cursor(); }
                    reclassify-requested(i) => { root.table-reclassify-requested(i); }
                    cover-requested(i) => { root.table-cover-requested(i); }
                    names-requested(i) => { root.table-names-requested(i); }
                }

                if root.centre == 1: LibraryTab {
                    rows: root.library-rows;
                    total: root.library-total;
                    cramped: false;
                    now-path: root.now-path;
                    mode <=> root.library-mode;
                    mode-changed(i) => { root.library-mode-changed(i); }
                    grid-lines: root.library-grid-lines;
                    grid: root.library-grid;
                    columns: root.library-columns;
                    crumb: root.library-crumb;
                    grid-tapped(p) => { root.library-grid-tapped(p); }
                    go-back => { root.library-back(); }
                    autofocus-search: root.autofocus-search;
                    search <=> root.search;
                    activated(i) => { root.library-activated(i); }
                    enqueued(i) => { root.library-enqueued(i); }
                    enqueue-path(p, hondo) => { root.library-enqueue-path(p, hondo); }
                    play-path(p) => { root.library-play-path(p); }
                    reclassify-path(p) => { root.library-reclassify-path(p); }
                    pin-path(p) => { root.library-pin-path(p); }
                    reveal-path(p) => { root.library-reveal-path(p); }
                    search-changed(s) => { root.search-changed(s); }
                    playlists: root.playlists;
                    all-playlists: root.all-playlists;
                    showing-playlists: root.showing-playlists;
                    playlist-open: root.playlist-open;
                    playlist-count: root.playlist-count;
                    playlist-open-requested(id) => { root.playlist-open-requested(id); }
                    playlist-enqueue-all => { root.playlist-enqueue-all(); }
                    playlist-create(nombre) => { root.playlist-create(nombre); }
                    add-path-to-playlist(p, hondo, id) => {
                        root.add-path-to-playlist(p, hondo, id);
                    }
                    add-path-to-new-playlist(p, hondo, nombre) => {
                        root.add-path-to-new-playlist(p, hondo, nombre);
                    }
                    playlist-track-removed(p) => { root.playlist-track-removed(p); }
                    playlist-reordered(de, a) => { root.playlist-reordered(de, a); }
                    playlist-rename(id, nombre) => { root.playlist-rename(id, nombre); }
                    playlist-delete(id) => { root.playlist-delete(id); }
                    playlist-enqueue-id(id) => { root.playlist-enqueue-id(id); }
                }

            }

            // --- Right: the queue — only while it has something to say.
            //
            // The Tauri desktop's rule, kept on purpose: its Queued entry
            // existed only while the queue had items. A permanently
            // reserved column showing nothing reads as a rendering bug,
            // and an empty queue has nothing to teach anyone.
            if root.queue-rows.length > 0: Rectangle {
                width: 1px;
                background: Theme.bg-tertiary;
            }
            if root.queue-rows.length > 0: Rectangle {
                width: 300px;
                background: Theme.bg-primary;
                QueueTab {
                    rows: root.queue-rows;
                    activated(i) => { root.queue-activated(i); }
                    removed(i) => { root.queue-removed(i); }
                    reordered(from, to) => { root.queue-reordered(from, to); }
                    cleared => { root.queue-cleared(); }
                }
            }
        }

        // The output-warning banner, same rule as the phone shell: it has to
        // reach you wherever you are.
        if root.output-warning != "": Rectangle {
            height: 40px;
            background: Theme.warning-bg;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Text { text: "⚠"; color: Theme.warning-fg; vertical-alignment: center; }
                Text {
                    text: root.output-warning;
                    color: Theme.warning-fg;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // --- Transport bar ---
        Rectangle {
            height: 92px;
            background: Theme.bg-secondary;

            HorizontalLayout {
                padding: Theme.gap;
                spacing: Theme.gap * 1.5;

                VerticalLayout {
                    alignment: center;
                    Artwork {
                        side: 68px;
                        art: root.now-art;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 240px;
                        height: 68px;
                        background: npt.has-hover && root.now-title != "" ? Theme.bg-hover : transparent;
                        border-radius: Theme.radius;
                        npt := TouchArea {
                            clicked => {
                                if (root.now-title != "") {
                                    root.centre = 0;
                                    root.now-clicked();
                                }
                            }
                        }
                        TrackInfo {
                            title: root.now-title;
                            artist: root.now-artist;
                            album: root.now-album;
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        IconButton {
                            icon: @image-url("icons/shuffle.svg");
                            icon-size: 15px;
                            active: root.shuffle;
                            clicked => { root.toggle-shuffle(); }
                        }
                        IconButton {
                            icon: @image-url("icons/prev.svg");
                            icon-size: 18px;
                            clicked => { root.prev-track(); }
                        }
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 22px;
                            background: pta.has-hover ? Theme.accent-hover : Theme.accent;
                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 20px;
                                height: 20px;
                                source: root.playing
                                    ? @image-url("icons/pause.svg")
                                    : @image-url("icons/play.svg");
                                colorize: #ffffff;
                            }
                            pta := TouchArea { clicked => { root.toggle-play(); } }
                        }
                        IconButton {
                            icon: @image-url("icons/stop.svg");
                            icon-size: 16px;
                            clicked => { root.stop-playback(); }
                        }
                        IconButton {
                            icon: @image-url("icons/next.svg");
                            icon-size: 18px;
                            clicked => { root.next-track(); }
                        }
                        IconButton {
                            icon: @image-url("icons/repeat.svg");
                            icon-size: 16px;
                            active: root.repeat != 0;
                            badge: root.repeat == 2 ? "1" : "";
                            clicked => { root.cycle-repeat(); }
                        }
                        IconButton {
                            icon: @image-url("icons/fade.svg");
                            icon-size: 16px;
                            active: root.crossfade-secs > 0;
                            clicked => { root.toggle-crossfade(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: Fmt.mmss(root.position-ms);
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        SeekBar {
                            horizontal-stretch: 1;
                            height: 24px;
                            position-ms: root.position-ms;
                            duration-ms: root.duration-ms;
                            seek(ms) => { root.seek-to(ms); }
                        }
                        Text {
                            text: root.duration-ms > 0 ? Fmt.mmss(root.duration-ms) : "--:--";
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }
                }

                // Stars for what plays, the settings gear (the old bar's),
                // mute and the volume — one row, one baseline.
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        if root.now-title != "": Rectangle {
                            width: 96px;
                            height: 34px;
                            Text {
                                x: 0;
                                width: parent.width;
                                height: 100%;
                                text: root.now-stars;
                                color: Theme.accent;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    root.rate-now(clamp(
                                        floor(self.mouse-x / (parent.width / 5)) + 1,
                                        1, 5));
                                }
                            }
                        }
                        IconButton {
                            icon: @image-url("icons/settings.svg");
                            icon-size: 16px;
                            active: root.showing-settings;
                            clicked => { root.showing-settings = true; }
                        }
                        IconButton {
                            icon: root.volume <= 0.001
                                ? @image-url("icons/vol-mute.svg")
                                : (root.volume < 0.5
                                    ? @image-url("icons/vol-low.svg")
                                    : @image-url("icons/vol-high.svg"));
                            icon-size: 16px;
                            clicked => { root.toggle-mute(); }
                        }
                        VerticalLayout {
                            alignment: center;
                            VolumeBar {
                                width: 120px;
                                value: root.volume;
                                changed(v) => { root.set-volume(v); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.picking-playlist: PlaylistPickSheet {
        heading: root.pick-heading;
        playlists: root.all-playlists;
        picked(id) => { root.playlist-picked(id); }
        created(name) => { root.playlist-created-for-add(name); }
        cancelled => { root.picking-playlist = false; }
    }

    if root.naming: TrackNamesSheet {
        fix-lengths <=> root.names-fix-lengths;
        heading: root.names-heading;
        status: root.names-status;
        names: root.names-rows;
        can-apply: root.names-can-apply;
        apply => { root.names-apply(); }
        cancelled => { root.naming = false; }
    }

    if root.covering: CoverSheet {
        auto-download => { root.cover-auto(); }
        heading: root.cover-heading;
        status: root.cover-status;
        query <=> root.cover-query;
        candidates: root.cover-candidates;
        search(q) => { root.cover-search(q); }
        chosen(i) => { root.cover-chosen(i); }
        cancelled => { root.covering = false; }
    }

    if root.reclassifying: ReclassifySheet {
        console-filter <=> root.reclass-console-filter;
        console-filter-changed(t) => { root.reclass-console-filter-changed(t); }
        heading: root.reclass-heading;
        scope-folder <=> root.reclass-scope-folder;
        consoles: root.consoles;
        selected-console <=> root.reclass-console;
        game-text <=> root.reclass-game;
        suggestions: root.reclass-suggestions;
        game-edited(t) => { root.reclass-game-edited(t); }
        accepted => { root.reclass-accepted(); }
        cancelled => { root.reclass-cancelled(); }
    }

    if root.editing-metadata: MetadataSheet {
        heading: root.meta-heading;
        detail: root.meta-detail;
        tech: root.meta-tech;
        batch: root.meta-batch;
        title-text <=> root.meta-title;
        artist-text <=> root.meta-artist;
        album-text <=> root.meta-album;
        track-text <=> root.meta-track;
        accepted => { root.metadata-accepted(); }
        cancelled => { root.metadata-cancelled(); }
    }

    // Settings live in a standalone modal over the whole shell (the old
    // desktop dialog, not a pane). Rendered last so it sits on top.
                if root.showing-settings: DesktopSettings {
            close => { root.showing-settings = false; }
                    volume: root.volume;
                    sleep-running: root.sleep-running;
                    sleep-minutes: root.sleep-minutes;
                    library-summary: root.library-summary;
                    library-folders: root.library-folders;
                    vgm-loops-label: root.vgm-loops-label;
                    cycle-vgm-loops => { root.cycle-vgm-loops(); }
                    auto-covers: root.auto-covers;
                    toggle-auto-covers => { root.toggle-auto-covers(); }
                    covers-in-folder: root.covers-in-folder;
                    toggle-covers-in-folder => { root.toggle-covers-in-folder(); }
                    titlebar-track: root.titlebar-track;
                    toggle-titlebar-track => { root.toggle-titlebar-track(); }
                    album-game-label: root.album-game-label;
                    toggle-album-game => { root.toggle-album-game(); }
                    show-cover: root.show-cover;
                    toggle-show-cover => { root.toggle-show-cover(); }
                    show-faved: root.show-faved;
                    toggle-show-faved => { root.toggle-show-faved(); }
                    show-folders: root.show-folders;
                    toggle-show-folders => { root.toggle-show-folders(); }
                    show-playlists: root.show-playlists;
                    toggle-show-playlists => { root.toggle-show-playlists(); }
                    show-consoles: root.show-consoles;
                    toggle-show-consoles => { root.toggle-show-consoles(); }
                    show-files: root.show-files;
                    toggle-show-files => { root.toggle-show-files(); }
                    caps-all: root.caps-all;
                    toggle-caps-all => { root.toggle-caps-all(); }
                    reset-dsp => { root.reset-dsp(); }
                    theme-mode: root.theme-mode;
                    set-theme(m) => { root.set-theme(m); }
                    dsp-status: root.dsp-status;
                    auto-update: root.auto-update;
                    toggle-auto-update => { root.toggle-auto-update(); }
                    ask-update: root.ask-update;
                    toggle-ask-update => { root.toggle-ask-update(); }
                    mouse-back-label: root.mouse-back-label;
                    mouse-forward-label: root.mouse-forward-label;
                    mouse-side-label: root.mouse-side-label;
                    mouse-extra-label: root.mouse-extra-label;
                    cycle-mouse-action(b) => { root.cycle-mouse-action(b); }
                    about-label: root.about-label;
                    open-repo => { root.open-repo(); }
                    shortcut-rows: root.shortcut-rows;
                    shortcut-capture(id) => { root.shortcut-capture(id); }
                    folder-watch-toggled(id, on) => { root.folder-watch-toggled(id, on); }
                    folder-removed(id) => { root.folder-removed(id); }
                    loop-count: root.loop-count;
                    fade-seconds: root.fade-seconds;
                    set-volume(v) => { root.set-volume(v); }
                    cycle-sleep => { root.cycle-sleep(); }
                    rescan => { root.rescan(); }
                    descargar-caratulas => { root.descargar-caratulas(); }
                    add-folder => { root.add-folder(); }
                    cycle-loops => { root.cycle-loops(); }
                    cycle-fade => { root.cycle-fade(); }
                    short-filter-secs: root.short-filter-secs;
                    cycle-short-filter => { root.cycle-short-filter(); }
                    crossfade-secs: root.crossfade-secs;
                    cycle-crossfade => { root.cycle-crossfade(); }
                    output-label: root.output-label;
                    ui-mode-label: root.ui-mode-label;
                    cycle-output => { root.cycle-output(); }
                    cycle-ui-mode => { root.cycle-ui-mode(); }
                    update-status: root.update-status;
                    check-update => { root.check-update(); }
                    theme-label: root.theme-label;
                    cycle-theme => { root.cycle-theme(); }
                    show-log => { root.show-log(); }
                    close-to-tray <=> root.close-to-tray;
                    toggle-close-to-tray => { root.toggle-close-to-tray(); }
                    mouse-buttons-label: root.mouse-buttons-label;
                    mouse-buttons-on: root.mouse-buttons-on;
                    toggle-mouse-buttons => { root.toggle-mouse-buttons(); }
                    global-shortcuts-label: root.global-shortcuts-label;
                    global-shortcuts-on: root.global-shortcuts-on;
                    toggle-global-shortcuts => { root.toggle-global-shortcuts(); }
                    tray-style-label: root.tray-style-label;
                    cycle-tray-style => { root.cycle-tray-style(); }
                    tray-click-label: root.tray-click-label;
                    cycle-tray-click => { root.cycle-tray-click(); }
                    update-skippable: root.update-skippable;
                    skip-update => { root.skip-update(); }
                    desktop-entry-label: root.desktop-entry-label;
                    make-desktop-entry => { root.make-desktop-entry(); }
                    add-files-label: root.add-files-label;
                    add-files => { root.add-files(); }
                    cover-fit-label: root.cover-fit-label;
                    cycle-cover-fit => { root.cycle-cover-fit(); }
                    clear-cache-label: root.clear-cache-label;
                    clear-cover-cache => { root.clear-cover-cache(); }
                    undo-covers-label: root.undo-covers-label;
                    undo-covers => { root.undo-covers(); }
                    continue-queue <=> root.continue-queue;
                    toggle-continue-queue => { root.toggle-continue-queue(); }
                    resume-on-open <=> root.resume-on-open;
                    toggle-resume-on-open => { root.toggle-resume-on-open(); }
                    loop-max-mins: root.loop-max-mins;
                    cycle-loop-max => { root.cycle-loop-max(); }
                    slow-scan <=> root.slow-scan;
                    toggle-slow-scan => { root.toggle-slow-scan(); }
                    dsp-mono-compensate: root.dsp-mono-compensate;
                    dsp-mono-phase: root.dsp-mono-phase;
                    toggle-mono-compensate => { root.toggle-mono-compensate(); }
                    toggle-mono-phase => { root.toggle-mono-phase(); }
                    eq-enabled: root.eq-enabled;
                    eq-low: root.eq-low;
                    eq-mid: root.eq-mid;
                    eq-high: root.eq-high;
                    preamp-db: root.preamp-db;
                    dsp-mono: root.dsp-mono;
                    dsp-limiter: root.dsp-limiter;
                    toggle-eq => { root.toggle-eq(); }
                    set-eq-band(b, v) => { root.set-eq-band(b, v); }
                    set-preamp(v) => { root.set-preamp(v); }
                    toggle-mono => { root.toggle-mono(); }
                    toggle-limiter => { root.toggle-limiter(); }
                    dsp-balance: root.dsp-balance;
                    dsp-width: root.dsp-width;
                    set-balance(v) => { root.set-balance(v); }
                    set-width(v) => { root.set-width(v); }
                    rating-priority-label: root.rating-priority-label;
                    cycle-rating-priority => { root.cycle-rating-priority(); }
                }
}
