// The desktop shell: sidebar | library | queue, over one transport bar.
//
// Fase 2 of docs/plan-desktop-slint.md. Deliberately built from the same
// screens the phone uses — LibraryTab, QueueTab and SettingsTab are
// instantiated whole, fed by the same models and firing the same callbacks,
// so there is exactly one implementation of every behaviour and the shell is
// only a different arrangement of it. The wide track table of fase 3b will
// replace the centre pane; until then the phone's list *is* the library view.

import { ListView } from "std-widgets.slint";
import { Theme, Fmt } from "theme.slint";
import { ColumnChoice, ConsoleOption, CoverCandidate, GridLine, LibraryRow, QueueRow, PlaylistRow, TableColumn, TableRow, PinnedRow } from "types.slint";
import { Artwork, TrackInfo, RoundButton, SeekBar, MetadataSheet, ReclassifySheet, CoverSheet, PlaylistPickSheet, TrackNamesSheet } from "widgets.slint";
import { LibraryTab, QueueTab, SettingsTab } from "tabs.slint";
import { TrackTable } from "table.slint";

component SidebarEntry inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 34px;
    background: root.active ? Theme.bg-selected : (t.has-hover ? Theme.bg-hover : transparent);
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.text-primary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    t := TouchArea { clicked => { root.clicked(); } }
}

// A horizontal 0..1 slider in the house style, for the volume.
component VolumeBar inherits Rectangle {
    in property <float> value;
    callback changed(float);

    height: 24px;

    track := Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.bg-tertiary;

        Rectangle {
            x: 0;
            width: parent.width * clamp(root.value, 0.0, 1.0);
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.accent;
        }
    }
    Rectangle {
        x: track.width * clamp(root.value, 0.0, 1.0) - self.width / 2;
        width: touch.pressed ? 14px : 10px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.accent;
        animate width { duration: 90ms; }
    }
    touch := TouchArea {
        moved => { root.changed(clamp(self.mouse-x / track.width, 0.0, 1.0)); }
        clicked => { root.changed(clamp(self.mouse-x / track.width, 0.0, 1.0)); }
    }
}

export component DesktopShell inherits Rectangle {
    background: Theme.bg-primary;

    // --- Mirrors of AppWindow's state, wired straight through ---
    in property <[LibraryRow]> library-rows;
    in property <int> library-total;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <string> now-path;
    in property <image> now-art;
    in-out property <bool> playing;
    in-out property <bool> shuffle;
    in-out property <int> repeat;
    in property <int> position-ms;
    in property <int> duration-ms;
    in-out property <float> volume;
    in-out property <string> search;
    in property <bool> autofocus-search;
    in-out property <int> library-mode;
    in property <[GridLine]> library-grid-lines;
    in property <bool> library-grid;
    in property <string> library-crumb;
    in property <int> library-columns;
    in property <[QueueRow]> queue-rows;
    in property <[PlaylistRow]> playlists;
    in property <[PlaylistRow]> all-playlists;
    in property <bool> showing-playlists;
    in property <bool> playlist-open;
    in property <int> playlist-count;
    in property <string> output-warning;
    in property <bool> sleep-running;
    in property <int> sleep-minutes;
    in property <string> library-summary;
    in property <int> loop-count;
    in property <int> fade-seconds;

    // The track table's world. Rust owns sort and filter; the table only
    // reports which header or row was touched.
    in property <[TableRow]> table-rows;
    in property <[TableColumn]> table-columns;
    in property <[ColumnChoice]> table-column-choices;
    callback table-column-toggled(string);
    in property <int> table-sort-col;
    in property <bool> table-sort-asc;
    in-out property <string> table-filter;
    callback table-activated(int);
    callback table-sorted(int);
    callback table-filter-changed(string);
    callback table-rated(int, int);
    callback table-enqueued(int);
    callback table-play-next(int);
    callback table-add-to-playlist(int);
    in-out property <bool> picking-playlist;
    in property <string> pick-heading;
    callback playlist-picked(string);
    callback playlist-created-for-add(string);
    callback table-open-folder(int);
    callback table-pin-folder(int);
    in property <[PinnedRow]> pinned-folders;
    /// Which pinned folder narrows the table right now; "" means none.
    in property <string> table-folder-id;
    callback folder-opened(string);
    callback folder-unpinned(string);
    callback table-edit-requested(int);
    callback table-row-clicked(int, bool, bool);
    callback table-cursor-moved(int, bool);
    callback table-select-all();
    callback table-activate-cursor();
    in property <int> table-cursor: -1;
    in property <bool> meta-batch;
    // The metadata editor's state, owned by Rust like everything else.
    in-out property <bool> editing-metadata;
    in property <string> meta-heading;
    in property <string> meta-detail;
    in-out property <string> meta-title;
    in-out property <string> meta-artist;
    in-out property <string> meta-album;
    in-out property <string> meta-track;
    callback metadata-accepted();
    callback metadata-cancelled();
    callback table-reclassify-requested(int);
    in-out property <bool> reclassifying;
    in property <string> reclass-heading;
    in property <[ConsoleOption]> consoles;
    in-out property <string> reclass-console;
    in-out property <string> reclass-game;
    in-out property <bool> reclass-scope-folder;
    in property <[string]> reclass-suggestions;
    callback reclass-game-edited(string);
    callback reclass-accepted();
    callback reclass-cancelled();
    callback table-cover-requested(int);
    in-out property <bool> covering;
    in property <string> cover-heading;
    in property <string> cover-status;
    in-out property <string> cover-query;
    in property <[CoverCandidate]> cover-candidates;
    callback cover-search(string);
    callback cover-chosen(int);
    callback table-names-requested(int);
    in-out property <bool> naming;
    in property <string> names-heading;
    in property <string> names-status;
    in property <[string]> names-rows;
    in property <bool> names-can-apply;
    callback names-apply();
    /// Whether the table is narrowed to rating > 0 — Rust's state, so the
    /// sidebar marks the entry that is actually in force.
    in property <bool> table-faved;
    callback table-faved-changed(bool);
    /// Fired when the table pane comes into existence, so Rust can build the
    /// model lazily — the phone never pays for a model it never shows.
    callback table-needed();

    callback library-activated(int);
    callback library-enqueued(int);
    callback library-enqueue-path(string, bool);
    callback library-mode-changed(int);
    callback library-grid-tapped(string);
    callback library-back();
    callback playlist-open-requested(string);
    callback playlist-enqueue-all();
    callback playlist-create(string);
    callback add-path-to-playlist(string, bool, string);
    callback add-path-to-new-playlist(string, bool, string);
    callback playlist-track-removed(string);
    callback playlist-reordered(int, int);
    callback playlist-rename(string, string);
    callback playlist-delete(string);
    callback playlist-enqueue-id(string);
    callback queue-activated(int);
    callback queue-removed(int);
    callback queue-reordered(int, int);
    callback queue-cleared();
    callback search-changed(string);
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback seek-to(int);
    callback set-volume(float);
    callback cycle-sleep();
    callback rescan();
    callback descargar-caratulas();
    callback add-folder();
    callback cycle-loops();
    callback cycle-fade();
    in property <int> short-filter-secs;
    callback cycle-short-filter();
    in property <int> crossfade-secs;
    callback cycle-crossfade();
    in property <string> output-label;
    in property <string> ui-mode-label;
    in property <string> update-status;
    callback check-update();
    in property <string> theme-label;
    callback cycle-theme();
    callback show-log();
    in-out property <bool> close-to-tray;
    callback toggle-close-to-tray();
    in property <string> mouse-buttons-label;
    in property <bool> mouse-buttons-on;
    callback toggle-mouse-buttons();
    in property <string> global-shortcuts-label;
    in property <bool> global-shortcuts-on;
    callback toggle-global-shortcuts();
    in property <bool> update-skippable;
    callback skip-update();
    in property <string> desktop-entry-label;
    callback make-desktop-entry();
    in property <string> add-files-label;
    callback add-files();
    in property <string> cover-fit-label;
    callback cycle-cover-fit();
    in property <string> clear-cache-label;
    callback clear-cover-cache();
    in property <string> undo-covers-label;
    callback undo-covers();
    in-out property <bool> continue-queue;
    callback toggle-continue-queue();
    in property <int> loop-max-mins;
    callback cycle-loop-max();
    in-out property <bool> slow-scan;
    callback toggle-slow-scan();
    in property <bool> dsp-mono-compensate;
    in property <bool> dsp-mono-phase;
    callback toggle-mono-compensate();
    callback toggle-mono-phase();
    callback cycle-output();
    callback cycle-ui-mode();
    in property <bool> eq-enabled;
    in property <float> eq-low;
    in property <float> eq-mid;
    in property <float> eq-high;
    in property <float> preamp-db;
    in property <bool> dsp-mono;
    in property <bool> dsp-limiter;
    callback toggle-eq();
    callback set-eq-band(int, float);
    callback set-preamp(float);
    callback toggle-mono();
    callback toggle-limiter();
    in property <float> dsp-balance;
    in property <float> dsp-width;
    callback set-balance(float);
    callback set-width(float);
    in property <string> rating-priority-label;
    callback cycle-rating-priority();

    // The one piece of state the shell owns: which pane the centre shows.
    // 0 = the track table · 1 = the phone's library views · 2 = settings.
    // Everything else lives in Rust, same as always.
    property <int> centre: 0;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // --- Sidebar ---
            Rectangle {
                width: 210px;
                background: Theme.bg-secondary;

                VerticalLayout {
                    padding: Theme.gap;
                    spacing: 2px;

                    Text {
                        text: "Biblioteca";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        height: 26px;
                        vertical-alignment: center;
                    }
                    SidebarEntry {
                        label: "Pistas";
                        active: root.centre == 0 && !root.table-faved;
                        clicked => {
                            root.centre = 0;
                            root.table-faved-changed(false);
                        }
                    }
                    SidebarEntry {
                        label: "Favoritos";
                        active: root.centre == 0 && root.table-faved;
                        clicked => {
                            root.centre = 0;
                            root.table-faved-changed(true);
                        }
                    }
                    for label[i] in ["Árbol", "Discos", "Consolas", "Juegos", "Listas"]: SidebarEntry {
                        label: label;
                        active: root.centre == 1 && root.library-mode == i;
                        clicked => {
                            root.centre = 1;
                            root.library-mode-changed(i);
                        }
                    }

                    if root.pinned-folders.length > 0: Rectangle { height: Theme.gap; }
                    if root.pinned-folders.length > 0: Text {
                        text: "Carpetas";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        height: 26px;
                        vertical-alignment: center;
                    }
                    for pf in root.pinned-folders: Rectangle {
                        height: 34px;
                        background: root.centre == 0 && root.table-folder-id == pf.id
                            ? Theme.bg-selected
                            : (pft.has-hover ? Theme.bg-hover : transparent);
                        border-radius: 6px;
                        // Whole-row first so the unpin, declared after,
                        // stays clickable on top of it.
                        pft := TouchArea {
                            clicked => {
                                root.centre = 0;
                                root.folder-opened(pf.id);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            Text {
                                text: pf.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            // The unpin, only under the pointer: a row of
                            // permanent ✕ reads as a warning, not a control.
                            if pft.has-hover: Rectangle {
                                width: 18px;
                                Text {
                                    text: "✕";
                                    color: pfx.has-hover ? Theme.text-primary : Theme.text-muted;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                                pfx := TouchArea {
                                    clicked => { root.folder-unpinned(pf.id); }
                                }
                            }
                        }
                    }

                    Rectangle { height: Theme.gap; }
                    Text {
                        text: "Listas";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        height: 26px;
                        vertical-alignment: center;
                    }
                    // The playlists themselves, one tap from anywhere.
                    lists := ListView {
                        vertical-stretch: 1;
                        for pl in root.all-playlists: Rectangle {
                            height: 34px;
                            background: pt.has-hover ? Theme.bg-hover : transparent;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                Text {
                                    text: pl.name;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            pt := TouchArea {
                                clicked => {
                                    root.centre = 1;
                                    root.playlist-open-requested(pl.id);
                                }
                            }
                        }
                    }

                    SidebarEntry {
                        label: "Ajustes";
                        active: root.centre == 2;
                        clicked => { root.centre = 2; }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.bg-tertiary; }

            // --- Centre: the table, the library views, or the settings ---
            Rectangle {
                horizontal-stretch: 1;

                if root.centre == 0: TrackTable {
                    init => { root.table-needed(); }
                    rows: root.table-rows;
                    columns: root.table-columns;
                    column-choices: root.table-column-choices;
                    column-toggled(k) => { root.table-column-toggled(k); }
                    now-path: root.now-path;
                    sort-col: root.table-sort-col;
                    sort-asc: root.table-sort-asc;
                    filter <=> root.table-filter;
                    activated(i) => { root.table-activated(i); }
                    sorted(col) => { root.table-sorted(col); }
                    filter-changed(s) => { root.table-filter-changed(s); }
                    rated(i, stars) => { root.table-rated(i, stars); }
                    enqueued(i) => { root.table-enqueued(i); }
                    play-next(i) => { root.table-play-next(i); }
                    add-to-playlist(i) => { root.table-add-to-playlist(i); }
                    open-folder(i) => { root.table-open-folder(i); }
                    pin-folder(i) => { root.table-pin-folder(i); }
                    edit-requested(i) => { root.table-edit-requested(i); }
                    cursor: root.table-cursor;
                    row-clicked(i, c, sh) => { root.table-row-clicked(i, c, sh); }
                    cursor-moved(d, sh) => { root.table-cursor-moved(d, sh); }
                    select-all => { root.table-select-all(); }
                    activate-cursor => { root.table-activate-cursor(); }
                    reclassify-requested(i) => { root.table-reclassify-requested(i); }
                    cover-requested(i) => { root.table-cover-requested(i); }
                    names-requested(i) => { root.table-names-requested(i); }
                }

                if root.centre == 1: LibraryTab {
                    rows: root.library-rows;
                    total: root.library-total;
                    cramped: false;
                    now-path: root.now-path;
                    mode <=> root.library-mode;
                    mode-changed(i) => { root.library-mode-changed(i); }
                    grid-lines: root.library-grid-lines;
                    grid: root.library-grid;
                    columns: root.library-columns;
                    crumb: root.library-crumb;
                    grid-tapped(p) => { root.library-grid-tapped(p); }
                    go-back => { root.library-back(); }
                    autofocus-search: root.autofocus-search;
                    search <=> root.search;
                    activated(i) => { root.library-activated(i); }
                    enqueued(i) => { root.library-enqueued(i); }
                    enqueue-path(p, hondo) => { root.library-enqueue-path(p, hondo); }
                    search-changed(s) => { root.search-changed(s); }
                    playlists: root.playlists;
                    all-playlists: root.all-playlists;
                    showing-playlists: root.showing-playlists;
                    playlist-open: root.playlist-open;
                    playlist-count: root.playlist-count;
                    playlist-open-requested(id) => { root.playlist-open-requested(id); }
                    playlist-enqueue-all => { root.playlist-enqueue-all(); }
                    playlist-create(nombre) => { root.playlist-create(nombre); }
                    add-path-to-playlist(p, hondo, id) => {
                        root.add-path-to-playlist(p, hondo, id);
                    }
                    add-path-to-new-playlist(p, hondo, nombre) => {
                        root.add-path-to-new-playlist(p, hondo, nombre);
                    }
                    playlist-track-removed(p) => { root.playlist-track-removed(p); }
                    playlist-reordered(de, a) => { root.playlist-reordered(de, a); }
                    playlist-rename(id, nombre) => { root.playlist-rename(id, nombre); }
                    playlist-delete(id) => { root.playlist-delete(id); }
                    playlist-enqueue-id(id) => { root.playlist-enqueue-id(id); }
                }

                if root.centre == 2: SettingsTab {
                    volume: root.volume;
                    sleep-running: root.sleep-running;
                    sleep-minutes: root.sleep-minutes;
                    library-summary: root.library-summary;
                    loop-count: root.loop-count;
                    fade-seconds: root.fade-seconds;
                    set-volume(v) => { root.set-volume(v); }
                    cycle-sleep => { root.cycle-sleep(); }
                    rescan => { root.rescan(); }
                    descargar-caratulas => { root.descargar-caratulas(); }
                    add-folder => { root.add-folder(); }
                    cycle-loops => { root.cycle-loops(); }
                    cycle-fade => { root.cycle-fade(); }
                    short-filter-secs: root.short-filter-secs;
                    cycle-short-filter => { root.cycle-short-filter(); }
                    crossfade-secs: root.crossfade-secs;
                    cycle-crossfade => { root.cycle-crossfade(); }
                    output-label: root.output-label;
                    ui-mode-label: root.ui-mode-label;
                    cycle-output => { root.cycle-output(); }
                    cycle-ui-mode => { root.cycle-ui-mode(); }
                    update-status: root.update-status;
                    check-update => { root.check-update(); }
                    theme-label: root.theme-label;
                    cycle-theme => { root.cycle-theme(); }
                    show-log => { root.show-log(); }
                    close-to-tray <=> root.close-to-tray;
                    toggle-close-to-tray => { root.toggle-close-to-tray(); }
                    mouse-buttons-label: root.mouse-buttons-label;
                    mouse-buttons-on: root.mouse-buttons-on;
                    toggle-mouse-buttons => { root.toggle-mouse-buttons(); }
                    global-shortcuts-label: root.global-shortcuts-label;
                    global-shortcuts-on: root.global-shortcuts-on;
                    toggle-global-shortcuts => { root.toggle-global-shortcuts(); }
                    update-skippable: root.update-skippable;
                    skip-update => { root.skip-update(); }
                    desktop-entry-label: root.desktop-entry-label;
                    make-desktop-entry => { root.make-desktop-entry(); }
                    add-files-label: root.add-files-label;
                    add-files => { root.add-files(); }
                    cover-fit-label: root.cover-fit-label;
                    cycle-cover-fit => { root.cycle-cover-fit(); }
                    clear-cache-label: root.clear-cache-label;
                    clear-cover-cache => { root.clear-cover-cache(); }
                    undo-covers-label: root.undo-covers-label;
                    undo-covers => { root.undo-covers(); }
                    continue-queue <=> root.continue-queue;
                    toggle-continue-queue => { root.toggle-continue-queue(); }
                    loop-max-mins: root.loop-max-mins;
                    cycle-loop-max => { root.cycle-loop-max(); }
                    slow-scan <=> root.slow-scan;
                    toggle-slow-scan => { root.toggle-slow-scan(); }
                    dsp-mono-compensate: root.dsp-mono-compensate;
                    dsp-mono-phase: root.dsp-mono-phase;
                    toggle-mono-compensate => { root.toggle-mono-compensate(); }
                    toggle-mono-phase => { root.toggle-mono-phase(); }
                    eq-enabled: root.eq-enabled;
                    eq-low: root.eq-low;
                    eq-mid: root.eq-mid;
                    eq-high: root.eq-high;
                    preamp-db: root.preamp-db;
                    dsp-mono: root.dsp-mono;
                    dsp-limiter: root.dsp-limiter;
                    toggle-eq => { root.toggle-eq(); }
                    set-eq-band(b, v) => { root.set-eq-band(b, v); }
                    set-preamp(v) => { root.set-preamp(v); }
                    toggle-mono => { root.toggle-mono(); }
                    toggle-limiter => { root.toggle-limiter(); }
                    dsp-balance: root.dsp-balance;
                    dsp-width: root.dsp-width;
                    set-balance(v) => { root.set-balance(v); }
                    set-width(v) => { root.set-width(v); }
                    rating-priority-label: root.rating-priority-label;
                    cycle-rating-priority => { root.cycle-rating-priority(); }
                }
            }

            Rectangle { width: 1px; background: Theme.bg-tertiary; }

            // --- Right: the queue, always in sight ---
            Rectangle {
                width: 300px;
                background: Theme.bg-primary;
                QueueTab {
                    rows: root.queue-rows;
                    activated(i) => { root.queue-activated(i); }
                    removed(i) => { root.queue-removed(i); }
                    reordered(from, to) => { root.queue-reordered(from, to); }
                    cleared => { root.queue-cleared(); }
                }
            }
        }

        // The output-warning banner, same rule as the phone shell: it has to
        // reach you wherever you are.
        if root.output-warning != "": Rectangle {
            height: 40px;
            background: Theme.warning-bg;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Text { text: "⚠"; color: Theme.warning-fg; vertical-alignment: center; }
                Text {
                    text: root.output-warning;
                    color: Theme.warning-fg;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // --- Transport bar ---
        Rectangle {
            height: 92px;
            background: Theme.bg-secondary;

            HorizontalLayout {
                padding: Theme.gap;
                spacing: Theme.gap * 1.5;

                Artwork {
                    width: 68px;
                    height: 68px;
                    art: root.now-art;
                }

                Rectangle {
                    width: 240px;
                    TrackInfo {
                        title: root.now-title;
                        artist: root.now-artist;
                        album: root.now-album;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: Theme.gap * 2;

                        RoundButton {
                            glyph: "⤨";
                            active: root.shuffle;
                            size: 36px;
                            clicked => { root.toggle-shuffle(); }
                        }
                        RoundButton {
                            glyph: "◀◀";
                            size: 40px;
                            clicked => { root.prev-track(); }
                        }
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 22px;
                            background: Theme.accent;
                            Text {
                                text: root.playing ? "❚❚" : "▶";
                                color: #ffffff;
                                font-size: 15px;
                            }
                            TouchArea { clicked => { root.toggle-play(); } }
                        }
                        RoundButton {
                            glyph: "▶▶";
                            size: 40px;
                            clicked => { root.next-track(); }
                        }
                        RoundButton {
                            glyph: root.repeat == 2 ? "↻¹" : "↻";
                            active: root.repeat != 0;
                            size: 36px;
                            clicked => { root.cycle-repeat(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: Fmt.mmss(root.position-ms);
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        SeekBar {
                            horizontal-stretch: 1;
                            height: 24px;
                            position-ms: root.position-ms;
                            duration-ms: root.duration-ms;
                            seek(ms) => { root.seek-to(ms); }
                        }
                        Text {
                            text: root.duration-ms > 0 ? Fmt.mmss(root.duration-ms) : "--:--";
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    width: 170px;
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: "🔊";
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    VolumeBar {
                        width: 130px;
                        value: root.volume;
                        changed(v) => { root.set-volume(v); }
                    }
                }
            }
        }
    }

    if root.picking-playlist: PlaylistPickSheet {
        heading: root.pick-heading;
        playlists: root.all-playlists;
        picked(id) => { root.playlist-picked(id); }
        created(name) => { root.playlist-created-for-add(name); }
        cancelled => { root.picking-playlist = false; }
    }

    if root.naming: TrackNamesSheet {
        heading: root.names-heading;
        status: root.names-status;
        names: root.names-rows;
        can-apply: root.names-can-apply;
        apply => { root.names-apply(); }
        cancelled => { root.naming = false; }
    }

    if root.covering: CoverSheet {
        heading: root.cover-heading;
        status: root.cover-status;
        query <=> root.cover-query;
        candidates: root.cover-candidates;
        search(q) => { root.cover-search(q); }
        chosen(i) => { root.cover-chosen(i); }
        cancelled => { root.covering = false; }
    }

    if root.reclassifying: ReclassifySheet {
        heading: root.reclass-heading;
        scope-folder <=> root.reclass-scope-folder;
        consoles: root.consoles;
        selected-console <=> root.reclass-console;
        game-text <=> root.reclass-game;
        suggestions: root.reclass-suggestions;
        game-edited(t) => { root.reclass-game-edited(t); }
        accepted => { root.reclass-accepted(); }
        cancelled => { root.reclass-cancelled(); }
    }

    if root.editing-metadata: MetadataSheet {
        heading: root.meta-heading;
        detail: root.meta-detail;
        batch: root.meta-batch;
        title-text <=> root.meta-title;
        artist-text <=> root.meta-artist;
        album-text <=> root.meta-album;
        track-text <=> root.meta-track;
        accepted => { root.metadata-accepted(); }
        cancelled => { root.metadata-cancelled(); }
    }
}
