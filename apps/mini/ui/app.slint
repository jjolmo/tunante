// The tunante-mini shell: three tabs, a mini-player, and a switcher that moves
// to a side rail when the phone is turned.
//
// Deliberately built out of primitives (Rectangle, Text, TextInput, TouchArea)
// rather than std-widgets, so the look is Tunante's own and not whichever style
// Slint picks up from the host. The one exception is ListView, which is imported
// for its virtualization — it only instantiates the rows that are visible, which
// is what lets the library tab hold a hundred thousand entries without the
// memory blowing up.


import { Theme, Fmt } from "theme.slint";
import { TabSwitcher, MiniPlayer } from "widgets.slint";
import { NowPlayingTab, QueueTab, SettingsTab, LibraryTab } from "tabs.slint";
import { FolderPicker } from "picker.slint";
import { DesktopShell } from "desktop.slint";

// Imported for AppWindow's own properties, and re-exported so
// `slint::include_modules!()` keeps generating the same Rust types it always
// has, wherever the structs live now.
import { ConsoleOption, CoverCandidate, GridCell, GridLine, LibraryRow, QueueRow, PlaylistRow, FolderEntry, TableRow } from "types.slint";
export { ConsoleOption, CoverCandidate, GridCell, GridLine, LibraryRow, QueueRow, PlaylistRow, FolderEntry, TableRow }

export component AppWindow inherits Window {
    title: "Tunante";
    background: Theme.bg-primary;
    // A sensible size for development — phone-shaped, unless the desktop shell
    // was forced from the command line before the window mapped. On the phone
    // the compositor makes it fullscreen and this is ignored.
    preferred-width: root.ui-mode == 2 ? 1400px : 400px;
    preferred-height: root.ui-mode == 2 ? 850px : 800px;

    in property <[LibraryRow]> library-rows;
    in property <[QueueRow]> queue-rows;
    in property <string> now-title: "Nothing playing";
    in property <string> now-artist;
    in property <string> now-album;
    in property <int> library-total;
    in-out property <int> tab: 0;
    in-out property <bool> playing: false;
    in-out property <string> search;
    in property <bool> autofocus-search;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <image> now-art;
    // The path of the track playing, so a row can recognise itself. Cheaper and
    // steadier than marking rows in Rust: `to_ui_rows` is called from five
    // places and none of them would know when the track changed underneath.
    in property <string> now-path;
    in-out property <bool> shuffle;
    // 0 off · 1 all · 2 one
    in-out property <int> repeat;

    in-out property <float> volume: 1.0;
    in property <bool> sleep-running;
    in property <int> sleep-minutes;
    in property <string> library-summary;
    // Empty unless the sound has nowhere to go. See output.rs.
    in property <string> output-warning;
    in property <int> loop-count: 2;
    in property <int> fade-seconds: 8;

    // First run: no folders chosen yet, so the picker replaces the whole shell.
    in-out property <bool> setup-mode;
    in property <[FolderEntry]> picker-entries;
    in property <string> picker-path;
    in property <int> picker-chosen;
    in property <string> scan-status;

    callback picker-enter(int);
    callback picker-toggle(int);
    callback picker-up();
    callback picker-done();

    callback library-activated(int);
    callback library-enqueued(int);
    callback library-enqueue-path(string, bool);
    in-out property <int> library-mode: 0;
    callback library-mode-changed(int);
    in property <[GridLine]> library-grid-lines;
    in property <bool> library-grid;
    in property <string> library-crumb;
    callback library-grid-tapped(string);
    callback library-back();
    /// Tres tarjetas de ancho en vertical, ocho en apaisado. Rust reparte las
    /// celdas en líneas, así que tiene que enterarse cuando el número cambia.
    in-out property <int> library-columns: 3;
    callback library-columns-changed(int);
    in property <[PlaylistRow]> playlists;
    in property <[PlaylistRow]> all-playlists;
    in property <bool> showing-playlists;
    in property <bool> playlist-open;
    in property <int> playlist-count;
    callback playlist-open-requested(string);
    callback playlist-enqueue-all();
    callback playlist-create(string);
    callback add-path-to-playlist(string, bool, string);
    callback add-path-to-new-playlist(string, bool, string);
    callback playlist-track-removed(string);
    callback playlist-reordered(int, int);
    callback playlist-rename(string, string);
    callback playlist-delete(string);
    callback playlist-enqueue-id(string);
    callback queue-activated(int);
    callback queue-removed(int);
    callback queue-reordered(int, int);
    callback queue-cleared();
    callback search-changed(string);
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback seek-to(int);
    callback set-volume(float);
    callback cycle-sleep();
    callback rescan();
    callback descargar-caratulas();
    callback add-folder();
    callback cycle-loops();
    callback cycle-fade();
    in property <int> short-filter-secs;
    callback cycle-short-filter();
    in property <string> output-label: "sistema";
    in property <string> ui-mode-label: "auto";
    in property <string> update-status;
    callback check-update();
    callback cycle-output();
    callback cycle-ui-mode();
    in property <bool> eq-enabled;
    in property <float> eq-low;
    in property <float> eq-mid;
    in property <float> eq-high;
    in property <float> preamp-db;
    in property <bool> dsp-mono;
    in property <bool> dsp-limiter;
    callback toggle-eq();
    callback set-eq-band(int, float);
    callback set-preamp(float);
    callback toggle-mono();
    callback toggle-limiter();

    // The desktop shell's track table. Sort and filter live in Rust.
    in property <[TableRow]> table-rows;
    in property <int> table-sort-col: 1;
    in property <bool> table-sort-asc: true;
    in-out property <string> table-filter;
    callback table-activated(int);
    callback table-sorted(int);
    callback table-filter-changed(string);
    callback table-rated(int, int);
    callback table-enqueued(int);
    callback table-open-folder(int);
    callback table-edit-requested(int);
    in-out property <bool> editing-metadata;
    in property <string> meta-heading;
    in property <string> meta-detail;
    in-out property <string> meta-title;
    in-out property <string> meta-artist;
    in-out property <string> meta-album;
    in-out property <string> meta-track;
    callback metadata-accepted();
    callback metadata-cancelled();
    callback table-reclassify-requested(int);
    in-out property <bool> reclassifying;
    in property <string> reclass-heading;
    in property <[ConsoleOption]> consoles;
    in-out property <string> reclass-console;
    in-out property <string> reclass-game;
    in-out property <bool> reclass-scope-folder;
    in property <[string]> reclass-suggestions;
    callback reclass-game-edited(string);
    callback reclass-accepted();
    callback reclass-cancelled();
    callback table-cover-requested(int);
    in-out property <bool> covering;
    in property <string> cover-heading;
    in property <string> cover-status;
    in-out property <string> cover-query;
    in property <[CoverCandidate]> cover-candidates;
    callback cover-search(string);
    callback cover-chosen(int);
    in property <bool> table-faved;
    callback table-faved-changed(bool);
    callback table-needed();

    // Turning the phone is the only layout breakpoint that matters: portrait puts
    // the switcher along the bottom edge, within reach of a thumb; landscape moves
    // it to a rail so the artwork gets the width it just gained.
    //
    // Snapshotted on resize rather than written as `root.height >= root.width`.
    // As a derived binding it joins the layout's own size calculation — the tab
    // bar exists only in portrait, so the layout's height depends on it, and the
    // window's height depends on the layout — and Slint rejects that cycle as a
    // runtime panic risk. Assigning from a `changed` handler is a side effect,
    // not a binding, so no edge is added to the dependency graph.
    property <bool> portrait: true;

    // The on-screen keyboard does not overlay the window, it shrinks it. In
    // landscape that leaves about 205 logical pixels, and out of those the
    // mini-player was taking 68 — the library showed a single row while
    // searching it, which is the one moment the list matters most.
    //
    // So below a threshold the mini-player goes. Nothing is lost: the Playing
    // tab still has the full transport, and the lock screen has MPRIS.
    //
    // Snapshotted from `changed`, like `portrait` and for the same reason: the
    // mini-player's existence decides the layout's height, so writing this as a
    // binding on root.height would close a cycle Slint rejects outright.
    property <bool> cramped: false;

    // The third presentation: a wide window becomes the desktop shell —
    // sidebar, library, queue, one transport bar. Same anti-cycle rule as
    // `portrait`: snapshotted from `changed`, never derived, because whether
    // the shell exists decides the layout that sizes the window.
    //
    // `ui-mode` is the manual override from settings: 0 auto · 1 mini · 2
    // desktop. Auto draws the line at 900px of width.
    in-out property <int> ui-mode: 0;
    property <bool> desktop: false;

    function reshape() {
        root.portrait = root.height >= root.width;
        root.desktop = root.ui-mode == 2
            || (root.ui-mode == 0 && root.width >= 900px);
    }

    changed width => {
        root.reshape();
        root.retile();
    }

    // Tres de ancho con el móvil de pie, ocho tumbado, cinco en la shell de
    // escritorio (el panel central pierde ~510px entre sidebar y cola). Se
    // avisa a Rust sólo cuando cambia de verdad: cada píxel de redimensionado
    // dispara `changed`.
    function retile() {
        if (root.library-columns != (root.desktop ? 5 : (root.portrait ? 3 : 8))) {
            root.library-columns = root.desktop ? 5 : (root.portrait ? 3 : 8);
            root.library-columns-changed(root.library-columns);
        }
    }
    changed height => {
        root.reshape();
        root.cramped = root.height < 300px;
        root.retile();
    }
    changed ui-mode => {
        root.reshape();
        root.retile();
    }

    // Changing tab slides the new one in from the edge it came from, so the
    // gesture and the tab bar agree about which way the app just moved.
    //
    // Only the incoming tab exists. Laying all four side by side in a strip and
    // translating it would be the obvious way to write this, but it keeps four
    // tabs instantiated forever — including the library's ListView, with its
    // viewport and its visible window of rows — for an effect that lasts 180 ms.
    // That trades permanent memory and per-frame work for an animation.
    //
    // Sliding a tab that has just been created needs the offset to jump to the
    // edge and then travel back, and in Slint any write to an animated property
    // animates. The jump is made instant by driving the duration itself: 0 ms
    // for the jump, then a one-shot timer restores the real duration and asks
    // for 0. `interval: 1ms` is not a delay, it is "next event loop turn".
    property <float> slide: 0;
    property <duration> slide-duration: 0ms;
    property <int> shown-tab: 0;
    animate slide { duration: root.slide-duration; easing: ease-out-quad; }

    changed tab => {
        root.slide-duration = 0ms;
        root.slide = root.tab > root.shown-tab ? 1.0 : -1.0;
        root.shown-tab = root.tab;
        slide-settle.running = true;
    }

    slide-settle := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.slide-duration = 180ms;
            root.slide = 0;
        }
    }

    // First run replaces the shell entirely: there is no library to show tabs
    // for, and offering them would only be three empty screens.
    if root.setup-mode: FolderPicker {
        entries: root.picker-entries;
        current-path: root.picker-path;
        chosen-count: root.picker-chosen;
        enter(i) => { root.picker-enter(i); }
        toggle(i) => { root.picker-toggle(i); }
        go-up => { root.picker-up(); }
        done => { root.picker-done(); }
    }

    if !root.setup-mode && root.scan-status != "": Rectangle {
        background: Theme.bg-primary;
        Text {
            text: root.scan-status;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
    }

    // The desktop shell replaces the whole tabbed layout, not a tab of it: the
    // four screens exist inside it as panes.
    if !root.setup-mode && root.scan-status == "" && root.desktop: DesktopShell {
        library-rows: root.library-rows;
        library-total: root.library-total;
        now-title: root.now-title;
        now-artist: root.now-artist;
        now-album: root.now-album;
        now-path: root.now-path;
        now-art: root.now-art;
        playing: root.playing;
        shuffle: root.shuffle;
        repeat: root.repeat;
        position-ms: root.position-ms;
        duration-ms: root.duration-ms;
        volume: root.volume;
        search <=> root.search;
        autofocus-search: root.autofocus-search;
        library-mode <=> root.library-mode;
        library-grid-lines: root.library-grid-lines;
        library-grid: root.library-grid;
        library-crumb: root.library-crumb;
        library-columns: root.library-columns;
        table-rows: root.table-rows;
        table-sort-col: root.table-sort-col;
        table-sort-asc: root.table-sort-asc;
        table-filter <=> root.table-filter;
        table-activated(i) => { root.table-activated(i); }
        table-sorted(col) => { root.table-sorted(col); }
        table-filter-changed(s) => { root.table-filter-changed(s); }
        table-rated(i, stars) => { root.table-rated(i, stars); }
        table-enqueued(i) => { root.table-enqueued(i); }
        table-open-folder(i) => { root.table-open-folder(i); }
        table-edit-requested(i) => { root.table-edit-requested(i); }
        editing-metadata <=> root.editing-metadata;
        meta-heading: root.meta-heading;
        meta-detail: root.meta-detail;
        meta-title <=> root.meta-title;
        meta-artist <=> root.meta-artist;
        meta-album <=> root.meta-album;
        meta-track <=> root.meta-track;
        metadata-accepted => { root.metadata-accepted(); }
        metadata-cancelled => { root.metadata-cancelled(); }
        table-reclassify-requested(i) => { root.table-reclassify-requested(i); }
        reclassifying <=> root.reclassifying;
        reclass-heading: root.reclass-heading;
        consoles: root.consoles;
        reclass-console <=> root.reclass-console;
        reclass-game <=> root.reclass-game;
        reclass-scope-folder <=> root.reclass-scope-folder;
        reclass-suggestions: root.reclass-suggestions;
        reclass-game-edited(t) => { root.reclass-game-edited(t); }
        reclass-accepted => { root.reclass-accepted(); }
        reclass-cancelled => { root.reclass-cancelled(); }
        table-cover-requested(i) => { root.table-cover-requested(i); }
        covering <=> root.covering;
        cover-heading: root.cover-heading;
        cover-status: root.cover-status;
        cover-query <=> root.cover-query;
        cover-candidates: root.cover-candidates;
        cover-search(q) => { root.cover-search(q); }
        cover-chosen(i) => { root.cover-chosen(i); }
        table-faved: root.table-faved;
        table-faved-changed(f) => { root.table-faved-changed(f); }
        table-needed => { root.table-needed(); }
        queue-rows: root.queue-rows;
        playlists: root.playlists;
        all-playlists: root.all-playlists;
        showing-playlists: root.showing-playlists;
        playlist-open: root.playlist-open;
        playlist-count: root.playlist-count;
        output-warning: root.output-warning;
        sleep-running: root.sleep-running;
        sleep-minutes: root.sleep-minutes;
        library-summary: root.library-summary;
        loop-count: root.loop-count;
        fade-seconds: root.fade-seconds;

        library-activated(i) => { root.library-activated(i); }
        library-enqueued(i) => { root.library-enqueued(i); }
        library-enqueue-path(p, hondo) => { root.library-enqueue-path(p, hondo); }
        library-mode-changed(i) => { root.library-mode-changed(i); }
        library-grid-tapped(p) => { root.library-grid-tapped(p); }
        library-back => { root.library-back(); }
        playlist-open-requested(id) => { root.playlist-open-requested(id); }
        playlist-enqueue-all => { root.playlist-enqueue-all(); }
        playlist-create(nombre) => { root.playlist-create(nombre); }
        add-path-to-playlist(p, hondo, id) => { root.add-path-to-playlist(p, hondo, id); }
        add-path-to-new-playlist(p, hondo, nombre) => {
            root.add-path-to-new-playlist(p, hondo, nombre);
        }
        playlist-track-removed(p) => { root.playlist-track-removed(p); }
        playlist-reordered(de, a) => { root.playlist-reordered(de, a); }
        playlist-rename(id, nombre) => { root.playlist-rename(id, nombre); }
        playlist-delete(id) => { root.playlist-delete(id); }
        playlist-enqueue-id(id) => { root.playlist-enqueue-id(id); }
        queue-activated(i) => { root.queue-activated(i); }
        queue-removed(i) => { root.queue-removed(i); }
        queue-reordered(from, to) => { root.queue-reordered(from, to); }
        queue-cleared => { root.queue-cleared(); }
        search-changed(s) => { root.search-changed(s); }
        toggle-play => { root.toggle-play(); }
        next-track => { root.next-track(); }
        prev-track => { root.prev-track(); }
        cycle-repeat => { root.cycle-repeat(); }
        toggle-shuffle => { root.toggle-shuffle(); }
        seek-to(ms) => { root.seek-to(ms); }
        set-volume(v) => { root.set-volume(v); }
        cycle-sleep => { root.cycle-sleep(); }
        rescan => { root.rescan(); }
        descargar-caratulas => { root.descargar-caratulas(); }
        add-folder => { root.add-folder(); }
        cycle-loops => { root.cycle-loops(); }
        cycle-fade => { root.cycle-fade(); }
        short-filter-secs: root.short-filter-secs;
        cycle-short-filter => { root.cycle-short-filter(); }
        output-label: root.output-label;
        ui-mode-label: root.ui-mode-label;
        cycle-output => { root.cycle-output(); }
        cycle-ui-mode => { root.cycle-ui-mode(); }
                    update-status: root.update-status;
                    check-update => { root.check-update(); }
        eq-enabled: root.eq-enabled;
        eq-low: root.eq-low;
        eq-mid: root.eq-mid;
        eq-high: root.eq-high;
        preamp-db: root.preamp-db;
        dsp-mono: root.dsp-mono;
        dsp-limiter: root.dsp-limiter;
        toggle-eq => { root.toggle-eq(); }
        set-eq-band(b, v) => { root.set-eq-band(b, v); }
        set-preamp(v) => { root.set-preamp(v); }
        toggle-mono => { root.toggle-mono(); }
        toggle-limiter => { root.toggle-limiter(); }
    }

    if !root.setup-mode && root.scan-status == "" && !root.desktop: VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // Sized by the enclosing layout: the HorizontalLayout gives it the
            // full height, we only pick the width.
            if !root.portrait: TabSwitcher {
                width: 76px;
                vertical: true;
                tab <=> root.tab;
            }

            Rectangle {
                horizontal-stretch: 1;
                // Keeps the sliding tab off the side rail in landscape, and off
                // the tab bar's own pixels in portrait. Axis-aligned, so this is
                // a scissor rectangle, not a render layer.
                clip: true;

                // Deslizar de lado cambia de solapa. Sólo horizontal a
                // propósito: si capturase también el vertical se comería el
                // desplazamiento de las listas, que es el gesto más usado.
                SwipeGestureHandler {
                    handle-swipe-left: root.tab < 3;
                    handle-swipe-right: root.tab > 0;
                    swiped => {
                        if (self.current-position.x < self.pressed-position.x - 60px) {
                            root.tab = min(3, root.tab + 1);
                        } else if (self.current-position.x > self.pressed-position.x + 60px) {
                            root.tab = max(0, root.tab - 1);
                        }
                    }
                }

                // Declared after the gesture handler so the tabs keep winning
                // pointer events: in Slint the later sibling is on top.
                Rectangle {
                    x: root.slide * parent.width;
                    width: parent.width;
                    height: parent.height;

                    if root.tab == 0: NowPlayingTab {
                        title: root.now-title;
                        artist: root.now-artist;
                        album: root.now-album;
                        art: root.now-art;
                        playing: root.playing;
                        shuffle: root.shuffle;
                        repeat: root.repeat;
                        position-ms: root.position-ms;
                        duration-ms: root.duration-ms;
                        portrait: root.portrait;
                        toggle-play => { root.toggle-play(); }
                        next-track => { root.next-track(); }
                        prev-track => { root.prev-track(); }
                        cycle-repeat => { root.cycle-repeat(); }
                        toggle-shuffle => { root.toggle-shuffle(); }
                        seek(ms) => { root.seek-to(ms); }
                        // Derived from the window, which the compositor imposes, so
                        // these never feed back into the layout that sizes the tab.
                        // Portrait leaves room under the cover for three lines of
                        // text and the two bars; landscape is simply height-bound.
                        art-portrait: min(root.width - Theme.gap * 4, root.height - 300px);
                        // Everything the window has, minus what sits under it:
                        // the mini-player is 68px and the tab pads by `gap` top
                        // and bottom. The old figure, 190px, left the cover at
                        // little over half the height it could have had.
                        art-landscape: root.height - 68px - Theme.gap * 2;
                    }

                    if root.tab == 1: QueueTab {
                        rows: root.queue-rows;
                        activated(i) => { root.queue-activated(i); }
                        removed(i) => { root.queue-removed(i); }
                        reordered(from, to) => { root.queue-reordered(from, to); }
                        cleared => { root.queue-cleared(); }
                    }

                    if root.tab == 3: SettingsTab {
                        volume: root.volume;
                        sleep-running: root.sleep-running;
                        sleep-minutes: root.sleep-minutes;
                        library-summary: root.library-summary;
                        loop-count: root.loop-count;
                        fade-seconds: root.fade-seconds;
                        set-volume(v) => { root.set-volume(v); }
                        cycle-sleep => { root.cycle-sleep(); }
                        rescan => { root.rescan(); }
                        descargar-caratulas => { root.descargar-caratulas(); }
                        add-folder => { root.add-folder(); }
                        cycle-loops => { root.cycle-loops(); }
                        cycle-fade => { root.cycle-fade(); }
                        short-filter-secs: root.short-filter-secs;
                        cycle-short-filter => { root.cycle-short-filter(); }
                        output-label: root.output-label;
                        ui-mode-label: root.ui-mode-label;
                        cycle-output => { root.cycle-output(); }
                        cycle-ui-mode => { root.cycle-ui-mode(); }
                    update-status: root.update-status;
                    check-update => { root.check-update(); }
                        eq-enabled: root.eq-enabled;
                        eq-low: root.eq-low;
                        eq-mid: root.eq-mid;
                        eq-high: root.eq-high;
                        preamp-db: root.preamp-db;
                        dsp-mono: root.dsp-mono;
                        dsp-limiter: root.dsp-limiter;
                        toggle-eq => { root.toggle-eq(); }
                        set-eq-band(b, v) => { root.set-eq-band(b, v); }
                        set-preamp(v) => { root.set-preamp(v); }
                        toggle-mono => { root.toggle-mono(); }
                        toggle-limiter => { root.toggle-limiter(); }
                    }

                    if root.tab == 2: LibraryTab {
                        rows: root.library-rows;
                        total: root.library-total;
                        cramped: root.cramped;
                        now-path: root.now-path;
                        mode <=> root.library-mode;
                        mode-changed(i) => { root.library-mode-changed(i); }
                        grid-lines: root.library-grid-lines;
                        grid: root.library-grid;
                        columns: root.library-columns;
                        crumb: root.library-crumb;
                        grid-tapped(p) => { root.library-grid-tapped(p); }
                        go-back => { root.library-back(); }
                        autofocus-search: root.autofocus-search;
                        search <=> root.search;
                        activated(i) => { root.library-activated(i); }
                        enqueued(i) => { root.library-enqueued(i); }
                        enqueue-path(p, hondo) => { root.library-enqueue-path(p, hondo); }
                        search-changed(s) => { root.search-changed(s); }
                        playlists: root.playlists;
                        all-playlists: root.all-playlists;
                        showing-playlists: root.showing-playlists;
                        playlist-open: root.playlist-open;
                        playlist-count: root.playlist-count;
                        playlist-open-requested(id) => { root.playlist-open-requested(id); }
                        playlist-enqueue-all => { root.playlist-enqueue-all(); }
                        playlist-create(nombre) => { root.playlist-create(nombre); }
                        add-path-to-playlist(p, hondo, id) => {
                            root.add-path-to-playlist(p, hondo, id);
                        }
                        add-path-to-new-playlist(p, hondo, nombre) => {
                            root.add-path-to-new-playlist(p, hondo, nombre);
                        }
                        playlist-track-removed(p) => { root.playlist-track-removed(p); }
                        playlist-reordered(de, a) => { root.playlist-reordered(de, a); }
                        playlist-rename(id, nombre) => { root.playlist-rename(id, nombre); }
                        playlist-delete(id) => { root.playlist-delete(id); }
                        playlist-enqueue-id(id) => { root.playlist-enqueue-id(id); }
                    }
                }
            }
        }

        // In the mini-player's place, not above it, and that is not a cosmetic
        // choice. Added as a row of its own it took 34px the Playing tab did not
        // have to give: the transport is laid out to the height it gets and the
        // play button was clipped in half. Standing in for the mini-player it
        // costs nothing, and there is nothing lost — the mini-player says what
        // is playing, and at this moment nothing is.
        //
        // Outside a tab because the output can die while you are looking at the
        // library, and this has to reach you wherever you are.
        if root.output-warning != "" && !root.cramped: Rectangle {
            height: 68px;
            background: Theme.warning-bg;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;
                Text {
                    text: "⚠";
                    color: Theme.warning-fg;
                    vertical-alignment: center;
                }
                Text {
                    text: root.output-warning;
                    color: Theme.warning-fg;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        if !root.cramped && root.output-warning == "": MiniPlayer {
            art: root.now-art;
            title: root.now-title;
            artist: root.now-artist;
            playing: root.playing;
            position-ms: root.position-ms;
            duration-ms: root.duration-ms;
            toggle-play => { root.toggle-play(); }
            next-track => { root.next-track(); }
            prev-track => { root.prev-track(); }
        }

        if root.portrait: TabSwitcher {
            height: 64px;
            vertical: false;
            tab <=> root.tab;
        }
    }
}
