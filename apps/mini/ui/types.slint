// The data structs the UI and Rust share. `slint::include_modules!()` turns
// these into Rust types; they are re-exported from app.slint so the names
// the Rust side imports do not move when the UI files do.

/// Una celda de la rejilla de Discos o Consolas.
export struct GridCell {
    title: string,
    subtitle: string,
    art: image,
    /// No vacío cuando la celda es una consola: entonces la tarjeta dibuja el
    /// aparato en vez de una portada.
    console: string,
    /// La ruta real, o una sintética (`consola:NES`). Vacía en las celdas de
    /// relleno de la última línea, que existen sólo para que la fila mida igual
    /// que las demás y el ListView pueda virtualizar.
    path: string,
    playing: bool,
}

/// Una línea de la rejilla.
///
/// Rust reparte las celdas en líneas y el ListView virtualiza sobre líneas, no
/// sobre celdas. Es lo que permite una rejilla sin renunciar a que sólo existan
/// las filas visibles — que es la regla que sostiene toda esta interfaz.
export struct GridLine {
    cells: [GridCell],
}

export struct LibraryRow {
    title: string,
    subtitle: string,
    depth: int,
    is-folder: bool,
    expanded: bool,
    // The file or folder this row stands for, so Rust can act on a tap without
    // the UI having to keep a parallel index.
    path: string,
}

export struct QueueRow {
    title: string,
    subtitle: string,
    playing: bool,
}

export struct PlaylistRow {
    // The id and not the row index, for the same reason the long-press sheet is
    // keyed on a path: the model is rebuilt whenever a playlist is created,
    // renamed or deleted, and an index would go stale under the finger.
    id: string,
    name: string,
    subtitle: string,
}

export struct FolderEntry {
    name: string,
    path: string,
    chosen: bool,
}

/// One row of the desktop shell's track table. Everything is a display string
/// already — Rust owns the sorting and filtering, so the UI never needs the
/// raw values back.
/// One visible column of the track table. Rust owns the catalog and the
/// visible subset; fractions arrive already normalised to sum 1.
// A pinned folder in the desktop sidebar: id from the database, name is the
// last path component — enough to recognise it, short enough to fit.
// A monitored library root in Ajustes: removable, watchable.
export struct FolderRow {
    id: string,
    path: string,
    watching: bool,
}

export struct PinnedRow {
    id: string,
    name: string,
    count: string,
    /// Pinned folders can be unpinned from here; library roots cannot —
    /// they leave through Ajustes, where removal prunes tracks.
    removable: bool,
}

export struct TableColumn {
    key: string,
    label: string,
    fraction: float,
    /// Numbers read right-aligned.
    right: bool,
}

export struct TableRow {
    /// One pre-painted string per visible column, aligned with the columns
    /// model — the GridLine trick again: the UI never computes a cell.
    cells: [string],
    path: string,
    /// Rust owns the selection set; the row only paints it.
    selected: bool,
    // "»N" while the row waits in the user queue; "" otherwise.
    queue-pos: string,
}

/// A row of the column chooser: every column the catalog knows, ticked or not.
export struct ColumnChoice {
    key: string,
    label: string,
    shown: bool,
}

/// One console the reclassify sheet can offer.
export struct ConsoleOption {
    id: string,
    name: string,
}

/// One cover on offer in the picker: the thumbnail already decoded (Slint
/// cannot load a URL), and what the source calls it so a person can tell
/// whether it is the right game before looking at the picture.
export struct CoverCandidate {
    img: image,
    source: string,
    name: string,
    conf: string,
}

/// One line of the bulk cover download's preview.
export struct PlanRow {
    game: string,
    console: string,
    source: string,
    action: string,
}
