<?xml version="1.0" encoding="utf-8"?>
<!--
  The status bar and notification icon: the app's own note, as a silhouette.

  It cannot be the launcher icon. Android takes only the alpha channel of a
  small icon and paints every opaque pixel white, and the launcher mark is a
  white note on a filled blue disc: the disc is opaque, so all of it would come
  out white and the note inside it would vanish. What shipped instead was
  android.R.drawable.ic_media_play, the platform's generic triangle, which is
  the one place the app wore somebody else's face.

  Drawn as a vector rather than exported as a bitmap so it stays sharp at every
  status bar density, and with no colour of its own because the system decides
  that.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The head. Two arcs rather than one: a single elliptical arc of 360°
         has the same start and end point and draws nothing. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.6,16.6 a3.4,2.7 0 1,0 6.8,0 a3.4,2.7 0 1,0 -6.8,0 Z" />

    <!-- The stem. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.4,4 L13,4 L13,16.6 L11.4,16.6 Z" />

    <!-- The flag. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13,4 c2.6,1.3 4.5,2.8 4.5,5.3 c0,1.5 -0.8,2.8 -2.1,3.6 c0.7,-2.1 -0.2,-3.9 -2.4,-5.4 Z" />
</vector>
