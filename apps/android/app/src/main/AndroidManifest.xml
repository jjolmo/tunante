<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      All-files access, and it has to be this one.

      READ_MEDIA_AUDIO is the permission Google Play allows, and under it
      MediaProvider decides file by file: a row must exist in MediaStore and its
      media_type must say audio. media_type is derived from the extension via
      Android's MIME map, and .vgz .psf .nsf .spc .gsf .2sf are not in it. They
      are not indexed, so they cannot be opened — readdir() does not even list
      them. A normal music player never notices; this one does not work at all.

      The failure is quiet too: stat() succeeds, access(F_OK) returns 0, and
      open() gives EACCES.

      Play forbids MANAGE_EXTERNAL_STORAGE for media players, so this build can
      never ship there. That is a decision the plan makes explicitly — see
      docs/plan-android.md. It is a distribution policy, not a platform limit:
      sideload and F-Droid grant it identically.
    -->
    <!-- Downloading cover art. A normal permission: granted at install, no
         runtime prompt, no Play policy implications. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Playing with the screen off. Since Android 17 the foreground service is
         not optional for background audio, and its absence fails silently. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- API 33+: without it the media notification never appears. The service
         still runs, which makes this a confusing one to debug. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Tunante"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.NoActionBar"><!-- extractNativeLibs lives in
        app/build.gradle.kts as packaging.jniLibs.useLegacyPackaging: AGP warns if
        it is set here as well, and the build file is the one that wins. -->

        <!--
          launchMode=singleTop: one instance, reused. A player launched again —
          from the launcher, from a file manager, from the media notification —
          should come back to what is playing rather than stack another copy of
          itself on top. It is also what makes onNewIntent fire at all, and
          without that an intent arriving at a running app does nothing.
        -->
        <!--
          Handle rotation here instead of being recreated for it.

          Every piece of screen state this activity has (which destination,
          which library tab, how far down the tree, what was searched, whether a
          playlist was open) lives in its own fields, and Android throws the
          activity away on a configuration change. Turning the phone put you
          back at the root of the library with the destination reset, which
          reads as the app having crashed and reopened.

          Safe to claim because the UI is Compose, which re-measures itself, and
          because nothing here loads an orientation-specific resource: there is
          no -land layout, no -land drawable, no dimension that changes. The two
          places that care about the shape of the screen ask
          LocalConfiguration for it and recompose.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
