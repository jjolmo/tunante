#!/bin/sh
# Install tunante-mini so the phone's launcher can find it.
#
# Deliberately not an APKBUILD: this is what you run while developing, from the
# machine you built on. Packaging comes later.
#
#   ./instalar                    install to /usr/local  (uses sudo)
#   PREFIX=~/.local ./instalar    install for this user only
#
# Both binaries are installed together on purpose. tunante-mini looks for the
# decoder as a sibling of itself, so splitting them across prefixes breaks
# playback with a message that does not explain why.

set -eu

PREFIX="${PREFIX:-/usr/local}"
HERE=$(cd "$(dirname "$0")" && pwd)

SUDO=""
[ -w "$PREFIX" ] || SUDO="sudo"

find_binary() {
	# Built in a workspace, or in its own crate directory when built alone.
	for candidate in \
		"$HERE/../target/release/$1" \
		"$HERE/../../$1/target/release/$1" \
		"$HERE/../../../target/release/$1"
	do
		if [ -x "$candidate" ]; then
			echo "$candidate"
			return 0
		fi
	done
	return 1
}

for b in tunante-mini tunante-decoder; do
	if ! src=$(find_binary "$b"); then
		echo "falta $b — compílalo con: cargo build --release -p $b" >&2
		exit 1
	fi
	$SUDO install -Dm755 "$src" "$PREFIX/bin/$b"
	echo "  $PREFIX/bin/$b"
done

$SUDO install -Dm644 "$HERE/tunante-mini.desktop" \
	"$PREFIX/share/applications/tunante-mini.desktop"
echo "  $PREFIX/share/applications/tunante-mini.desktop"

if [ -f "$HERE/tunante-mini.svg" ]; then
	$SUDO install -Dm644 "$HERE/tunante-mini.svg" \
		"$PREFIX/share/icons/hicolor/scalable/apps/tunante-mini.svg"
	echo "  $PREFIX/share/icons/hicolor/scalable/apps/tunante-mini.svg"
fi

# Plasma reads the launcher index once, at session start, so a freshly installed
# app shows up with no icon — or not at all — until this is rebuilt. It has to
# run with the session's own LANG and XDG_DATA_DIRS: without them it builds a
# cache for the wrong locale, exits 0, and changes nothing.
if command -v kbuildsycoca6 >/dev/null 2>&1; then
	SESSION_ENV=$(systemctl --user show-environment 2>/dev/null \
		| grep -E '^(LANG|XDG_DATA_DIRS)=' | tr '\n' ' ' || true)
	# shellcheck disable=SC2086
	env $SESSION_ENV kbuildsycoca6 >/dev/null 2>&1 || true
	echo "  índice de aplicaciones de Plasma reconstruido"
fi

echo "instalado en $PREFIX"
