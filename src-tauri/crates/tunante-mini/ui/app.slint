// The tunante-mini shell: three tabs, a mini-player, and a switcher that moves
// to a side rail when the phone is turned.
//
// Deliberately built out of primitives (Rectangle, Text, TextInput, TouchArea)
// rather than std-widgets, so the look is Tunante's own and not whichever style
// Slint picks up from the host. The one exception is ListView, which is imported
// for its virtualization — it only instantiates the rows that are visible, which
// is what lets the library tab hold a hundred thousand entries without the
// memory blowing up.

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Fmt } from "theme.slint";

/// Una celda de la rejilla de Discos o Consolas.
export struct GridCell {
    title: string,
    subtitle: string,
    art: image,
    /// No vacío cuando la celda es una consola: entonces la tarjeta dibuja el
    /// aparato en vez de una portada.
    console: string,
    /// La ruta real, o una sintética (`consola:NES`). Vacía en las celdas de
    /// relleno de la última línea, que existen sólo para que la fila mida igual
    /// que las demás y el ListView pueda virtualizar.
    path: string,
    playing: bool,
}

/// Una línea de la rejilla.
///
/// Rust reparte las celdas en líneas y el ListView virtualiza sobre líneas, no
/// sobre celdas. Es lo que permite una rejilla sin renunciar a que sólo existan
/// las filas visibles — que es la regla que sostiene toda esta interfaz.
export struct GridLine {
    cells: [GridCell],
}

export struct LibraryRow {
    title: string,
    subtitle: string,
    depth: int,
    is-folder: bool,
    expanded: bool,
    // The file or folder this row stands for, so Rust can act on a tap without
    // the UI having to keep a parallel index.
    path: string,
}

export struct QueueRow {
    title: string,
    subtitle: string,
    playing: bool,
}

export struct FolderEntry {
    name: string,
    path: string,
    chosen: bool,
}

// First run: pick the folders the library is built from.
//
// A browser of our own rather than the XDG portal. On a phone the portal chooser
// is a desktop file dialog in a phone-sized hole, and this only ever has to do
// one thing: walk directories and tick some.
component FolderPicker inherits Rectangle {
    in property <[FolderEntry]> entries;
    in property <string> current-path;
    in property <int> chosen-count;
    callback enter(int);
    callback toggle(int);
    callback go-up();
    callback done();

    background: Theme.bg-primary;

    VerticalLayout {
        Rectangle {
            height: 64px;
            background: Theme.bg-secondary;
            VerticalLayout {
                padding-left: Theme.gap;
                padding-right: Theme.gap;
                alignment: center;
                spacing: 2px;
                Text {
                    text: "¿Dónde está tu música?";
                    color: Theme.text-primary;
                    font-size: Theme.font-title;
                }
                Text {
                    text: root.current-path;
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    overflow: elide;
                }
            }
        }

        // Up one level. Always present, so there is never a dead end.
        Rectangle {
            height: Theme.touch-target;
            background: up-touch.has-hover ? Theme.bg-hover : transparent;
            HorizontalLayout {
                padding-left: Theme.gap;
                spacing: 8px;
                Text {
                    text: "▴";
                    color: Theme.text-secondary;
                    width: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Subir un nivel";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
            }
            up-touch := TouchArea { clicked => { root.go-up(); } }
        }

        Rectangle { height: 1px; background: Theme.border; }

        ListView {
            // Slint's default style builds its Flickable with `interactive: false`,
            // so the list only scrolls by its scrollbar and the finger does nothing.
            // Fine for a desktop with a wheel; wrong for anything held in a hand.
            mouse-drag-pan-enabled: true;
            vertical-stretch: 1;
            for e[i] in root.entries: Rectangle {
                height: Theme.touch-target + 4px;
                background: e.chosen ? Theme.bg-selected : (t.has-hover ? Theme.bg-hover : transparent);

                HorizontalLayout {
                    padding-left: Theme.gap;
                    padding-right: Theme.gap;
                    spacing: 10px;

                    // Tick box on the left: tapping it chooses the folder,
                    // tapping the name opens it. Two targets, both finger-sized.
                    Rectangle {
                        width: Theme.touch-target;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: e.chosen ? Theme.accent : Theme.text-muted;
                            background: e.chosen ? Theme.accent : transparent;
                            Text {
                                text: e.chosen ? "✓" : "";
                                color: Theme.bg-primary;
                                font-size: 15px;
                            }
                        }
                        TouchArea { clicked => { root.toggle(i); } }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "🗀";
                                color: Theme.text-muted;
                                width: 18px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: e.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        t := TouchArea { clicked => { root.enter(i); } }
                    }
                }
            }
        }

        Rectangle {
            height: 72px;
            background: Theme.bg-secondary;
            HorizontalLayout {
                padding: Theme.gap;
                spacing: Theme.gap;

                Text {
                    text: root.chosen-count == 0
                        ? "Marca al menos una carpeta"
                        : root.chosen-count + " carpeta(s) elegidas";
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 130px;
                    border-radius: Theme.radius;
                    background: root.chosen-count > 0 ? Theme.accent : Theme.bg-tertiary;
                    Text {
                        text: "Analizar";
                        color: root.chosen-count > 0 ? #ffffff : Theme.text-muted;
                        font-size: Theme.font-body;
                    }
                    TouchArea {
                        enabled: root.chosen-count > 0;
                        clicked => { root.done(); }
                    }
                }
            }
        }
    }
}

// A row you can shove sideways to act on it.
//
// Wraps its content and reports the gesture; the content itself is passed in as
// children, so the same behaviour serves the library and the queue without
// either of them knowing about swiping.
//
// Deliberately built on SwipeGestureHandler rather than a bare TouchArea: the
// handler is what tells a sideways drag apart from the vertical flick that
// scrolls the list, and getting that wrong makes the list impossible to scroll.
component SwipeRow inherits Rectangle {
    in property <string> action-label;
    in property <color> action-color: Theme.accent;
    // The row's own background. Configurable so a list can say "this is the one
    // playing" without reaching inside; the surface has to be opaque either way
    // or the swipe action underneath shows through at rest.
    in property <color> surface-color: Theme.bg-primary;
    in property <bool> enabled: true;
    callback swiped();
    callback tapped();
    callback held();

    // How far it has to travel to count. Short enough to feel light, long
    // enough that brushing the glass while scrolling does not fire it.
    property <length> threshold: 90px;
    property <length> offset: 0px;
    /// Puesto por la pulsación larga y leído al soltar. Sin esto el dedo hace
    /// las dos cosas: sale el menú y, al levantarlo, `clicked` encola la fila
    /// que hay debajo.
    property <bool> already-held: false;

    // Only while the row is actually travelling. At rest nothing overflows, and
    // a clip region costs a scissor change per row — with one SwipeRow per list
    // row, that was eighteen batch breaks per frame to contain nothing.
    clip: root.offset != 0px;

    // What shows through from underneath as the row slides away.
    //
    // Built on demand. As an always-present child it was a rectangle and a
    // string laid out on every frame of every row, entirely hidden behind the
    // surface above it. Hidden is not free: Slint still runs the line breaking,
    // and `parley::BreakLines::break_remaining` was 2.2% of the whole process
    // in a profile taken on the phone.
    if root.offset != 0px: Rectangle {
        background: root.action-color;
        opacity: min(1.0, abs(root.offset) / root.threshold);

        HorizontalLayout {
            padding-left: Theme.gap * 2;
            padding-right: Theme.gap * 2;
            alignment: root.offset > 0px ? start : end;

            Text {
                text: root.action-label;
                color: #ffffff;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }
        }
    }

    swipe := SwipeGestureHandler {
        enabled: root.enabled;
        handle-swipe-left: true;
        handle-swipe-right: true;

        moved => {
            root.offset = self.current-position.x - self.pressed-position.x;
        }
        swiped => {
            if (abs(root.offset) >= root.threshold) {
                root.swiped();
            }
            root.offset = 0px;
        }
        cancelled => {
            root.offset = 0px;
        }

        surface := Rectangle {
            x: root.offset;
            background: root.surface-color;

            // El objetivo del toque va DEBAJO del contenido, no encima.
            //
            // En Slint el hermano declarado después queda encima y se lleva los
            // eventos. Con este TouchArea detrás de @children tapaba por
            // completo cualquier cosa que el contenido pusiera dentro —el asa de
            // reordenar, sin ir más lejos, que no recibía un solo evento y
            // parecía que el gesto lo robaba el Flickable.
            tap := TouchArea {
                clicked => {
                    if (!root.already-held) {
                        root.tapped();
                    }
                }

                // Long press. Slint has no such gesture, so it is a timer armed
                // on the way down and disarmed by anything else: lifting the
                // finger, or the swipe handler above claiming the gesture and
                // moving the row.
                // Only up and cancel disarm it. Not move: a finger resting on
                // glass jitters, and disarming on movement would mean the
                // gesture almost never fires.
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.already-held = false;
                        hold.running = true;
                    } else if (e.kind == PointerEventKind.up
                            || e.kind == PointerEventKind.cancel) {
                        hold.running = false;
                    }
                }
            }

            hold := Timer {
                interval: 500ms;
                running: false;
                triggered => {
                    self.running = false;
                    // Two things have to still be true, and neither is
                    // redundant.
                    //
                    // `pressed` catches the vertical case: when the list's
                    // Flickable decides a drag is a scroll it takes the grab,
                    // and it does not send this TouchArea an up or a cancel —
                    // the Cancel in Slint's TouchArea is only emitted when the
                    // area is disabled while grabbed. Without this guard,
                    // flinging the list would pop a menu half a second later.
                    //
                    // The offset catches the horizontal case: the row is being
                    // swiped, which is a different gesture with its own answer.
                    if (tap.pressed && abs(root.offset) < 8px) {
                        root.already-held = true;
                        root.held();
                    }
                }
            }

            @children
        }
    }

    animate offset { duration: 120ms; easing: ease-out; }
}

// One tab of the bottom bar / side rail.
component TabButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected;
    callback clicked();

    background: root.selected ? Theme.bg-selected : transparent;
    border-radius: Theme.radius;

    VerticalLayout {
        alignment: center;
        spacing: 2px;

        Text {
            text: root.glyph;
            font-size: 18px;
            horizontal-alignment: center;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
        }

        Text {
            text: root.label;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Inherits Rectangle on purpose. A bare `component Foo { }` has no geometry of
// its own in Slint, so it collapses to zero size and every button inside it
// becomes invisible — which is exactly what happened on the phone: the bar was
// there, painted, and empty. Inheriting Rectangle also means the conditional
// layouts below are direct children of a Rectangle, so they fill it.
component TabSwitcher inherits Rectangle {
    in property <bool> vertical;
    in-out property <int> tab;

    background: Theme.bg-secondary;

    if root.vertical: VerticalLayout {
        padding: 6px;
        spacing: 6px;
        alignment: start;

        TabButton {
            height: 60px;
            glyph: "▶";
            label: "Sonando";
            selected: root.tab == 0;
            clicked => { root.tab = 0; }
        }
        TabButton {
            height: 60px;
            glyph: "≡";
            label: "Cola";
            selected: root.tab == 1;
            clicked => { root.tab = 1; }
        }
        TabButton {
            height: 60px;
            glyph: "🗀";
            label: "Biblioteca";
            selected: root.tab == 2;
            clicked => { root.tab = 2; }
        }
        TabButton {
            height: 60px;
            glyph: "⚙";
            label: "Ajustes";
            selected: root.tab == 3;
            clicked => { root.tab = 3; }
        }
    }

    if !root.vertical: HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        TabButton {
            glyph: "▶";
            label: "Sonando";
            selected: root.tab == 0;
            clicked => { root.tab = 0; }
        }
        TabButton {
            glyph: "≡";
            label: "Cola";
            selected: root.tab == 1;
            clicked => { root.tab = 1; }
        }
        TabButton {
            glyph: "🗀";
            label: "Biblioteca";
            selected: root.tab == 2;
            clicked => { root.tab = 2; }
        }
        TabButton {
            glyph: "⚙";
            label: "Ajustes";
            selected: root.tab == 3;
            clicked => { root.tab = 3; }
        }
    }
}

// The cover art. Square, and told how big to be by whoever places it — working
// its own size out from the parent would drag it into the layout's size
// calculation, which is the binding loop this file already had once.
component Artwork inherits Rectangle {
    in property <length> side;
    in property <image> art;

    height: root.side;
    width: root.side;
    background: Theme.bg-tertiary;
    border-radius: Theme.radius;
    clip: true;

    Image {
        source: root.art;
        width: 100%;
        height: 100%;
        // Fill the square and crop, rather than letterboxing a non-square cover
        // into a grey frame.
        image-fit: cover;
        visible: root.art.width > 0;
    }

    Text {
        text: "♪";
        color: Theme.text-muted;
        // Relative, because the same component now serves the full-bleed cover
        // on the Playing tab and a 44px thumbnail in the mini-player. Capped so
        // a very large cover area does not turn the note into wallpaper.
        font-size: min(64px, root.side / 3);
        visible: root.art.width == 0;
    }
}

// The strip above the tab bar: what is playing, and the transport.
component MiniPlayer inherits Rectangle {
    in property <image> art;
    in property <string> title;
    in property <string> artist;
    in property <bool> playing;
    in property <int> position-ms;
    in property <int> duration-ms;
    callback toggle-play();
    callback next-track();
    callback prev-track();

    height: 68px;
    background: Theme.bg-secondary;

    Rectangle {
        height: 1px;
        y: 0;
        background: Theme.border;
    }

    // Progress along the top edge. A hairline rather than a slider: the mini
    // player is a status strip, and seeking belongs on the Playing tab where
    // there is room for a target a finger can hit.
    Rectangle {
        y: 1px;
        x: 0;
        height: 2px;
        width: root.duration-ms > 0
            ? parent.width * min(1.0, root.position-ms / root.duration-ms)
            : 0px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        spacing: Theme.gap;

        // The same Artwork the Playing tab uses, at strip size. It was a
        // hardcoded placeholder here since the first day: the cover loaded and
        // filled the tab above while this went on drawing a grey note.
        Rectangle {
            width: 44px;
            Artwork { side: 44px; art: root.art; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                overflow: elide;
            }

            Text {
                text: root.artist;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }

        Rectangle {
            width: Theme.touch-target;
            Text { text: "◀◀"; color: Theme.text-secondary; font-size: 14px; }
            TouchArea { clicked => { root.prev-track(); } }
        }

        Rectangle {
            width: Theme.touch-target;

            // Play is a glyph the phone's fonts do have; pause (U+23F8) is not,
            // so it is drawn. Two rectangles cannot go missing.
            Text {
                text: "▶";
                color: Theme.text-primary;
                font-size: 22px;
                visible: !root.playing;
            }

            // Centred in both directions. A HorizontalLayout on its own only
            // centres across; the bars would sit at the top of the strip, which
            // is exactly how this looked on the phone the first time.
            VerticalLayout {
                alignment: center;
                visible: root.playing;

                HorizontalLayout {
                    alignment: center;
                    spacing: 5px;

                    Rectangle { width: 5px; height: 20px; background: Theme.text-primary; }
                    Rectangle { width: 5px; height: 20px; background: Theme.text-primary; }
                }
            }

            TouchArea {
                clicked => { root.toggle-play(); }
            }
        }

        Rectangle {
            width: Theme.touch-target;
            Text { text: "▶▶"; color: Theme.text-secondary; font-size: 14px; }
            TouchArea { clicked => { root.next-track(); } }
        }
    }
}

// Draggable position bar.
//
// The whole strip is the target, not the little knob: a 6px handle is a mouse
// affordance, and on glass it is unhittable. Height is a finger's worth even
// though the bar itself is thin.
component SeekBar inherits Rectangle {
    in property <int> position-ms;
    in property <int> duration-ms;
    callback seek(int);

    height: Theme.touch-target;

    property <float> fraction: root.duration-ms > 0
        ? clamp(root.position-ms / root.duration-ms, 0.0, 1.0)
        : 0.0;

    HorizontalLayout {
        padding-left: Theme.gap * 1.5;
        padding-right: Theme.gap * 1.5;

        Rectangle {
            track := Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.bg-tertiary;

                Rectangle {
                    x: 0;
                    width: parent.width * root.fraction;
                    height: parent.height;
                    border-radius: parent.border-radius;
                    background: Theme.accent;
                }
            }

            Rectangle {
                x: track.width * root.fraction - self.width / 2;
                width: touch.pressed ? 18px : 13px;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.accent;
                animate width { duration: 90ms; }
            }

            touch := TouchArea {
                // Both a tap anywhere on the bar and a drag along it land the
                // same way: wherever the finger is.
                moved => {
                    if (root.duration-ms > 0) {
                        root.seek((clamp(self.mouse-x / track.width, 0.0, 1.0)
                            * root.duration-ms));
                    }
                }
                clicked => {
                    if (root.duration-ms > 0) {
                        root.seek((clamp(self.mouse-x / track.width, 0.0, 1.0)
                            * root.duration-ms));
                    }
                }
            }
        }
    }
}

component TimeRow inherits HorizontalLayout {
    in property <int> position-ms;
    in property <int> duration-ms;

    padding-left: Theme.gap * 1.5;
    padding-right: Theme.gap * 1.5;

    Text {
        text: Fmt.mmss(root.position-ms);
        color: Theme.text-muted;
        font-size: Theme.font-small;
    }
    Rectangle { horizontal-stretch: 1; }
    Text {
        text: root.duration-ms > 0 ? Fmt.mmss(root.duration-ms) : "--:--";
        color: Theme.text-muted;
        font-size: Theme.font-small;
    }
}

// One round transport button.
component RoundButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    in property <length> size: 52px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.active ? Theme.bg-selected : (t.has-hover ? Theme.bg-hover : transparent);

    Text {
        text: root.glyph;
        color: root.active ? Theme.accent : Theme.text-primary;
        font-size: root.size * 0.38;
    }

    t := TouchArea { clicked => { root.clicked(); } }
}

component TrackInfo {
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <bool> centered;

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Theme.font-title;
            horizontal-alignment: root.centered ? center : left;
            overflow: elide;
        }
        Text {
            text: root.artist;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            horizontal-alignment: root.centered ? center : left;
            overflow: elide;
        }
        Text {
            text: root.album;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            horizontal-alignment: root.centered ? center : left;
            overflow: elide;
        }
    }
}

component Transport inherits VerticalLayout {
    // Landscape hands this row about 1600 physical pixels. `space-around` over
    // that leaves the five buttons floating a finger's width apart each, which
    // reads as five unrelated controls rather than one transport. Wide mode
    // keeps them together in the middle and lets the seek bar have the width,
    // which is the part that actually benefits from it.
    in property <bool> wide;
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;          // 0 off · 1 all · 2 one
    in property <int> position-ms;
    in property <int> duration-ms;
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback seek(int);

    spacing: 4px;

    SeekBar {
        position-ms: root.position-ms;
        duration-ms: root.duration-ms;
        seek(ms) => { root.seek(ms); }
    }

    TimeRow {
        position-ms: root.position-ms;
        duration-ms: root.duration-ms;
    }

    HorizontalLayout {
        padding: Theme.gap;
        alignment: root.wide ? center : space-around;
        spacing: root.wide ? Theme.gap * 2 : 0px;

        RoundButton {
            glyph: "⤨";
            active: root.shuffle;
            size: 46px;
            clicked => { root.toggle-shuffle(); }
        }

        RoundButton {
            glyph: "◀◀";
            size: 52px;
            clicked => { root.prev-track(); }
        }

        // The big one, dead centre, where a thumb lands.
        Rectangle {
            width: 68px;
            height: 68px;
            border-radius: 34px;
            background: Theme.accent;

            Text {
                text: "▶";
                color: #ffffff;
                font-size: 26px;
                visible: !root.playing;
            }
            VerticalLayout {
                alignment: center;
                visible: root.playing;
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Rectangle { width: 6px; height: 24px; background: #ffffff; }
                    Rectangle { width: 6px; height: 24px; background: #ffffff; }
                }
            }
            TouchArea { clicked => { root.toggle-play(); } }
        }

        RoundButton {
            glyph: "▶▶";
            size: 52px;
            clicked => { root.next-track(); }
        }

        // One glyph per mode, rather than a badge on a shared icon: at this size
        // a "1" pinned to a corner is unreadable.
        RoundButton {
            glyph: root.repeat == 2 ? "↻¹" : "↻";
            active: root.repeat != 0;
            size: 46px;
            clicked => { root.cycle-repeat(); }
        }
    }
}

// A labelled row that does one thing when tapped.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> highlighted;
    callback clicked();

    height: Theme.touch-target + 12px;
    background: t.has-hover ? Theme.bg-hover : transparent;

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        spacing: Theme.gap;

        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.value;
            color: root.highlighted ? Theme.accent : Theme.text-muted;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }

    t := TouchArea { clicked => { root.clicked(); } }
}

component SettingsTab inherits Rectangle {
    in property <float> volume;
    in property <bool> sleep-running;
    in property <int> sleep-minutes;
    in property <string> library-summary;
    in property <int> loop-count;
    in property <int> fade-seconds;
    callback set-volume(float);
    callback cycle-sleep();
    callback rescan();
    callback add-folder();
    callback cycle-loops();
    callback cycle-fade();

    // Desplazable, y no es un detalle: en apaisado la ventana deja unos 288
    // puntos y estas filas suman bastante más. Sin esto, tumbado el móvil, el
    // temporizador de apagado y "volver a analizar" quedaban fuera de la
    // pantalla sin manera de llegar a ellos.
    ScrollView {
        // El estilo por defecto de Slint construye su Flickable con
        // `interactive: false`, así que sin esto sólo se desplaza por la barra
        // lateral y el dedo no hace nada. Lo mismo que en las listas.
        mouse-drag-pan-enabled: true;

    VerticalLayout {
        padding-top: Theme.gap;

        Text {
            text: "Sonido";
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            horizontal-alignment: left;
            x: Theme.gap;
        }

        // Volume, as a bar you drag. Same reasoning as the seek bar: the whole
        // strip is the target.
        Rectangle {
            height: Theme.touch-target;
            HorizontalLayout {
                padding-left: Theme.gap;
                padding-right: Theme.gap;
                spacing: Theme.gap;

                Text {
                    text: "🕪";
                    color: Theme.text-muted;
                    font-size: 16px;
                    vertical-alignment: center;
                    width: 22px;
                }

                Rectangle {
                    vol := Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.bg-tertiary;
                        Rectangle {
                            x: 0;
                            width: parent.width * root.volume;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.accent;
                        }
                    }
                    Rectangle {
                        x: vol.width * root.volume - self.width / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: Theme.accent;
                    }
                    voltouch := TouchArea {
                        moved => { root.set-volume(clamp(self.mouse-x / vol.width, 0.0, 1.0)); }
                        clicked => { root.set-volume(clamp(self.mouse-x / vol.width, 0.0, 1.0)); }
                    }
                }

                Text {
                    text: round(root.volume * 100) + "%";
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    width: 44px;
                    horizontal-alignment: right;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        Text {
            text: "Música de consola";
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            x: Theme.gap;
        }

        // What decides how long a track that never ends actually lasts.
        SettingRow {
            label: "Repeticiones del bucle";
            value: root.loop-count + "×";
            clicked => { root.cycle-loops(); }
        }
        SettingRow {
            label: "Fundido final";
            value: root.fade-seconds == 0 ? "sin fundido" : root.fade-seconds + " s";
            clicked => { root.cycle-fade(); }
        }

        Rectangle { height: 1px; background: Theme.border; }

        Text {
            text: "Biblioteca";
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            x: Theme.gap;
        }

        SettingRow {
            label: "Carpetas analizadas";
            value: root.library-summary;
        }
        SettingRow {
            label: "Añadir una carpeta";
            value: "＋";
            clicked => { root.add-folder(); }
        }
        SettingRow {
            label: "Volver a analizar";
            value: "↻";
            clicked => { root.rescan(); }
        }

        Rectangle { height: 1px; background: Theme.border; }

        SettingRow {
            label: "Apagar la música en";
            value: root.sleep-running ? root.sleep-minutes + " min" : "desactivado";
            highlighted: root.sleep-running;
            clicked => { root.cycle-sleep(); }
        }

        Rectangle { vertical-stretch: 1; }
    }
    }
}

component NowPlayingTab inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <bool> portrait;
    in property <image> art;
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <int> position-ms;
    in property <int> duration-ms;
    // Both sizes come from the window, not from this component, so nothing here
    // feeds back into the layout that sizes it.
    in property <length> art-portrait;
    in property <length> art-landscape;

    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback seek(int);

    // Portrait: cover on top, text under it, transport at the bottom.
    if root.portrait: VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: center;
            Artwork { side: root.art-portrait; art: root.art; }
        }

        TrackInfo {
            title: root.title;
            artist: root.artist;
            album: root.album;
            centered: true;
        }

        Rectangle { vertical-stretch: 1; }

        Transport {
            playing: root.playing;
            shuffle: root.shuffle;
            repeat: root.repeat;
            position-ms: root.position-ms;
            duration-ms: root.duration-ms;
            toggle-play => { root.toggle-play(); }
            next-track => { root.next-track(); }
            prev-track => { root.prev-track(); }
            cycle-repeat => { root.cycle-repeat(); }
            toggle-shuffle => { root.toggle-shuffle(); }
            seek(ms) => { root.seek(ms); }
        }
    }

    // Landscape: cover on the leading edge, everything else beside it. Turning
    // the phone buys width, not height, so stacking would only shrink the cover.
    if !root.portrait: HorizontalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;
        // No `alignment` on purpose. Setting one — this said `start` — makes
        // Slint give every child its preferred width and pack them, which
        // silently voids the `horizontal-stretch` below: the whole right-hand
        // third of the screen stayed empty while the seek bar sat squeezed in
        // the middle. The default is stretch, and the cover keeps its size
        // regardless because Artwork binds its own width.

        Artwork { side: root.art-landscape; art: root.art; }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.gap;

            Rectangle { vertical-stretch: 1; }

            TrackInfo {
                title: root.title;
                artist: root.artist;
                album: root.album;
                centered: false;
            }

            Rectangle { vertical-stretch: 1; }

            Transport {
                wide: true;
                playing: root.playing;
                shuffle: root.shuffle;
                repeat: root.repeat;
                position-ms: root.position-ms;
                duration-ms: root.duration-ms;
                toggle-play => { root.toggle-play(); }
                next-track => { root.next-track(); }
                prev-track => { root.prev-track(); }
                cycle-repeat => { root.cycle-repeat(); }
                toggle-shuffle => { root.toggle-shuffle(); }
                seek(ms) => { root.seek(ms); }
            }
        }
    }
}

component QueueTab inherits Rectangle {
    in property <[QueueRow]> rows;
    callback activated(int);
    callback removed(int);
    callback reordered(int, int);
    callback cleared();

    property <length> row-height: Theme.touch-target + 8px;
    // Which row is being carried, and how far it has travelled. -1 for none.
    property <int> dragging: -1;
    property <length> drag-offset: 0px;
    // Emptying the queue stops the music, so it asks first. The second tap
    // lands where the first one did, which is why the strip does not move or
    // change height between the two states.
    property <bool> confirming: false;

    VerticalLayout {

    // Above the list rather than the first row in it.
    //
    // As a row it would scroll under the finger, and a destructive control that
    // moves while you fling a list is a control you eventually hit by accident.
    // Fixed, it is also still there when the queue is long.
    if root.rows.length > 0: Rectangle {
        height: Theme.touch-target;
        background: root.confirming ? #a33333 : Theme.bg-secondary;

        HorizontalLayout {
            padding-left: Theme.gap;
            padding-right: Theme.gap;
            spacing: 8px;
            alignment: center;

            Text {
                text: root.confirming ? "✕" : "🗑";
                color: root.confirming ? #ffffff : Theme.text-secondary;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }
            Text {
                text: root.confirming
                    ? "¿Seguro? Toca otra vez"
                    : "Vaciar la cola (" + root.rows.length + ")";
                color: root.confirming ? #ffffff : Theme.text-secondary;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }
        }

        TouchArea {
            clicked => {
                if (root.confirming) {
                    root.confirming = false;
                    root.cleared();
                } else {
                    root.confirming = true;
                    undo.running = true;
                }
            }
        }

        // A confirmation that waits forever is a trap of its own: come back to
        // the tab five minutes later and the next tap empties the queue.
        undo := Timer {
            interval: 4s;
            running: false;
            triggered => {
                self.running = false;
                root.confirming = false;
            }
        }
    }

    ListView {
        vertical-stretch: 1;
        // Slint's default style builds its Flickable with `interactive: false`,
        // so the list only scrolls by its scrollbar and the finger does nothing.
        // Fine for a desktop with a wheel; wrong for anything held in a hand.
        mouse-drag-pan-enabled: true;
        for row[i] in root.rows: Rectangle {
            height: root.row-height;
            // The row being carried rides above the rest and follows the finger.
            y: root.dragging == i ? root.drag-offset : 0px;
            opacity: root.dragging == i ? 0.85 : 1.0;

            SwipeRow {
                surface-color: row.playing ? Theme.bg-selected : Theme.bg-primary;
                // Swiping while carrying a row would be two gestures at once.
                enabled: root.dragging == -1;
                action-label: "Quitar";
                action-color: #a33333;
                swiped => { root.removed(i); }
                tapped => { root.activated(i); }

                HorizontalLayout {
                    padding-left: Theme.gap;
                    padding-right: Theme.gap;
                    spacing: Theme.gap;

                    Text {
                        text: row.playing ? "▶" : "";
                        color: Theme.accent;
                        width: 16px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: row.title;
                            color: row.playing ? Theme.accent : Theme.text-primary;
                            font-size: Theme.font-body;
                            overflow: elide;
                        }
                        Text {
                            text: row.subtitle;
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            overflow: elide;
                        }
                    }

                    // El asa. Reordenar vive en un objetivo propio y no en toda
                    // la fila: una fila que se mueve al arrastrar en cualquier
                    // punto no puede ser además una lista que se desplaza con el
                    // dedo.
                    //
                    // Hay que MANTENER pulsado antes de arrastrar, y no es un
                    // capricho de diseño: el Flickable de la lista se queda
                    // cualquier gesto vertical que empiece dentro de los
                    // primeros 500 ms de la pulsación (DISTANCE_THRESHOLD y
                    // DURATION_THRESHOLD en items/flickable.rs). Pasado ese
                    // umbral, el arrastre llega aquí. Por eso el asa se enciende
                    // al pulsar: es la única pista de que aguantar sirve para
                    // algo.
                    Rectangle {
                        width: Theme.touch-target;
                        border-radius: Theme.radius;
                        background: grip.pressed ? Theme.bg-hover : transparent;

                        Text {
                            text: "≡";
                            color: grip.pressed ? Theme.accent : Theme.text-muted;
                            font-size: 20px;
                        }

                        grip := TouchArea {
                            moved => {
                                root.dragging = i;
                                root.drag-offset = self.mouse-y - self.pressed-y;
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.up && root.dragging == i) {
                                    // Whole rows only: half a row of travel is
                                    // a wobble, not an instruction.
                                    root.reordered(i, i + round(root.drag-offset / root.row-height));
                                    root.dragging = -1;
                                    root.drag-offset = 0px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
}

// Una entrada del menú de pulsación larga.
//
// Alta a propósito: sale bajo un dedo que ya está apoyado en la pantalla, y una
// fila de 48px con el pulgar encima se falla más de lo que parece.
component MenuAction inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    callback clicked();

    height: Theme.touch-target + 8px;
    background: touch.pressed ? Theme.bg-selected : (touch.has-hover ? Theme.bg-hover : transparent);
    border-radius: Theme.radius;

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        spacing: Theme.gap;

        Text {
            text: root.glyph;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            width: 20px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}

// El mando o la consola, dibujados.
//
// Dibujados y no imágenes: no hay que empaquetar ficheros, no se toca ningún
// logo ajeno, escalan igual a tres columnas que a ocho y no cuestan un byte de
// memoria de imagen. Se reconocen por la silueta, que a este tamaño es lo único
// que se llega a ver.
//
// Todo va en proporción al lado de la tarjeta, que es lo que cambia al girar.
component ConsoleArt inherits Rectangle {
    in property <string> console;
    property <length> u: root.width / 100;   // unidad: la centésima del ancho

    // --- Piezas comunes -----------------------------------------------------
    // Una cruceta: dos barras cruzadas.
    // Un botón: un círculo.
    // Se repiten lo justo; hacer componentes de esto costaría más de lo que ahorra.

    // NES: el mando rectangular, cruceta y dos botones rojos.
    if root.console == "NES": Rectangle {
        width: 74 * root.u; height: 34 * root.u;
        background: #3a3a3c; border-radius: 3 * root.u;
        Rectangle { x: 10 * root.u; y: 13 * root.u; width: 20 * root.u; height: 7 * root.u; background: #17171a; }
        Rectangle { x: 16.5 * root.u; y: 6.5 * root.u; width: 7 * root.u; height: 20 * root.u; background: #17171a; }
        Rectangle { x: 44 * root.u; y: 13 * root.u; width: 9 * root.u; height: 9 * root.u; border-radius: 4.5 * root.u; background: #c0392b; }
        Rectangle { x: 57 * root.u; y: 13 * root.u; width: 9 * root.u; height: 9 * root.u; border-radius: 4.5 * root.u; background: #c0392b; }
    }

    // Super Nintendo: mando redondeado y los cuatro botones en rombo.
    if root.console == "Super Nintendo": Rectangle {
        width: 76 * root.u; height: 32 * root.u;
        background: #cfcfd6; border-radius: 16 * root.u;
        Rectangle { x: 9 * root.u; y: 12 * root.u; width: 19 * root.u; height: 7 * root.u; background: #4a4a55; }
        Rectangle { x: 15 * root.u; y: 6 * root.u; width: 7 * root.u; height: 19 * root.u; background: #4a4a55; }
        Rectangle { x: 55 * root.u; y: 5 * root.u; width: 8 * root.u; height: 8 * root.u; border-radius: 4 * root.u; background: #8e79c4; }
        Rectangle { x: 55 * root.u; y: 19 * root.u; width: 8 * root.u; height: 8 * root.u; border-radius: 4 * root.u; background: #6f5aa8; }
        Rectangle { x: 48 * root.u; y: 12 * root.u; width: 8 * root.u; height: 8 * root.u; border-radius: 4 * root.u; background: #6f5aa8; }
        Rectangle { x: 62 * root.u; y: 12 * root.u; width: 8 * root.u; height: 8 * root.u; border-radius: 4 * root.u; background: #8e79c4; }
    }

    // Game Boy: de pie, con su pantalla verde.
    if root.console == "Game Boy": Rectangle {
        width: 42 * root.u; height: 66 * root.u;
        background: #b9b7a6; border-radius: 4 * root.u;
        Rectangle { x: 7 * root.u; y: 6 * root.u; width: 28 * root.u; height: 25 * root.u; background: #6d7b3f; border-radius: 2 * root.u; }
        Rectangle { x: 8 * root.u; y: 40 * root.u; width: 14 * root.u; height: 5 * root.u; background: #3b3b40; }
        Rectangle { x: 12.5 * root.u; y: 35.5 * root.u; width: 5 * root.u; height: 14 * root.u; background: #3b3b40; }
        Rectangle { x: 26 * root.u; y: 42 * root.u; width: 7 * root.u; height: 7 * root.u; border-radius: 3.5 * root.u; background: #93285f; }
    }

    // Game Boy Advance: tumbada, pantalla al centro.
    if root.console == "Game Boy Advance": Rectangle {
        width: 76 * root.u; height: 38 * root.u;
        background: #4b3f9e; border-radius: 12 * root.u;
        Rectangle { x: 24 * root.u; y: 8 * root.u; width: 28 * root.u; height: 22 * root.u; background: #6d7b3f; border-radius: 2 * root.u; }
        Rectangle { x: 6 * root.u; y: 16 * root.u; width: 13 * root.u; height: 5 * root.u; background: #2c245e; }
        Rectangle { x: 10 * root.u; y: 12 * root.u; width: 5 * root.u; height: 13 * root.u; background: #2c245e; }
        Rectangle { x: 58 * root.u; y: 18 * root.u; width: 7 * root.u; height: 7 * root.u; border-radius: 3.5 * root.u; background: #2c245e; }
        Rectangle { x: 66 * root.u; y: 12 * root.u; width: 7 * root.u; height: 7 * root.u; border-radius: 3.5 * root.u; background: #2c245e; }
    }

    // Nintendo DS: las dos pantallas y la bisagra.
    if root.console == "Nintendo DS": Rectangle {
        width: 52 * root.u; height: 64 * root.u;
        Rectangle { y: 0; width: 52 * root.u; height: 29 * root.u; background: #b8bcc4; border-radius: 3 * root.u;
            Rectangle { x: 6 * root.u; y: 4 * root.u; width: 40 * root.u; height: 21 * root.u; background: #23262e; border-radius: 1 * root.u; }
        }
        Rectangle { y: 31 * root.u; width: 52 * root.u; height: 4 * root.u; background: #7f838b; }
        Rectangle { y: 35 * root.u; width: 52 * root.u; height: 29 * root.u; background: #b8bcc4; border-radius: 3 * root.u;
            Rectangle { x: 6 * root.u; y: 4 * root.u; width: 40 * root.u; height: 21 * root.u; background: #23262e; border-radius: 1 * root.u; }
        }
    }

    // Nintendo 64: los tres brazos. Con Path, que es lo único que dibuja ángulos.
    if root.console == "Nintendo 64": Path {
        width: 78 * root.u; height: 56 * root.u;
        viewbox-width: 100; viewbox-height: 72;
        fill: #d8d8de;
        commands: "M 42 0 L 58 0 L 62 26 L 38 26 Z"
                + "M 30 22 L 46 30 L 34 68 L 16 62 Z"
                + "M 70 22 L 84 62 L 66 68 L 54 30 Z";
    }

    // PlayStation: sus cuatro símbolos. Es lo que cualquiera reconoce de lejos.
    if root.console == "PlayStation" || root.console == "PlayStation 2"
        || root.console == "PlayStation (streams)": Rectangle {
        property <color> tinte: root.console == "PlayStation 2" ? #6ea8ff : #d5d5dd;
        width: 60 * root.u; height: 60 * root.u;
        Text { x: 22 * root.u; y: 0; text: "△"; color: tinte; font-size: 20 * root.u; }
        Text { x: 0; y: 20 * root.u; text: "□"; color: tinte; font-size: 20 * root.u; }
        Text { x: 42 * root.u; y: 20 * root.u; text: "○"; color: tinte; font-size: 20 * root.u; }
        Text { x: 22 * root.u; y: 40 * root.u; text: "✕"; color: tinte; font-size: 20 * root.u; }
    }

    // Mega Drive y compañía: el mando negro de tres botones.
    if root.console == "VGM (Mega Drive y compañía)": Rectangle {
        width: 74 * root.u; height: 32 * root.u;
        background: #1f1f22; border-radius: 14 * root.u;
        Rectangle { x: 9 * root.u; y: 12 * root.u; width: 19 * root.u; height: 7 * root.u; background: #4f4f57; }
        Rectangle { x: 15 * root.u; y: 6 * root.u; width: 7 * root.u; height: 19 * root.u; background: #4f4f57; }
        Rectangle { x: 42 * root.u; y: 13 * root.u; width: 8 * root.u; height: 8 * root.u; border-radius: 4 * root.u; background: #4f4f57; }
        Rectangle { x: 52 * root.u; y: 11 * root.u; width: 8 * root.u; height: 8 * root.u; border-radius: 4 * root.u; background: #4f4f57; }
        Rectangle { x: 62 * root.u; y: 9 * root.u; width: 8 * root.u; height: 8 * root.u; border-radius: 4 * root.u; background: #4f4f57; }
    }

    // Rips de disco: un disco.
    if root.console == "Rips de GameCube, Wii y 3DS": Rectangle {
        width: 60 * root.u; height: 60 * root.u;
        border-radius: 30 * root.u; background: #8f9bb3;
        Rectangle { x: 22 * root.u; y: 22 * root.u; width: 16 * root.u; height: 16 * root.u;
                    border-radius: 8 * root.u; background: Theme.bg-tertiary; }
    }

    // Lo que no es de ninguna consola: unas barras de sonido.
    if root.console == "Otros": Rectangle {
        width: 56 * root.u; height: 46 * root.u;
        Rectangle { x: 0;             y: 14 * root.u; width: 8 * root.u; height: 18 * root.u; background: #7f8896; border-radius: 4 * root.u; }
        Rectangle { x: 12 * root.u;   y: 4 * root.u;  width: 8 * root.u; height: 38 * root.u; background: #7f8896; border-radius: 4 * root.u; }
        Rectangle { x: 24 * root.u;   y: 18 * root.u; width: 8 * root.u; height: 10 * root.u; background: #7f8896; border-radius: 4 * root.u; }
        Rectangle { x: 36 * root.u;   y: 9 * root.u;  width: 8 * root.u; height: 28 * root.u; background: #7f8896; border-radius: 4 * root.u; }
        Rectangle { x: 48 * root.u;   y: 16 * root.u; width: 8 * root.u; height: 14 * root.u; background: #7f8896; border-radius: 4 * root.u; }
    }
}

// Una tarjeta de la rejilla: un disco o una consola.
component GridItem inherits Rectangle {
    in property <GridCell> cell;
    in property <bool> current;
    callback tapped();
    callback held();

    property <bool> already-held: false;

    background: root.current
        ? Theme.bg-selected
        : (touch.pressed ? Theme.bg-hover : Theme.bg-tertiary);
    border-radius: Theme.radius;
    // Las celdas de relleno de la última línea no se pintan ni reciben toques.
    visible: root.cell.path != "";

    clip: true;

    // Arte arriba, texto abajo, sin pisarse.
    //
    // Centrar el texto sobre la imagen funciona con una portada —un velo y se
    // lee— pero sobre un dibujo de línea queda "Game Boy" escrito encima de la
    // Game Boy. Separados, cada cosa se ve entera.
    VerticalLayout {
        padding: 5px;
        spacing: 2px;

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            Image {
                source: root.cell.art;
                width: 100%;
                height: 100%;
                image-fit: cover;
                visible: root.cell.art.width > 0;
            }
            if root.cell.console != "": ConsoleArt {
                console: root.cell.console;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            text: root.cell.title;
            color: Theme.text-primary;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            overflow: elide;
            height: 15px;
        }
        Text {
            text: root.cell.subtitle;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            overflow: elide;
            // 16 y no 14: con 14 la caja corta los rasgos que bajan y "36
            // pistas" aparecía descabezado por abajo.
            height: 16px;
        }
    }

    touch := TouchArea {
        enabled: root.cell.path != "";
        clicked => {
            if (!root.already-held) {
                root.tapped();
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.already-held = false;
                hold.running = true;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                hold.running = false;
            }
        }
    }

    // Igual que en las filas: el Flickable se queda los arrastres verticales sin
    // avisar, así que `pressed` es lo que distingue mantener de desplazar.
    hold := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            if (touch.pressed) {
                root.already-held = true;
                root.held();
            }
        }
    }
}

// Una pestaña del conmutador de vistas de la biblioteca.
component ModeTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    background: root.selected ? Theme.bg-selected : Theme.bg-tertiary;
    border-radius: Theme.radius;

    Text {
        text: root.label;
        color: root.selected ? Theme.text-primary : Theme.text-secondary;
        font-size: Theme.font-small;
    }

    TouchArea { clicked => { root.clicked(); } }
}


component LibraryTab inherits Rectangle {
    in property <[LibraryRow]> rows;
    in property <int> total;
    // True when the on-screen keyboard has taken most of the window. The count
    // is the first thing worth dropping: it is a nicety, and searching is the
    // one moment the list needs every row it can get.
    in property <bool> cramped;
    in property <string> now-path;
    in-out property <string> search;
    in-out property <int> mode;
    callback mode-changed(int);
    // Discos y Consolas se dibujan en rejilla; el nivel de pistas, en lista.
    in property <[GridLine]> grid-lines;
    in property <bool> grid;
    in property <int> columns: 3;
    /// Dónde estamos dentro de una vista de rejilla, para poder volver.
    in property <string> crumb;
    callback grid-tapped(string);
    callback go-back();
    callback enqueued(int);
    // Qué tiene el menú abierto, por ruta y no por índice: las filas se
    // reconstruyen al desplegar una carpeta, y una tarjeta de la rejilla no
    // tiene índice de fila siquiera. Vacía = cerrado.
    property <string> menu-path;
    property <string> menu-name;
    property <bool> menu-is-folder;
    callback enqueue-path(string, bool);
    // Focus the search field as soon as this tab is built. Only used by the
    // spike: it makes "does the on-screen keyboard come up?" answerable over
    // ssh, without needing someone to put a finger on the glass.
    in property <bool> autofocus-search;
    callback activated(int);
    callback search-changed(string);

    init => {
        if (root.autofocus-search) {
            input.focus();
        }
    }

    VerticalLayout {

        // Tres maneras de mirar lo mismo. El árbol refleja el disco, que es
        // honesto pero obliga a bajar hasta un juego cuyo nombre ya sabes; las
        // otras dos son índices sobre las mismas filas, y el menú de pulsación
        // larga funciona igual en las tres.
        Rectangle {
            height: Theme.touch-target - 6px;
            background: Theme.bg-primary;

            HorizontalLayout {
                padding-left: Theme.gap;
                padding-right: Theme.gap;
                spacing: 4px;

                ModeTab {
                    label: "Árbol";
                    selected: root.mode == 0;
                    clicked => { root.mode = 0; root.mode-changed(0); }
                }
                ModeTab {
                    label: "Discos";
                    selected: root.mode == 1;
                    clicked => { root.mode = 1; root.mode-changed(1); }
                }
                ModeTab {
                    label: "Consolas";
                    selected: root.mode == 2;
                    clicked => { root.mode = 2; root.mode-changed(2); }
                }
            }
        }

        // The search field, and the reason this tab is the one that decides the
        // toolkit: tapping it has to raise the on-screen keyboard. TextInput is
        // the primitive Slint fires InputMethodRequest::Enable from, so this is
        // the real test and not an approximation of it.
        Rectangle {
            height: Theme.touch-target + Theme.gap;
            background: Theme.bg-primary;

            Rectangle {
                height: Theme.touch-target;
                x: Theme.gap;
                width: parent.width - Theme.gap * 2;
                background: Theme.bg-tertiary;
                border-radius: Theme.radius;
                border-width: input.has-focus ? 1px : 0px;
                border-color: Theme.accent;

                HorizontalLayout {
                    padding-left: Theme.gap;
                    padding-right: Theme.gap;

                    Rectangle {
                        // Placeholder rather than a magnifier glyph: U+2315 is
                        // missing from the phone's fonts and rendered as a
                        // squiggle. Text we control always draws.
                        Text {
                            x: 0;
                            // Dice lo que hace: en el árbol busca en toda la
                            // biblioteca, y en las rejillas filtra lo que hay
                            // delante. Es el mismo campo haciendo dos cosas, y
                            // callárselo sería mentir sobre cuál.
                            text: root.mode == 0 ? "Buscar…" : "Filtrar lo que se ve…";
                            color: Theme.text-muted;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            visible: root.search == "";
                        }

                        input := TextInput {
                            x: 0;
                            width: parent.width;
                            text <=> root.search;
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.search-changed(self.text); }
                        }
                    }
                }
            }
        }

        // The tree, flattened: each row carries its own depth, and children are
        // fetched from SQLite when a folder is opened. Nothing builds the whole
        // structure in memory — that is what caused an OOM at 16k tracks in the
        // desktop app.
        // Migas: sólo aparecen dentro de una consola o de un disco, y son lo que
        // devuelve atrás. En un móvil no hay una tecla de retroceso fiable dentro
        // de la aplicación, así que tiene que estar en la propia pantalla.
        if root.crumb != "": Rectangle {
            height: Theme.touch-target;
            background: Theme.bg-secondary;

            HorizontalLayout {
                padding-left: Theme.gap;
                padding-right: Theme.gap;
                spacing: 8px;

                Text {
                    text: "◂";
                    color: Theme.accent;
                    font-size: Theme.font-body;
                    width: 16px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.crumb;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            TouchArea { clicked => { root.go-back(); } }
        }

        if root.grid: ListView {
            mouse-drag-pan-enabled: true;
            vertical-stretch: 1;

            for line in root.grid-lines: linea := Rectangle {
                // El ancho de una tarjeta, calculado una vez y aplicado a cada
                // una. Fijarlo no es cosmético: el título lleva `wrap` y eso le
                // da al texto un ancho mínimo —su palabra más larga—, que el
                // HorizontalLayout respeta haciendo crecer la celda. Sin esto,
                // "Game Boy Advance" ensancha su columna y la tercera se sale
                // de la pantalla.
                property <length> cell-w:
                    (root.width - Theme.gap * 2 - (root.columns - 1) * 6px) / root.columns;

                // Cuadradas, más un poco para el subtítulo.
                height: linea.cell-w + 12px;

                HorizontalLayout {
                    padding-left: Theme.gap;
                    padding-right: Theme.gap;
                    padding-bottom: 6px;
                    spacing: 6px;

                    for cell in line.cells: GridItem {
                        width: linea.cell-w;
                        cell: cell;
                        current: cell.playing;
                        tapped => { root.grid-tapped(cell.path); }
                        held => {
                            root.menu-path = cell.path;
                            root.menu-name = cell.title;
                            // Una tarjeta siempre es un contenedor: un disco o
                            // una consola. Nunca es una pista suelta.
                            root.menu-is-folder = true;
                        }
                    }
                }
            }
        }

        if !root.grid: ListView {
            // Slint's default style builds its Flickable with `interactive: false`,
            // so the list only scrolls by its scrollbar and the finger does nothing.
            // Fine for a desktop with a wheel; wrong for anything held in a hand.
            mouse-drag-pan-enabled: true;
            vertical-stretch: 1;

            for row[i] in root.rows: SwipeRow {
                height: Theme.touch-target;
                // Where you are in the tree, without having to remember.
                surface-color: !row.is-folder && row.path == root.now-path
                    ? Theme.bg-selected : Theme.bg-primary;
                // Sólo las pistas se encolan; una carpeta se despliega.
                enabled: !row.is-folder;
                action-label: "A la cola";
                swiped => { root.enqueued(i); }
                tapped => { root.activated(i); }
                held => {
                    root.menu-path = row.path;
                    root.menu-name = row.title;
                    root.menu-is-folder = row.is-folder;
                }

                HorizontalLayout {
                    padding-left: Theme.gap + row.depth * 16px;
                    padding-right: Theme.gap;
                    spacing: 8px;

                    Text {
                        text: row.is-folder ? (row.expanded ? "▾" : "▸") : "";
                        color: Theme.text-secondary;
                        width: 14px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.is-folder ? "🗀" : "♪";
                        color: Theme.text-muted;
                        width: 18px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.title;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                        // Se queda todo el hueco sobrante, que es lo que ancla
                        // la cifra de la derecha. Sin esto el layout repartía el
                        // sobrante entre los dos y cada "258 pistas" o cada
                        // "2:44" caía a una altura distinta, en escalera.
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: row.subtitle;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }

            }
        }

        if !root.cramped: Rectangle {
            height: 22px;
            background: Theme.bg-secondary;

            Text {
                text: root.total == 1 ? "1 elemento" : root.total + " elementos";
                color: Theme.text-muted;
                font-size: Theme.font-small;
            }
        }
    }

    // El menú de la pulsación larga.
    //
    // Declarado después del layout, que en Slint es lo que lo pone encima y le
    // da los eventos. Sale desde abajo, al alcance del pulgar: el dedo ya está
    // ahí, que es donde acaba de mantener pulsado.
    if root.menu-path != "": Rectangle {
        background: #000000bb;

        // Tocar fuera cierra. Va antes que la hoja para quedar debajo de ella.
        TouchArea {
            clicked => { root.menu-path = ""; }
        }

        Rectangle {
            y: parent.height - self.height;
            height: sheet.preferred-height;
            background: Theme.bg-secondary;

            // Se come los toques que caen en la hoja, para que no lleguen al
            // fondo y la cierren nada más abrirla.
            TouchArea { }

            sheet := VerticalLayout {
                padding: Theme.gap;
                spacing: 2px;

                Text {
                    text: root.menu-name;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    overflow: elide;
                    height: Theme.touch-target;
                    vertical-alignment: center;
                }
                Rectangle { height: 1px; background: Theme.border; }

                MenuAction {
                    glyph: "≡";
                    label: root.menu-is-folder
                        ? "Añadir todo, con las subcarpetas"
                        : "Añadir a la cola";
                    clicked => {
                        root.enqueue-path(root.menu-path, true);
                        root.menu-path = "";
                    }
                }

                // Sólo tiene sentido en una carpeta: para un fichero suelto las
                // dos entradas harían lo mismo y una de ellas sobraría.
                if root.menu-is-folder: MenuAction {
                    glyph: "🗀";
                    label: "Añadir sólo esta carpeta";
                    clicked => {
                        root.enqueue-path(root.menu-path, false);
                        root.menu-path = "";
                    }
                }

                MenuAction {
                    glyph: "✕";
                    label: "Cancelar";
                    clicked => { root.menu-path = ""; }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Tunante";
    background: Theme.bg-primary;
    // A sensible desktop size for development. On the phone the compositor makes
    // it fullscreen and this is ignored.
    preferred-width: 400px;
    preferred-height: 800px;

    in property <[LibraryRow]> library-rows;
    in property <[QueueRow]> queue-rows;
    in property <string> now-title: "Nothing playing";
    in property <string> now-artist;
    in property <string> now-album;
    in property <int> library-total;
    in-out property <int> tab: 0;
    in-out property <bool> playing: false;
    in-out property <string> search;
    in property <bool> autofocus-search;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <image> now-art;
    // The path of the track playing, so a row can recognise itself. Cheaper and
    // steadier than marking rows in Rust: `to_ui_rows` is called from five
    // places and none of them would know when the track changed underneath.
    in property <string> now-path;
    in-out property <bool> shuffle;
    // 0 off · 1 all · 2 one
    in-out property <int> repeat;

    in-out property <float> volume: 1.0;
    in property <bool> sleep-running;
    in property <int> sleep-minutes;
    in property <string> library-summary;
    // Empty unless the sound has nowhere to go. See output.rs.
    in property <string> output-warning;
    in property <int> loop-count: 2;
    in property <int> fade-seconds: 8;

    // First run: no folders chosen yet, so the picker replaces the whole shell.
    in-out property <bool> setup-mode;
    in property <[FolderEntry]> picker-entries;
    in property <string> picker-path;
    in property <int> picker-chosen;
    in property <string> scan-status;

    callback picker-enter(int);
    callback picker-toggle(int);
    callback picker-up();
    callback picker-done();

    callback library-activated(int);
    callback library-enqueued(int);
    callback library-enqueue-path(string, bool);
    in-out property <int> library-mode: 0;
    callback library-mode-changed(int);
    in property <[GridLine]> library-grid-lines;
    in property <bool> library-grid;
    in property <string> library-crumb;
    callback library-grid-tapped(string);
    callback library-back();
    /// Tres tarjetas de ancho en vertical, ocho en apaisado. Rust reparte las
    /// celdas en líneas, así que tiene que enterarse cuando el número cambia.
    in-out property <int> library-columns: 3;
    callback library-columns-changed(int);
    callback queue-activated(int);
    callback queue-removed(int);
    callback queue-reordered(int, int);
    callback queue-cleared();
    callback search-changed(string);
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback seek-to(int);
    callback set-volume(float);
    callback cycle-sleep();
    callback rescan();
    callback add-folder();
    callback cycle-loops();
    callback cycle-fade();

    // Turning the phone is the only layout breakpoint that matters: portrait puts
    // the switcher along the bottom edge, within reach of a thumb; landscape moves
    // it to a rail so the artwork gets the width it just gained.
    //
    // Snapshotted on resize rather than written as `root.height >= root.width`.
    // As a derived binding it joins the layout's own size calculation — the tab
    // bar exists only in portrait, so the layout's height depends on it, and the
    // window's height depends on the layout — and Slint rejects that cycle as a
    // runtime panic risk. Assigning from a `changed` handler is a side effect,
    // not a binding, so no edge is added to the dependency graph.
    property <bool> portrait: true;

    // The on-screen keyboard does not overlay the window, it shrinks it. In
    // landscape that leaves about 205 logical pixels, and out of those the
    // mini-player was taking 68 — the library showed a single row while
    // searching it, which is the one moment the list matters most.
    //
    // So below a threshold the mini-player goes. Nothing is lost: the Playing
    // tab still has the full transport, and the lock screen has MPRIS.
    //
    // Snapshotted from `changed`, like `portrait` and for the same reason: the
    // mini-player's existence decides the layout's height, so writing this as a
    // binding on root.height would close a cycle Slint rejects outright.
    property <bool> cramped: false;

    changed width => {
        root.portrait = root.height >= root.width;
        root.retile();
    }

    // Tres de ancho con el móvil de pie, ocho tumbado. Se avisa a Rust sólo
    // cuando cambia de verdad: cada píxel de redimensionado dispara `changed`.
    function retile() {
        if (root.library-columns != (root.portrait ? 3 : 8)) {
            root.library-columns = root.portrait ? 3 : 8;
            root.library-columns-changed(root.library-columns);
        }
    }
    changed height => {
        root.portrait = root.height >= root.width;
        root.cramped = root.height < 300px;
        root.retile();
    }

    // Changing tab slides the new one in from the edge it came from, so the
    // gesture and the tab bar agree about which way the app just moved.
    //
    // Only the incoming tab exists. Laying all four side by side in a strip and
    // translating it would be the obvious way to write this, but it keeps four
    // tabs instantiated forever — including the library's ListView, with its
    // viewport and its visible window of rows — for an effect that lasts 180 ms.
    // That trades permanent memory and per-frame work for an animation.
    //
    // Sliding a tab that has just been created needs the offset to jump to the
    // edge and then travel back, and in Slint any write to an animated property
    // animates. The jump is made instant by driving the duration itself: 0 ms
    // for the jump, then a one-shot timer restores the real duration and asks
    // for 0. `interval: 1ms` is not a delay, it is "next event loop turn".
    property <float> slide: 0;
    property <duration> slide-duration: 0ms;
    property <int> shown-tab: 0;
    animate slide { duration: root.slide-duration; easing: ease-out-quad; }

    changed tab => {
        root.slide-duration = 0ms;
        root.slide = root.tab > root.shown-tab ? 1.0 : -1.0;
        root.shown-tab = root.tab;
        slide-settle.running = true;
    }

    slide-settle := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.slide-duration = 180ms;
            root.slide = 0;
        }
    }

    // First run replaces the shell entirely: there is no library to show tabs
    // for, and offering them would only be three empty screens.
    if root.setup-mode: FolderPicker {
        entries: root.picker-entries;
        current-path: root.picker-path;
        chosen-count: root.picker-chosen;
        enter(i) => { root.picker-enter(i); }
        toggle(i) => { root.picker-toggle(i); }
        go-up => { root.picker-up(); }
        done => { root.picker-done(); }
    }

    if !root.setup-mode && root.scan-status != "": Rectangle {
        background: Theme.bg-primary;
        Text {
            text: root.scan-status;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
    }

    if !root.setup-mode && root.scan-status == "": VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // Sized by the enclosing layout: the HorizontalLayout gives it the
            // full height, we only pick the width.
            if !root.portrait: TabSwitcher {
                width: 76px;
                vertical: true;
                tab <=> root.tab;
            }

            Rectangle {
                horizontal-stretch: 1;
                // Keeps the sliding tab off the side rail in landscape, and off
                // the tab bar's own pixels in portrait. Axis-aligned, so this is
                // a scissor rectangle, not a render layer.
                clip: true;

                // Deslizar de lado cambia de solapa. Sólo horizontal a
                // propósito: si capturase también el vertical se comería el
                // desplazamiento de las listas, que es el gesto más usado.
                SwipeGestureHandler {
                    handle-swipe-left: root.tab < 3;
                    handle-swipe-right: root.tab > 0;
                    swiped => {
                        if (self.current-position.x < self.pressed-position.x - 60px) {
                            root.tab = min(3, root.tab + 1);
                        } else if (self.current-position.x > self.pressed-position.x + 60px) {
                            root.tab = max(0, root.tab - 1);
                        }
                    }
                }

                // Declared after the gesture handler so the tabs keep winning
                // pointer events: in Slint the later sibling is on top.
                Rectangle {
                    x: root.slide * parent.width;
                    width: parent.width;
                    height: parent.height;

                    if root.tab == 0: NowPlayingTab {
                        title: root.now-title;
                        artist: root.now-artist;
                        album: root.now-album;
                        art: root.now-art;
                        playing: root.playing;
                        shuffle: root.shuffle;
                        repeat: root.repeat;
                        position-ms: root.position-ms;
                        duration-ms: root.duration-ms;
                        portrait: root.portrait;
                        toggle-play => { root.toggle-play(); }
                        next-track => { root.next-track(); }
                        prev-track => { root.prev-track(); }
                        cycle-repeat => { root.cycle-repeat(); }
                        toggle-shuffle => { root.toggle-shuffle(); }
                        seek(ms) => { root.seek-to(ms); }
                        // Derived from the window, which the compositor imposes, so
                        // these never feed back into the layout that sizes the tab.
                        // Portrait leaves room under the cover for three lines of
                        // text and the two bars; landscape is simply height-bound.
                        art-portrait: min(root.width - Theme.gap * 4, root.height - 300px);
                        // Everything the window has, minus what sits under it:
                        // the mini-player is 68px and the tab pads by `gap` top
                        // and bottom. The old figure, 190px, left the cover at
                        // little over half the height it could have had.
                        art-landscape: root.height - 68px - Theme.gap * 2;
                    }

                    if root.tab == 1: QueueTab {
                        rows: root.queue-rows;
                        activated(i) => { root.queue-activated(i); }
                        removed(i) => { root.queue-removed(i); }
                        reordered(from, to) => { root.queue-reordered(from, to); }
                        cleared => { root.queue-cleared(); }
                    }

                    if root.tab == 3: SettingsTab {
                        volume: root.volume;
                        sleep-running: root.sleep-running;
                        sleep-minutes: root.sleep-minutes;
                        library-summary: root.library-summary;
                        loop-count: root.loop-count;
                        fade-seconds: root.fade-seconds;
                        set-volume(v) => { root.set-volume(v); }
                        cycle-sleep => { root.cycle-sleep(); }
                        rescan => { root.rescan(); }
                        add-folder => { root.add-folder(); }
                        cycle-loops => { root.cycle-loops(); }
                        cycle-fade => { root.cycle-fade(); }
                    }

                    if root.tab == 2: LibraryTab {
                        rows: root.library-rows;
                        total: root.library-total;
                        cramped: root.cramped;
                        now-path: root.now-path;
                        mode <=> root.library-mode;
                        mode-changed(i) => { root.library-mode-changed(i); }
                        grid-lines: root.library-grid-lines;
                        grid: root.library-grid;
                        columns: root.library-columns;
                        crumb: root.library-crumb;
                        grid-tapped(p) => { root.library-grid-tapped(p); }
                        go-back => { root.library-back(); }
                        autofocus-search: root.autofocus-search;
                        search <=> root.search;
                        activated(i) => { root.library-activated(i); }
                        enqueued(i) => { root.library-enqueued(i); }
                        enqueue-path(p, hondo) => { root.library-enqueue-path(p, hondo); }
                        search-changed(s) => { root.search-changed(s); }
                    }
                }
            }
        }

        // In the mini-player's place, not above it, and that is not a cosmetic
        // choice. Added as a row of its own it took 34px the Playing tab did not
        // have to give: the transport is laid out to the height it gets and the
        // play button was clipped in half. Standing in for the mini-player it
        // costs nothing, and there is nothing lost — the mini-player says what
        // is playing, and at this moment nothing is.
        //
        // Outside a tab because the output can die while you are looking at the
        // library, and this has to reach you wherever you are.
        if root.output-warning != "" && !root.cramped: Rectangle {
            height: 68px;
            background: Theme.warning-bg;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;
                Text {
                    text: "⚠";
                    color: Theme.warning-fg;
                    vertical-alignment: center;
                }
                Text {
                    text: root.output-warning;
                    color: Theme.warning-fg;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        if !root.cramped && root.output-warning == "": MiniPlayer {
            art: root.now-art;
            title: root.now-title;
            artist: root.now-artist;
            playing: root.playing;
            position-ms: root.position-ms;
            duration-ms: root.duration-ms;
            toggle-play => { root.toggle-play(); }
            next-track => { root.next-track(); }
            prev-track => { root.prev-track(); }
        }

        if root.portrait: TabSwitcher {
            height: 64px;
            vertical: false;
            tab <=> root.tab;
        }
    }
}
