// The tunante-mini shell: three tabs, a mini-player, and a switcher that moves
// to a side rail when the phone is turned.
//
// Deliberately built out of primitives (Rectangle, Text, TextInput, TouchArea)
// rather than std-widgets, so the look is Tunante's own and not whichever style
// Slint picks up from the host. The one exception is ListView, which is imported
// for its virtualization — it only instantiates the rows that are visible, which
// is what lets the library tab hold a hundred thousand entries without the
// memory blowing up.

import { ListView } from "std-widgets.slint";
import { Theme, Fmt } from "theme.slint";

export struct LibraryRow {
    title: string,
    subtitle: string,
    depth: int,
    is-folder: bool,
    expanded: bool,
    // The file or folder this row stands for, so Rust can act on a tap without
    // the UI having to keep a parallel index.
    path: string,
}

export struct QueueRow {
    title: string,
    subtitle: string,
    playing: bool,
}

export struct FolderEntry {
    name: string,
    path: string,
    chosen: bool,
}

// First run: pick the folders the library is built from.
//
// A browser of our own rather than the XDG portal. On a phone the portal chooser
// is a desktop file dialog in a phone-sized hole, and this only ever has to do
// one thing: walk directories and tick some.
component FolderPicker inherits Rectangle {
    in property <[FolderEntry]> entries;
    in property <string> current-path;
    in property <int> chosen-count;
    callback enter(int);
    callback toggle(int);
    callback go-up();
    callback done();

    background: Theme.bg-primary;

    VerticalLayout {
        Rectangle {
            height: 64px;
            background: Theme.bg-secondary;
            VerticalLayout {
                padding-left: Theme.gap;
                padding-right: Theme.gap;
                alignment: center;
                spacing: 2px;
                Text {
                    text: "¿Dónde está tu música?";
                    color: Theme.text-primary;
                    font-size: Theme.font-title;
                }
                Text {
                    text: root.current-path;
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    overflow: elide;
                }
            }
        }

        // Up one level. Always present, so there is never a dead end.
        Rectangle {
            height: Theme.touch-target;
            background: up-touch.has-hover ? Theme.bg-hover : transparent;
            HorizontalLayout {
                padding-left: Theme.gap;
                spacing: 8px;
                Text {
                    text: "▴";
                    color: Theme.text-secondary;
                    width: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Subir un nivel";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
            }
            up-touch := TouchArea { clicked => { root.go-up(); } }
        }

        Rectangle { height: 1px; background: Theme.border; }

        ListView {
            // Slint's default style builds its Flickable with `interactive: false`,
            // so the list only scrolls by its scrollbar and the finger does nothing.
            // Fine for a desktop with a wheel; wrong for anything held in a hand.
            mouse-drag-pan-enabled: true;
            vertical-stretch: 1;
            for e[i] in root.entries: Rectangle {
                height: Theme.touch-target + 4px;
                background: e.chosen ? Theme.bg-selected : (t.has-hover ? Theme.bg-hover : transparent);

                HorizontalLayout {
                    padding-left: Theme.gap;
                    padding-right: Theme.gap;
                    spacing: 10px;

                    // Tick box on the left: tapping it chooses the folder,
                    // tapping the name opens it. Two targets, both finger-sized.
                    Rectangle {
                        width: Theme.touch-target;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: e.chosen ? Theme.accent : Theme.text-muted;
                            background: e.chosen ? Theme.accent : transparent;
                            Text {
                                text: e.chosen ? "✓" : "";
                                color: Theme.bg-primary;
                                font-size: 15px;
                            }
                        }
                        TouchArea { clicked => { root.toggle(i); } }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "🗀";
                                color: Theme.text-muted;
                                width: 18px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: e.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        t := TouchArea { clicked => { root.enter(i); } }
                    }
                }
            }
        }

        Rectangle {
            height: 72px;
            background: Theme.bg-secondary;
            HorizontalLayout {
                padding: Theme.gap;
                spacing: Theme.gap;

                Text {
                    text: root.chosen-count == 0
                        ? "Marca al menos una carpeta"
                        : root.chosen-count + " carpeta(s) elegidas";
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 130px;
                    border-radius: Theme.radius;
                    background: root.chosen-count > 0 ? Theme.accent : Theme.bg-tertiary;
                    Text {
                        text: "Analizar";
                        color: root.chosen-count > 0 ? #ffffff : Theme.text-muted;
                        font-size: Theme.font-body;
                    }
                    TouchArea {
                        enabled: root.chosen-count > 0;
                        clicked => { root.done(); }
                    }
                }
            }
        }
    }
}

// A row you can shove sideways to act on it.
//
// Wraps its content and reports the gesture; the content itself is passed in as
// children, so the same behaviour serves the library and the queue without
// either of them knowing about swiping.
//
// Deliberately built on SwipeGestureHandler rather than a bare TouchArea: the
// handler is what tells a sideways drag apart from the vertical flick that
// scrolls the list, and getting that wrong makes the list impossible to scroll.
component SwipeRow inherits Rectangle {
    in property <string> action-label;
    in property <color> action-color: Theme.accent;
    in property <bool> enabled: true;
    callback swiped();
    callback tapped();

    // How far it has to travel to count. Short enough to feel light, long
    // enough that brushing the glass while scrolling does not fire it.
    property <length> threshold: 90px;
    property <length> offset: 0px;

    // Only while the row is actually travelling. At rest nothing overflows, and
    // a clip region costs a scissor change per row — with one SwipeRow per list
    // row, that was eighteen batch breaks per frame to contain nothing.
    clip: root.offset != 0px;

    // What shows through from underneath as the row slides away.
    //
    // Built on demand. As an always-present child it was a rectangle and a
    // string laid out on every frame of every row, entirely hidden behind the
    // surface above it. Hidden is not free: Slint still runs the line breaking,
    // and `parley::BreakLines::break_remaining` was 2.2% of the whole process
    // in a profile taken on the phone.
    if root.offset != 0px: Rectangle {
        background: root.action-color;
        opacity: min(1.0, abs(root.offset) / root.threshold);

        HorizontalLayout {
            padding-left: Theme.gap * 2;
            padding-right: Theme.gap * 2;
            alignment: root.offset > 0px ? start : end;

            Text {
                text: root.action-label;
                color: #ffffff;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }
        }
    }

    swipe := SwipeGestureHandler {
        enabled: root.enabled;
        handle-swipe-left: true;
        handle-swipe-right: true;

        moved => {
            root.offset = self.current-position.x - self.pressed-position.x;
        }
        swiped => {
            if (abs(root.offset) >= root.threshold) {
                root.swiped();
            }
            root.offset = 0px;
        }
        cancelled => {
            root.offset = 0px;
        }

        surface := Rectangle {
            x: root.offset;
            background: Theme.bg-primary;

            // El objetivo del toque va DEBAJO del contenido, no encima.
            //
            // En Slint el hermano declarado después queda encima y se lleva los
            // eventos. Con este TouchArea detrás de @children tapaba por
            // completo cualquier cosa que el contenido pusiera dentro —el asa de
            // reordenar, sin ir más lejos, que no recibía un solo evento y
            // parecía que el gesto lo robaba el Flickable.
            TouchArea {
                clicked => { root.tapped(); }
            }

            @children
        }
    }

    animate offset { duration: 120ms; easing: ease-out; }
}

// One tab of the bottom bar / side rail.
component TabButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected;
    callback clicked();

    background: root.selected ? Theme.bg-selected : transparent;
    border-radius: Theme.radius;

    VerticalLayout {
        alignment: center;
        spacing: 2px;

        Text {
            text: root.glyph;
            font-size: 18px;
            horizontal-alignment: center;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
        }

        Text {
            text: root.label;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Inherits Rectangle on purpose. A bare `component Foo { }` has no geometry of
// its own in Slint, so it collapses to zero size and every button inside it
// becomes invisible — which is exactly what happened on the phone: the bar was
// there, painted, and empty. Inheriting Rectangle also means the conditional
// layouts below are direct children of a Rectangle, so they fill it.
component TabSwitcher inherits Rectangle {
    in property <bool> vertical;
    in-out property <int> tab;

    background: Theme.bg-secondary;

    if root.vertical: VerticalLayout {
        padding: 6px;
        spacing: 6px;
        alignment: start;

        TabButton {
            height: 60px;
            glyph: "▶";
            label: "Sonando";
            selected: root.tab == 0;
            clicked => { root.tab = 0; }
        }
        TabButton {
            height: 60px;
            glyph: "≡";
            label: "Cola";
            selected: root.tab == 1;
            clicked => { root.tab = 1; }
        }
        TabButton {
            height: 60px;
            glyph: "🗀";
            label: "Biblioteca";
            selected: root.tab == 2;
            clicked => { root.tab = 2; }
        }
        TabButton {
            height: 60px;
            glyph: "⚙";
            label: "Ajustes";
            selected: root.tab == 3;
            clicked => { root.tab = 3; }
        }
    }

    if !root.vertical: HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        TabButton {
            glyph: "▶";
            label: "Sonando";
            selected: root.tab == 0;
            clicked => { root.tab = 0; }
        }
        TabButton {
            glyph: "≡";
            label: "Cola";
            selected: root.tab == 1;
            clicked => { root.tab = 1; }
        }
        TabButton {
            glyph: "🗀";
            label: "Biblioteca";
            selected: root.tab == 2;
            clicked => { root.tab = 2; }
        }
        TabButton {
            glyph: "⚙";
            label: "Ajustes";
            selected: root.tab == 3;
            clicked => { root.tab = 3; }
        }
    }
}

// The strip above the tab bar: what is playing, and the transport.
component MiniPlayer inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <bool> playing;
    in property <int> position-ms;
    in property <int> duration-ms;
    callback toggle-play();
    callback next-track();
    callback prev-track();

    height: 68px;
    background: Theme.bg-secondary;

    Rectangle {
        height: 1px;
        y: 0;
        background: Theme.border;
    }

    // Progress along the top edge. A hairline rather than a slider: the mini
    // player is a status strip, and seeking belongs on the Playing tab where
    // there is room for a target a finger can hit.
    Rectangle {
        y: 1px;
        x: 0;
        height: 2px;
        width: root.duration-ms > 0
            ? parent.width * min(1.0, root.position-ms / root.duration-ms)
            : 0px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        spacing: Theme.gap;

        // Artwork placeholder — a real cover goes here, decoded once at display
        // size and held in a small LRU cache.
        Rectangle {
            width: 44px;
            background: Theme.bg-tertiary;
            border-radius: 4px;

            Text {
                text: "♪";
                color: Theme.text-muted;
                font-size: 20px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                overflow: elide;
            }

            Text {
                text: root.artist;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }

        Rectangle {
            width: Theme.touch-target;
            Text { text: "◀◀"; color: Theme.text-secondary; font-size: 14px; }
            TouchArea { clicked => { root.prev-track(); } }
        }

        Rectangle {
            width: Theme.touch-target;

            // Play is a glyph the phone's fonts do have; pause (U+23F8) is not,
            // so it is drawn. Two rectangles cannot go missing.
            Text {
                text: "▶";
                color: Theme.text-primary;
                font-size: 22px;
                visible: !root.playing;
            }

            // Centred in both directions. A HorizontalLayout on its own only
            // centres across; the bars would sit at the top of the strip, which
            // is exactly how this looked on the phone the first time.
            VerticalLayout {
                alignment: center;
                visible: root.playing;

                HorizontalLayout {
                    alignment: center;
                    spacing: 5px;

                    Rectangle { width: 5px; height: 20px; background: Theme.text-primary; }
                    Rectangle { width: 5px; height: 20px; background: Theme.text-primary; }
                }
            }

            TouchArea {
                clicked => { root.toggle-play(); }
            }
        }

        Rectangle {
            width: Theme.touch-target;
            Text { text: "▶▶"; color: Theme.text-secondary; font-size: 14px; }
            TouchArea { clicked => { root.next-track(); } }
        }
    }
}

// The cover art. Square, and told how big to be by whoever places it — working
// its own size out from the parent would drag it into the layout's size
// calculation, which is the binding loop this file already had once.
component Artwork inherits Rectangle {
    in property <length> side;
    in property <image> art;

    height: root.side;
    width: root.side;
    background: Theme.bg-tertiary;
    border-radius: Theme.radius;
    clip: true;

    Image {
        source: root.art;
        width: 100%;
        height: 100%;
        // Fill the square and crop, rather than letterboxing a non-square cover
        // into a grey frame.
        image-fit: cover;
        visible: root.art.width > 0;
    }

    Text {
        text: "♪";
        color: Theme.text-muted;
        font-size: 64px;
        visible: root.art.width == 0;
    }
}

// Draggable position bar.
//
// The whole strip is the target, not the little knob: a 6px handle is a mouse
// affordance, and on glass it is unhittable. Height is a finger's worth even
// though the bar itself is thin.
component SeekBar inherits Rectangle {
    in property <int> position-ms;
    in property <int> duration-ms;
    callback seek(int);

    height: Theme.touch-target;

    property <float> fraction: root.duration-ms > 0
        ? clamp(root.position-ms / root.duration-ms, 0.0, 1.0)
        : 0.0;

    HorizontalLayout {
        padding-left: Theme.gap * 1.5;
        padding-right: Theme.gap * 1.5;

        Rectangle {
            track := Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.bg-tertiary;

                Rectangle {
                    x: 0;
                    width: parent.width * root.fraction;
                    height: parent.height;
                    border-radius: parent.border-radius;
                    background: Theme.accent;
                }
            }

            Rectangle {
                x: track.width * root.fraction - self.width / 2;
                width: touch.pressed ? 18px : 13px;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.accent;
                animate width { duration: 90ms; }
            }

            touch := TouchArea {
                // Both a tap anywhere on the bar and a drag along it land the
                // same way: wherever the finger is.
                moved => {
                    if (root.duration-ms > 0) {
                        root.seek((clamp(self.mouse-x / track.width, 0.0, 1.0)
                            * root.duration-ms));
                    }
                }
                clicked => {
                    if (root.duration-ms > 0) {
                        root.seek((clamp(self.mouse-x / track.width, 0.0, 1.0)
                            * root.duration-ms));
                    }
                }
            }
        }
    }
}

component TimeRow inherits HorizontalLayout {
    in property <int> position-ms;
    in property <int> duration-ms;

    padding-left: Theme.gap * 1.5;
    padding-right: Theme.gap * 1.5;

    Text {
        text: Fmt.mmss(root.position-ms);
        color: Theme.text-muted;
        font-size: Theme.font-small;
    }
    Rectangle { horizontal-stretch: 1; }
    Text {
        text: root.duration-ms > 0 ? Fmt.mmss(root.duration-ms) : "--:--";
        color: Theme.text-muted;
        font-size: Theme.font-small;
    }
}

// One round transport button.
component RoundButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    in property <length> size: 52px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.active ? Theme.bg-selected : (t.has-hover ? Theme.bg-hover : transparent);

    Text {
        text: root.glyph;
        color: root.active ? Theme.accent : Theme.text-primary;
        font-size: root.size * 0.38;
    }

    t := TouchArea { clicked => { root.clicked(); } }
}

component TrackInfo {
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <bool> centered;

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Theme.font-title;
            horizontal-alignment: root.centered ? center : left;
            overflow: elide;
        }
        Text {
            text: root.artist;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            horizontal-alignment: root.centered ? center : left;
            overflow: elide;
        }
        Text {
            text: root.album;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            horizontal-alignment: root.centered ? center : left;
            overflow: elide;
        }
    }
}

component Transport inherits VerticalLayout {
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;          // 0 off · 1 all · 2 one
    in property <int> position-ms;
    in property <int> duration-ms;
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback seek(int);

    spacing: 4px;

    SeekBar {
        position-ms: root.position-ms;
        duration-ms: root.duration-ms;
        seek(ms) => { root.seek(ms); }
    }

    TimeRow {
        position-ms: root.position-ms;
        duration-ms: root.duration-ms;
    }

    HorizontalLayout {
        padding: Theme.gap;
        alignment: space-around;

        RoundButton {
            glyph: "⤨";
            active: root.shuffle;
            size: 46px;
            clicked => { root.toggle-shuffle(); }
        }

        RoundButton {
            glyph: "◀◀";
            size: 52px;
            clicked => { root.prev-track(); }
        }

        // The big one, dead centre, where a thumb lands.
        Rectangle {
            width: 68px;
            height: 68px;
            border-radius: 34px;
            background: Theme.accent;

            Text {
                text: "▶";
                color: #ffffff;
                font-size: 26px;
                visible: !root.playing;
            }
            VerticalLayout {
                alignment: center;
                visible: root.playing;
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Rectangle { width: 6px; height: 24px; background: #ffffff; }
                    Rectangle { width: 6px; height: 24px; background: #ffffff; }
                }
            }
            TouchArea { clicked => { root.toggle-play(); } }
        }

        RoundButton {
            glyph: "▶▶";
            size: 52px;
            clicked => { root.next-track(); }
        }

        // One glyph per mode, rather than a badge on a shared icon: at this size
        // a "1" pinned to a corner is unreadable.
        RoundButton {
            glyph: root.repeat == 2 ? "↻¹" : "↻";
            active: root.repeat != 0;
            size: 46px;
            clicked => { root.cycle-repeat(); }
        }
    }
}

// A labelled row that does one thing when tapped.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> highlighted;
    callback clicked();

    height: Theme.touch-target + 12px;
    background: t.has-hover ? Theme.bg-hover : transparent;

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        spacing: Theme.gap;

        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.value;
            color: root.highlighted ? Theme.accent : Theme.text-muted;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }

    t := TouchArea { clicked => { root.clicked(); } }
}

component SettingsTab inherits Rectangle {
    in property <float> volume;
    in property <bool> sleep-running;
    in property <int> sleep-minutes;
    in property <string> library-summary;
    in property <int> loop-count;
    in property <int> fade-seconds;
    callback set-volume(float);
    callback cycle-sleep();
    callback rescan();
    callback add-folder();
    callback cycle-loops();
    callback cycle-fade();

    VerticalLayout {
        padding-top: Theme.gap;

        Text {
            text: "Sonido";
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            horizontal-alignment: left;
            x: Theme.gap;
        }

        // Volume, as a bar you drag. Same reasoning as the seek bar: the whole
        // strip is the target.
        Rectangle {
            height: Theme.touch-target;
            HorizontalLayout {
                padding-left: Theme.gap;
                padding-right: Theme.gap;
                spacing: Theme.gap;

                Text {
                    text: "🕪";
                    color: Theme.text-muted;
                    font-size: 16px;
                    vertical-alignment: center;
                    width: 22px;
                }

                Rectangle {
                    vol := Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.bg-tertiary;
                        Rectangle {
                            x: 0;
                            width: parent.width * root.volume;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.accent;
                        }
                    }
                    Rectangle {
                        x: vol.width * root.volume - self.width / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: Theme.accent;
                    }
                    voltouch := TouchArea {
                        moved => { root.set-volume(clamp(self.mouse-x / vol.width, 0.0, 1.0)); }
                        clicked => { root.set-volume(clamp(self.mouse-x / vol.width, 0.0, 1.0)); }
                    }
                }

                Text {
                    text: round(root.volume * 100) + "%";
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    width: 44px;
                    horizontal-alignment: right;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        Text {
            text: "Música de consola";
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            x: Theme.gap;
        }

        // What decides how long a track that never ends actually lasts.
        SettingRow {
            label: "Repeticiones del bucle";
            value: root.loop-count + "×";
            clicked => { root.cycle-loops(); }
        }
        SettingRow {
            label: "Fundido final";
            value: root.fade-seconds == 0 ? "sin fundido" : root.fade-seconds + " s";
            clicked => { root.cycle-fade(); }
        }

        Rectangle { height: 1px; background: Theme.border; }

        Text {
            text: "Biblioteca";
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            x: Theme.gap;
        }

        SettingRow {
            label: "Carpetas analizadas";
            value: root.library-summary;
        }
        SettingRow {
            label: "Añadir una carpeta";
            value: "＋";
            clicked => { root.add-folder(); }
        }
        SettingRow {
            label: "Volver a analizar";
            value: "↻";
            clicked => { root.rescan(); }
        }

        Rectangle { height: 1px; background: Theme.border; }

        SettingRow {
            label: "Apagar la música en";
            value: root.sleep-running ? root.sleep-minutes + " min" : "desactivado";
            highlighted: root.sleep-running;
            clicked => { root.cycle-sleep(); }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

component NowPlayingTab inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <bool> portrait;
    in property <image> art;
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <int> position-ms;
    in property <int> duration-ms;
    // Both sizes come from the window, not from this component, so nothing here
    // feeds back into the layout that sizes it.
    in property <length> art-portrait;
    in property <length> art-landscape;

    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback seek(int);

    // Portrait: cover on top, text under it, transport at the bottom.
    if root.portrait: VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: center;
            Artwork { side: root.art-portrait; art: root.art; }
        }

        TrackInfo {
            title: root.title;
            artist: root.artist;
            album: root.album;
            centered: true;
        }

        Rectangle { vertical-stretch: 1; }

        Transport {
            playing: root.playing;
            shuffle: root.shuffle;
            repeat: root.repeat;
            position-ms: root.position-ms;
            duration-ms: root.duration-ms;
            toggle-play => { root.toggle-play(); }
            next-track => { root.next-track(); }
            prev-track => { root.prev-track(); }
            cycle-repeat => { root.cycle-repeat(); }
            toggle-shuffle => { root.toggle-shuffle(); }
            seek(ms) => { root.seek(ms); }
        }
    }

    // Landscape: cover on the leading edge, everything else beside it. Turning
    // the phone buys width, not height, so stacking would only shrink the cover.
    if !root.portrait: HorizontalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;
        alignment: start;

        Artwork { side: root.art-landscape; art: root.art; }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.gap;

            Rectangle { vertical-stretch: 1; }

            TrackInfo {
                title: root.title;
                artist: root.artist;
                album: root.album;
                centered: false;
            }

            Rectangle { vertical-stretch: 1; }

            Transport {
                playing: root.playing;
                shuffle: root.shuffle;
                repeat: root.repeat;
                position-ms: root.position-ms;
                duration-ms: root.duration-ms;
                toggle-play => { root.toggle-play(); }
                next-track => { root.next-track(); }
                prev-track => { root.prev-track(); }
                cycle-repeat => { root.cycle-repeat(); }
                toggle-shuffle => { root.toggle-shuffle(); }
                seek(ms) => { root.seek(ms); }
            }
        }
    }
}

component QueueTab inherits Rectangle {
    in property <[QueueRow]> rows;
    callback activated(int);
    callback removed(int);
    callback reordered(int, int);

    property <length> row-height: Theme.touch-target + 8px;
    // Which row is being carried, and how far it has travelled. -1 for none.
    property <int> dragging: -1;
    property <length> drag-offset: 0px;

    ListView {
        // Slint's default style builds its Flickable with `interactive: false`,
        // so the list only scrolls by its scrollbar and the finger does nothing.
        // Fine for a desktop with a wheel; wrong for anything held in a hand.
        mouse-drag-pan-enabled: true;
        for row[i] in root.rows: Rectangle {
            height: root.row-height;
            // The row being carried rides above the rest and follows the finger.
            y: root.dragging == i ? root.drag-offset : 0px;
            opacity: root.dragging == i ? 0.85 : 1.0;

            SwipeRow {
                // Swiping while carrying a row would be two gestures at once.
                enabled: root.dragging == -1;
                action-label: "Quitar";
                action-color: #a33333;
                swiped => { root.removed(i); }
                tapped => { root.activated(i); }

                HorizontalLayout {
                    padding-left: Theme.gap;
                    padding-right: Theme.gap;
                    spacing: Theme.gap;

                    Text {
                        text: row.playing ? "▶" : "";
                        color: Theme.accent;
                        width: 16px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: row.title;
                            color: row.playing ? Theme.accent : Theme.text-primary;
                            font-size: Theme.font-body;
                            overflow: elide;
                        }
                        Text {
                            text: row.subtitle;
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            overflow: elide;
                        }
                    }

                    // El asa. Reordenar vive en un objetivo propio y no en toda
                    // la fila: una fila que se mueve al arrastrar en cualquier
                    // punto no puede ser además una lista que se desplaza con el
                    // dedo.
                    //
                    // Hay que MANTENER pulsado antes de arrastrar, y no es un
                    // capricho de diseño: el Flickable de la lista se queda
                    // cualquier gesto vertical que empiece dentro de los
                    // primeros 500 ms de la pulsación (DISTANCE_THRESHOLD y
                    // DURATION_THRESHOLD en items/flickable.rs). Pasado ese
                    // umbral, el arrastre llega aquí. Por eso el asa se enciende
                    // al pulsar: es la única pista de que aguantar sirve para
                    // algo.
                    Rectangle {
                        width: Theme.touch-target;
                        border-radius: Theme.radius;
                        background: grip.pressed ? Theme.bg-hover : transparent;

                        Text {
                            text: "≡";
                            color: grip.pressed ? Theme.accent : Theme.text-muted;
                            font-size: 20px;
                        }

                        grip := TouchArea {
                            moved => {
                                root.dragging = i;
                                root.drag-offset = self.mouse-y - self.pressed-y;
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.up && root.dragging == i) {
                                    // Whole rows only: half a row of travel is
                                    // a wobble, not an instruction.
                                    root.reordered(i, i + round(root.drag-offset / root.row-height));
                                    root.dragging = -1;
                                    root.drag-offset = 0px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component LibraryTab inherits Rectangle {
    in property <[LibraryRow]> rows;
    in property <int> total;
    in-out property <string> search;
    callback enqueued(int);
    // Focus the search field as soon as this tab is built. Only used by the
    // spike: it makes "does the on-screen keyboard come up?" answerable over
    // ssh, without needing someone to put a finger on the glass.
    in property <bool> autofocus-search;
    callback activated(int);
    callback search-changed(string);

    init => {
        if (root.autofocus-search) {
            input.focus();
        }
    }

    VerticalLayout {
        // The search field, and the reason this tab is the one that decides the
        // toolkit: tapping it has to raise the on-screen keyboard. TextInput is
        // the primitive Slint fires InputMethodRequest::Enable from, so this is
        // the real test and not an approximation of it.
        Rectangle {
            height: Theme.touch-target + Theme.gap;
            background: Theme.bg-primary;

            Rectangle {
                height: Theme.touch-target;
                x: Theme.gap;
                width: parent.width - Theme.gap * 2;
                background: Theme.bg-tertiary;
                border-radius: Theme.radius;
                border-width: input.has-focus ? 1px : 0px;
                border-color: Theme.accent;

                HorizontalLayout {
                    padding-left: Theme.gap;
                    padding-right: Theme.gap;

                    Rectangle {
                        // Placeholder rather than a magnifier glyph: U+2315 is
                        // missing from the phone's fonts and rendered as a
                        // squiggle. Text we control always draws.
                        Text {
                            x: 0;
                            text: "Buscar…";
                            color: Theme.text-muted;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            visible: root.search == "";
                        }

                        input := TextInput {
                            x: 0;
                            width: parent.width;
                            text <=> root.search;
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.search-changed(self.text); }
                        }
                    }
                }
            }
        }

        // The tree, flattened: each row carries its own depth, and children are
        // fetched from SQLite when a folder is opened. Nothing builds the whole
        // structure in memory — that is what caused an OOM at 16k tracks in the
        // desktop app.
        ListView {
            // Slint's default style builds its Flickable with `interactive: false`,
            // so the list only scrolls by its scrollbar and the finger does nothing.
            // Fine for a desktop with a wheel; wrong for anything held in a hand.
            mouse-drag-pan-enabled: true;
            vertical-stretch: 1;

            for row[i] in root.rows: SwipeRow {
                height: Theme.touch-target;
                // Sólo las pistas se encolan; una carpeta se despliega.
                enabled: !row.is-folder;
                action-label: "A la cola";
                swiped => { root.enqueued(i); }
                tapped => { root.activated(i); }

                HorizontalLayout {
                    padding-left: Theme.gap + row.depth * 16px;
                    padding-right: Theme.gap;
                    spacing: 8px;

                    Text {
                        text: row.is-folder ? (row.expanded ? "▾" : "▸") : "";
                        color: Theme.text-secondary;
                        width: 14px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.is-folder ? "🗀" : "♪";
                        color: Theme.text-muted;
                        width: 18px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.title;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: row.subtitle;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }
                }

            }
        }

        Rectangle {
            height: 22px;
            background: Theme.bg-secondary;

            Text {
                text: root.total == 1 ? "1 elemento" : root.total + " elementos";
                color: Theme.text-muted;
                font-size: Theme.font-small;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Tunante";
    background: Theme.bg-primary;
    // A sensible desktop size for development. On the phone the compositor makes
    // it fullscreen and this is ignored.
    preferred-width: 400px;
    preferred-height: 800px;

    in property <[LibraryRow]> library-rows;
    in property <[QueueRow]> queue-rows;
    in property <string> now-title: "Nothing playing";
    in property <string> now-artist;
    in property <string> now-album;
    in property <int> library-total;
    in-out property <int> tab: 0;
    in-out property <bool> playing: false;
    in-out property <string> search;
    in property <bool> autofocus-search;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <image> now-art;
    in-out property <bool> shuffle;
    // 0 off · 1 all · 2 one
    in-out property <int> repeat;

    in-out property <float> volume: 1.0;
    in property <bool> sleep-running;
    in property <int> sleep-minutes;
    in property <string> library-summary;
    in property <int> loop-count: 2;
    in property <int> fade-seconds: 8;

    // First run: no folders chosen yet, so the picker replaces the whole shell.
    in-out property <bool> setup-mode;
    in property <[FolderEntry]> picker-entries;
    in property <string> picker-path;
    in property <int> picker-chosen;
    in property <string> scan-status;

    callback picker-enter(int);
    callback picker-toggle(int);
    callback picker-up();
    callback picker-done();

    callback library-activated(int);
    callback library-enqueued(int);
    callback queue-activated(int);
    callback queue-removed(int);
    callback queue-reordered(int, int);
    callback search-changed(string);
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback seek-to(int);
    callback set-volume(float);
    callback cycle-sleep();
    callback rescan();
    callback add-folder();
    callback cycle-loops();
    callback cycle-fade();

    // Turning the phone is the only layout breakpoint that matters: portrait puts
    // the switcher along the bottom edge, within reach of a thumb; landscape moves
    // it to a rail so the artwork gets the width it just gained.
    //
    // Snapshotted on resize rather than written as `root.height >= root.width`.
    // As a derived binding it joins the layout's own size calculation — the tab
    // bar exists only in portrait, so the layout's height depends on it, and the
    // window's height depends on the layout — and Slint rejects that cycle as a
    // runtime panic risk. Assigning from a `changed` handler is a side effect,
    // not a binding, so no edge is added to the dependency graph.
    property <bool> portrait: true;

    changed width => { root.portrait = root.height >= root.width; }
    changed height => { root.portrait = root.height >= root.width; }

    // Changing tab slides the new one in from the edge it came from, so the
    // gesture and the tab bar agree about which way the app just moved.
    //
    // Only the incoming tab exists. Laying all four side by side in a strip and
    // translating it would be the obvious way to write this, but it keeps four
    // tabs instantiated forever — including the library's ListView, with its
    // viewport and its visible window of rows — for an effect that lasts 180 ms.
    // That trades permanent memory and per-frame work for an animation.
    //
    // Sliding a tab that has just been created needs the offset to jump to the
    // edge and then travel back, and in Slint any write to an animated property
    // animates. The jump is made instant by driving the duration itself: 0 ms
    // for the jump, then a one-shot timer restores the real duration and asks
    // for 0. `interval: 1ms` is not a delay, it is "next event loop turn".
    property <float> slide: 0;
    property <duration> slide-duration: 0ms;
    property <int> shown-tab: 0;
    animate slide { duration: root.slide-duration; easing: ease-out-quad; }

    changed tab => {
        root.slide-duration = 0ms;
        root.slide = root.tab > root.shown-tab ? 1.0 : -1.0;
        root.shown-tab = root.tab;
        slide-settle.running = true;
    }

    slide-settle := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.slide-duration = 180ms;
            root.slide = 0;
        }
    }

    // First run replaces the shell entirely: there is no library to show tabs
    // for, and offering them would only be three empty screens.
    if root.setup-mode: FolderPicker {
        entries: root.picker-entries;
        current-path: root.picker-path;
        chosen-count: root.picker-chosen;
        enter(i) => { root.picker-enter(i); }
        toggle(i) => { root.picker-toggle(i); }
        go-up => { root.picker-up(); }
        done => { root.picker-done(); }
    }

    if !root.setup-mode && root.scan-status != "": Rectangle {
        background: Theme.bg-primary;
        Text {
            text: root.scan-status;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
    }

    if !root.setup-mode && root.scan-status == "": VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // Sized by the enclosing layout: the HorizontalLayout gives it the
            // full height, we only pick the width.
            if !root.portrait: TabSwitcher {
                width: 76px;
                vertical: true;
                tab <=> root.tab;
            }

            Rectangle {
                horizontal-stretch: 1;
                // Keeps the sliding tab off the side rail in landscape, and off
                // the tab bar's own pixels in portrait. Axis-aligned, so this is
                // a scissor rectangle, not a render layer.
                clip: true;

                // Deslizar de lado cambia de solapa. Sólo horizontal a
                // propósito: si capturase también el vertical se comería el
                // desplazamiento de las listas, que es el gesto más usado.
                SwipeGestureHandler {
                    handle-swipe-left: root.tab < 3;
                    handle-swipe-right: root.tab > 0;
                    swiped => {
                        if (self.current-position.x < self.pressed-position.x - 60px) {
                            root.tab = min(3, root.tab + 1);
                        } else if (self.current-position.x > self.pressed-position.x + 60px) {
                            root.tab = max(0, root.tab - 1);
                        }
                    }
                }

                // Declared after the gesture handler so the tabs keep winning
                // pointer events: in Slint the later sibling is on top.
                Rectangle {
                    x: root.slide * parent.width;
                    width: parent.width;
                    height: parent.height;

                    if root.tab == 0: NowPlayingTab {
                        title: root.now-title;
                        artist: root.now-artist;
                        album: root.now-album;
                        art: root.now-art;
                        playing: root.playing;
                        shuffle: root.shuffle;
                        repeat: root.repeat;
                        position-ms: root.position-ms;
                        duration-ms: root.duration-ms;
                        portrait: root.portrait;
                        toggle-play => { root.toggle-play(); }
                        next-track => { root.next-track(); }
                        prev-track => { root.prev-track(); }
                        cycle-repeat => { root.cycle-repeat(); }
                        toggle-shuffle => { root.toggle-shuffle(); }
                        seek(ms) => { root.seek-to(ms); }
                        // Derived from the window, which the compositor imposes, so
                        // these never feed back into the layout that sizes the tab.
                        // Portrait leaves room under the cover for three lines of
                        // text and the two bars; landscape is simply height-bound.
                        art-portrait: min(root.width - Theme.gap * 4, root.height - 300px);
                        art-landscape: root.height - 190px;
                    }

                    if root.tab == 1: QueueTab {
                        rows: root.queue-rows;
                        activated(i) => { root.queue-activated(i); }
                        removed(i) => { root.queue-removed(i); }
                        reordered(from, to) => { root.queue-reordered(from, to); }
                    }

                    if root.tab == 3: SettingsTab {
                        volume: root.volume;
                        sleep-running: root.sleep-running;
                        sleep-minutes: root.sleep-minutes;
                        library-summary: root.library-summary;
                        loop-count: root.loop-count;
                        fade-seconds: root.fade-seconds;
                        set-volume(v) => { root.set-volume(v); }
                        cycle-sleep => { root.cycle-sleep(); }
                        rescan => { root.rescan(); }
                        add-folder => { root.add-folder(); }
                        cycle-loops => { root.cycle-loops(); }
                        cycle-fade => { root.cycle-fade(); }
                    }

                    if root.tab == 2: LibraryTab {
                        rows: root.library-rows;
                        total: root.library-total;
                        autofocus-search: root.autofocus-search;
                        search <=> root.search;
                        activated(i) => { root.library-activated(i); }
                        enqueued(i) => { root.library-enqueued(i); }
                        search-changed(s) => { root.search-changed(s); }
                    }
                }
            }
        }

        MiniPlayer {
            title: root.now-title;
            artist: root.now-artist;
            playing: root.playing;
            position-ms: root.position-ms;
            duration-ms: root.duration-ms;
            toggle-play => { root.toggle-play(); }
            next-track => { root.next-track(); }
            prev-track => { root.prev-track(); }
        }

        if root.portrait: TabSwitcher {
            height: 64px;
            vertical: false;
            tab <=> root.tab;
        }
    }
}
