// The tunante-mini shell: three tabs, a mini-player, and a switcher that moves
// to a side rail when the phone is turned.
//
// Deliberately built out of primitives (Rectangle, Text, TextInput, TouchArea)
// rather than std-widgets, so the look is Tunante's own and not whichever style
// Slint picks up from the host. The one exception is ListView, which is imported
// for its virtualization — it only instantiates the rows that are visible, which
// is what lets the library tab hold a hundred thousand entries without the
// memory blowing up.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct LibraryRow {
    title: string,
    subtitle: string,
    depth: int,
    is-folder: bool,
    expanded: bool,
    // The file or folder this row stands for, so Rust can act on a tap without
    // the UI having to keep a parallel index.
    path: string,
}

export struct QueueRow {
    title: string,
    subtitle: string,
    playing: bool,
}

export struct FolderEntry {
    name: string,
    path: string,
    chosen: bool,
}

// First run: pick the folders the library is built from.
//
// A browser of our own rather than the XDG portal. On a phone the portal chooser
// is a desktop file dialog in a phone-sized hole, and this only ever has to do
// one thing: walk directories and tick some.
component FolderPicker inherits Rectangle {
    in property <[FolderEntry]> entries;
    in property <string> current-path;
    in property <int> chosen-count;
    callback enter(int);
    callback toggle(int);
    callback go-up();
    callback done();

    background: Theme.bg-primary;

    VerticalLayout {
        Rectangle {
            height: 64px;
            background: Theme.bg-secondary;
            VerticalLayout {
                padding-left: Theme.gap;
                padding-right: Theme.gap;
                alignment: center;
                spacing: 2px;
                Text {
                    text: "¿Dónde está tu música?";
                    color: Theme.text-primary;
                    font-size: Theme.font-title;
                }
                Text {
                    text: root.current-path;
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    overflow: elide;
                }
            }
        }

        // Up one level. Always present, so there is never a dead end.
        Rectangle {
            height: Theme.touch-target;
            background: up-touch.has-hover ? Theme.bg-hover : transparent;
            HorizontalLayout {
                padding-left: Theme.gap;
                spacing: 8px;
                Text {
                    text: "▴";
                    color: Theme.text-secondary;
                    width: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Subir un nivel";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
            }
            up-touch := TouchArea { clicked => { root.go-up(); } }
        }

        Rectangle { height: 1px; background: Theme.border; }

        ListView {
            vertical-stretch: 1;
            for e[i] in root.entries: Rectangle {
                height: Theme.touch-target + 4px;
                background: e.chosen ? Theme.bg-selected : (t.has-hover ? Theme.bg-hover : transparent);

                HorizontalLayout {
                    padding-left: Theme.gap;
                    padding-right: Theme.gap;
                    spacing: 10px;

                    // Tick box on the left: tapping it chooses the folder,
                    // tapping the name opens it. Two targets, both finger-sized.
                    Rectangle {
                        width: Theme.touch-target;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: e.chosen ? Theme.accent : Theme.text-muted;
                            background: e.chosen ? Theme.accent : transparent;
                            Text {
                                text: e.chosen ? "✓" : "";
                                color: Theme.bg-primary;
                                font-size: 15px;
                            }
                        }
                        TouchArea { clicked => { root.toggle(i); } }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "🗀";
                                color: Theme.text-muted;
                                width: 18px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: e.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        t := TouchArea { clicked => { root.enter(i); } }
                    }
                }
            }
        }

        Rectangle {
            height: 72px;
            background: Theme.bg-secondary;
            HorizontalLayout {
                padding: Theme.gap;
                spacing: Theme.gap;

                Text {
                    text: root.chosen-count == 0
                        ? "Marca al menos una carpeta"
                        : root.chosen-count + " carpeta(s) elegidas";
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 130px;
                    border-radius: Theme.radius;
                    background: root.chosen-count > 0 ? Theme.accent : Theme.bg-tertiary;
                    Text {
                        text: "Analizar";
                        color: root.chosen-count > 0 ? #ffffff : Theme.text-muted;
                        font-size: Theme.font-body;
                    }
                    TouchArea {
                        enabled: root.chosen-count > 0;
                        clicked => { root.done(); }
                    }
                }
            }
        }
    }
}

// One tab of the bottom bar / side rail.
component TabButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected;
    callback clicked();

    background: root.selected ? Theme.bg-selected : transparent;
    border-radius: Theme.radius;

    VerticalLayout {
        alignment: center;
        spacing: 2px;

        Text {
            text: root.glyph;
            font-size: 18px;
            horizontal-alignment: center;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
        }

        Text {
            text: root.label;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Inherits Rectangle on purpose. A bare `component Foo { }` has no geometry of
// its own in Slint, so it collapses to zero size and every button inside it
// becomes invisible — which is exactly what happened on the phone: the bar was
// there, painted, and empty. Inheriting Rectangle also means the conditional
// layouts below are direct children of a Rectangle, so they fill it.
component TabSwitcher inherits Rectangle {
    in property <bool> vertical;
    in-out property <int> tab;

    background: Theme.bg-secondary;

    if root.vertical: VerticalLayout {
        padding: 6px;
        spacing: 6px;
        alignment: start;

        TabButton {
            height: 60px;
            glyph: "▶";
            label: "Playing";
            selected: root.tab == 0;
            clicked => { root.tab = 0; }
        }
        TabButton {
            height: 60px;
            glyph: "≡";
            label: "Queue";
            selected: root.tab == 1;
            clicked => { root.tab = 1; }
        }
        TabButton {
            height: 60px;
            glyph: "🗀";
            label: "Library";
            selected: root.tab == 2;
            clicked => { root.tab = 2; }
        }
    }

    if !root.vertical: HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        TabButton {
            glyph: "▶";
            label: "Playing";
            selected: root.tab == 0;
            clicked => { root.tab = 0; }
        }
        TabButton {
            glyph: "≡";
            label: "Queue";
            selected: root.tab == 1;
            clicked => { root.tab = 1; }
        }
        TabButton {
            glyph: "🗀";
            label: "Library";
            selected: root.tab == 2;
            clicked => { root.tab = 2; }
        }
    }
}

// The strip above the tab bar: what is playing, and the transport.
component MiniPlayer inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <bool> playing;
    in property <int> position-ms;
    in property <int> duration-ms;
    callback toggle-play();
    callback next-track();
    callback prev-track();

    height: 68px;
    background: Theme.bg-secondary;

    Rectangle {
        height: 1px;
        y: 0;
        background: Theme.border;
    }

    // Progress along the top edge. A hairline rather than a slider: the mini
    // player is a status strip, and seeking belongs on the Playing tab where
    // there is room for a target a finger can hit.
    Rectangle {
        y: 1px;
        x: 0;
        height: 2px;
        width: root.duration-ms > 0
            ? parent.width * min(1.0, root.position-ms / root.duration-ms)
            : 0px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        spacing: Theme.gap;

        // Artwork placeholder — a real cover goes here, decoded once at display
        // size and held in a small LRU cache.
        Rectangle {
            width: 44px;
            background: Theme.bg-tertiary;
            border-radius: 4px;

            Text {
                text: "♪";
                color: Theme.text-muted;
                font-size: 20px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                overflow: elide;
            }

            Text {
                text: root.artist;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }

        Rectangle {
            width: Theme.touch-target;
            Text { text: "◀◀"; color: Theme.text-secondary; font-size: 14px; }
            TouchArea { clicked => { root.prev-track(); } }
        }

        Rectangle {
            width: Theme.touch-target;

            // Play is a glyph the phone's fonts do have; pause (U+23F8) is not,
            // so it is drawn. Two rectangles cannot go missing.
            Text {
                text: "▶";
                color: Theme.text-primary;
                font-size: 22px;
                visible: !root.playing;
            }

            // Centred in both directions. A HorizontalLayout on its own only
            // centres across; the bars would sit at the top of the strip, which
            // is exactly how this looked on the phone the first time.
            VerticalLayout {
                alignment: center;
                visible: root.playing;

                HorizontalLayout {
                    alignment: center;
                    spacing: 5px;

                    Rectangle { width: 5px; height: 20px; background: Theme.text-primary; }
                    Rectangle { width: 5px; height: 20px; background: Theme.text-primary; }
                }
            }

            TouchArea {
                clicked => { root.toggle-play(); }
            }
        }

        Rectangle {
            width: Theme.touch-target;
            Text { text: "▶▶"; color: Theme.text-secondary; font-size: 14px; }
            TouchArea { clicked => { root.next-track(); } }
        }
    }
}

// The cover art. Square, and told how big to be by whoever places it — working
// its own size out from the parent would drag it into the layout's size
// calculation, which is the binding loop this file already had once.
component Artwork inherits Rectangle {
    in property <length> side;

    height: root.side;
    width: root.side;
    background: Theme.bg-tertiary;
    border-radius: Theme.radius;

    Text {
        text: "♪";
        color: Theme.text-muted;
        font-size: 64px;
    }
}

component TrackInfo {
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <bool> centered;

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Theme.font-title;
            horizontal-alignment: root.centered ? center : left;
            overflow: elide;
        }
        Text {
            text: root.artist;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            horizontal-alignment: root.centered ? center : left;
            overflow: elide;
        }
        Text {
            text: root.album;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            horizontal-alignment: root.centered ? center : left;
            overflow: elide;
        }
    }
}

component NowPlayingTab inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <bool> portrait;
    // Both sizes come from the window, not from this component, so nothing here
    // feeds back into the layout that sizes it.
    in property <length> art-portrait;
    in property <length> art-landscape;

    // Portrait: cover on top, text under it, both centred.
    if root.portrait: VerticalLayout {
        padding: Theme.gap * 2;
        spacing: Theme.gap * 2;
        alignment: center;

        Artwork { side: root.art-portrait; }

        TrackInfo {
            title: root.title;
            artist: root.artist;
            album: root.album;
            centered: true;
        }
    }

    // Landscape: cover on the leading edge, text beside it. Turning the phone
    // buys width, not height, so stacking would only shrink the cover.
    if !root.portrait: HorizontalLayout {
        padding: Theme.gap * 2;
        spacing: Theme.gap * 2;
        alignment: start;

        Artwork { side: root.art-landscape; }

        TrackInfo {
            title: root.title;
            artist: root.artist;
            album: root.album;
            centered: false;
        }
    }
}

component QueueTab inherits Rectangle {
    in property <[QueueRow]> rows;
    callback activated(int);

    ListView {
        for row[i] in root.rows: Rectangle {
            height: Theme.touch-target + 8px;
            background: touch.has-hover ? Theme.bg-hover : transparent;

            HorizontalLayout {
                padding-left: Theme.gap;
                padding-right: Theme.gap;
                spacing: Theme.gap;

                Text {
                    text: row.playing ? "▶" : "";
                    color: Theme.accent;
                    width: 16px;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: row.title;
                        color: row.playing ? Theme.accent : Theme.text-primary;
                        font-size: Theme.font-body;
                        overflow: elide;
                    }
                    Text {
                        text: row.subtitle;
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        overflow: elide;
                    }
                }
            }

            touch := TouchArea {
                clicked => { root.activated(i); }
            }
        }
    }
}

component LibraryTab inherits Rectangle {
    in property <[LibraryRow]> rows;
    in property <int> total;
    in-out property <string> search;
    // Focus the search field as soon as this tab is built. Only used by the
    // spike: it makes "does the on-screen keyboard come up?" answerable over
    // ssh, without needing someone to put a finger on the glass.
    in property <bool> autofocus-search;
    callback activated(int);
    callback search-changed(string);

    init => {
        if (root.autofocus-search) {
            input.focus();
        }
    }

    VerticalLayout {
        // The search field, and the reason this tab is the one that decides the
        // toolkit: tapping it has to raise the on-screen keyboard. TextInput is
        // the primitive Slint fires InputMethodRequest::Enable from, so this is
        // the real test and not an approximation of it.
        Rectangle {
            height: Theme.touch-target + Theme.gap;
            background: Theme.bg-primary;

            Rectangle {
                height: Theme.touch-target;
                x: Theme.gap;
                width: parent.width - Theme.gap * 2;
                background: Theme.bg-tertiary;
                border-radius: Theme.radius;
                border-width: input.has-focus ? 1px : 0px;
                border-color: Theme.accent;

                HorizontalLayout {
                    padding-left: Theme.gap;
                    padding-right: Theme.gap;

                    Rectangle {
                        // Placeholder rather than a magnifier glyph: U+2315 is
                        // missing from the phone's fonts and rendered as a
                        // squiggle. Text we control always draws.
                        Text {
                            x: 0;
                            text: "Buscar…";
                            color: Theme.text-muted;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            visible: root.search == "";
                        }

                        input := TextInput {
                            x: 0;
                            width: parent.width;
                            text <=> root.search;
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.search-changed(self.text); }
                        }
                    }
                }
            }
        }

        // The tree, flattened: each row carries its own depth, and children are
        // fetched from SQLite when a folder is opened. Nothing builds the whole
        // structure in memory — that is what caused an OOM at 16k tracks in the
        // desktop app.
        ListView {
            vertical-stretch: 1;

            for row[i] in root.rows: Rectangle {
                height: Theme.touch-target;
                background: rowtouch.has-hover ? Theme.bg-hover : transparent;

                HorizontalLayout {
                    padding-left: Theme.gap + row.depth * 16px;
                    padding-right: Theme.gap;
                    spacing: 8px;

                    Text {
                        text: row.is-folder ? (row.expanded ? "▾" : "▸") : "";
                        color: Theme.text-secondary;
                        width: 14px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.is-folder ? "🗀" : "♪";
                        color: Theme.text-muted;
                        width: 18px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.title;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: row.subtitle;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }
                }

                rowtouch := TouchArea {
                    clicked => { root.activated(i); }
                }
            }
        }

        Rectangle {
            height: 22px;
            background: Theme.bg-secondary;

            Text {
                text: root.total + " entries";
                color: Theme.text-muted;
                font-size: Theme.font-small;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Tunante";
    background: Theme.bg-primary;
    // A sensible desktop size for development. On the phone the compositor makes
    // it fullscreen and this is ignored.
    preferred-width: 400px;
    preferred-height: 800px;

    in property <[LibraryRow]> library-rows;
    in property <[QueueRow]> queue-rows;
    in property <string> now-title: "Nothing playing";
    in property <string> now-artist;
    in property <string> now-album;
    in property <int> library-total;
    in-out property <int> tab: 0;
    in-out property <bool> playing: false;
    in-out property <string> search;
    in property <bool> autofocus-search;
    in property <int> position-ms;
    in property <int> duration-ms;

    // First run: no folders chosen yet, so the picker replaces the whole shell.
    in-out property <bool> setup-mode;
    in property <[FolderEntry]> picker-entries;
    in property <string> picker-path;
    in property <int> picker-chosen;
    in property <string> scan-status;

    callback picker-enter(int);
    callback picker-toggle(int);
    callback picker-up();
    callback picker-done();

    callback library-activated(int);
    callback queue-activated(int);
    callback search-changed(string);
    callback toggle-play();
    callback next-track();
    callback prev-track();

    // Turning the phone is the only layout breakpoint that matters: portrait puts
    // the switcher along the bottom edge, within reach of a thumb; landscape moves
    // it to a rail so the artwork gets the width it just gained.
    //
    // Snapshotted on resize rather than written as `root.height >= root.width`.
    // As a derived binding it joins the layout's own size calculation — the tab
    // bar exists only in portrait, so the layout's height depends on it, and the
    // window's height depends on the layout — and Slint rejects that cycle as a
    // runtime panic risk. Assigning from a `changed` handler is a side effect,
    // not a binding, so no edge is added to the dependency graph.
    property <bool> portrait: true;

    changed width => { root.portrait = root.height >= root.width; }
    changed height => { root.portrait = root.height >= root.width; }

    // First run replaces the shell entirely: there is no library to show tabs
    // for, and offering them would only be three empty screens.
    if root.setup-mode: FolderPicker {
        entries: root.picker-entries;
        current-path: root.picker-path;
        chosen-count: root.picker-chosen;
        enter(i) => { root.picker-enter(i); }
        toggle(i) => { root.picker-toggle(i); }
        go-up => { root.picker-up(); }
        done => { root.picker-done(); }
    }

    if !root.setup-mode && root.scan-status != "": Rectangle {
        background: Theme.bg-primary;
        Text {
            text: root.scan-status;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
    }

    if !root.setup-mode && root.scan-status == "": VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // Sized by the enclosing layout: the HorizontalLayout gives it the
            // full height, we only pick the width.
            if !root.portrait: TabSwitcher {
                width: 76px;
                vertical: true;
                tab <=> root.tab;
            }

            Rectangle {
                horizontal-stretch: 1;

                if root.tab == 0: NowPlayingTab {
                    title: root.now-title;
                    artist: root.now-artist;
                    album: root.now-album;
                    portrait: root.portrait;
                    // Derived from the window, which the compositor imposes, so
                    // these never feed back into the layout that sizes the tab.
                    // Portrait leaves room under the cover for three lines of
                    // text and the two bars; landscape is simply height-bound.
                    art-portrait: min(root.width - Theme.gap * 4, root.height - 300px);
                    art-landscape: root.height - 190px;
                }

                if root.tab == 1: QueueTab {
                    rows: root.queue-rows;
                    activated(i) => { root.queue-activated(i); }
                }

                if root.tab == 2: LibraryTab {
                    rows: root.library-rows;
                    total: root.library-total;
                    autofocus-search: root.autofocus-search;
                    search <=> root.search;
                    activated(i) => { root.library-activated(i); }
                    search-changed(s) => { root.search-changed(s); }
                }
            }
        }

        MiniPlayer {
            title: root.now-title;
            artist: root.now-artist;
            playing: root.playing;
            position-ms: root.position-ms;
            duration-ms: root.duration-ms;
            toggle-play => { root.toggle-play(); }
            next-track => { root.next-track(); }
            prev-track => { root.prev-track(); }
        }

        if root.portrait: TabSwitcher {
            height: 64px;
            vertical: false;
            tab <=> root.tab;
        }
    }
}
